+    "port_trapped_crystal_display_mutations_clear_and_reload", CrystalChestDisplayGameTests::trapped
+  );
+
+  private CrystalChestDisplayGameTests() {
+  }
+
+  @SubscribeEvent
+  public static void registerFunctions(RegisterEvent event) {
+    event.register(Registries.TEST_FUNCTION, registry ->
+      TESTS.forEach((name, function) -> registry.register(id(name), function)));
+  }
+
+  @SubscribeEvent
+  public static void registerTests(RegisterGameTestsEvent event) {
+    Holder<TestEnvironmentDefinition<?>> environment = event.registerEnvironment(id("crystal_display_tests"));
+    TESTS.forEach((name, function) -> event.registerTest(id(name), new FunctionGameTestInstance(
+      ResourceKey.create(Registries.TEST_FUNCTION, id(name)),
+      new TestData<>(environment, id("port_test_empty_small"), 40, 0, true))));
+  }
+
+  private static Identifier id(String path) {
+    return IronChests.prefix(path);
+  }
+
+  public static void regular(GameTestHelper helper) {
+    displayLifecycle(helper, IronChestsBlocks.CRYSTAL_CHEST.get());
+  }
+
+  public static void trapped(GameTestHelper helper) {
+    displayLifecycle(helper, IronChestsBlocks.TRAPPED_CRYSTAL_CHEST.get());
+  }
+
+  private static void displayLifecycle(GameTestHelper helper, Block block) {
+    BlockPos pos = new BlockPos(2, 1, 2);
+    helper.setBlock(pos, block);
+    AbstractIronChestBlockEntity chest = helper.getBlockEntity(pos, AbstractIronChestBlockEntity.class);
+    ICrystalChest display = (ICrystalChest) chest;
+    chest.setItem(0, new ItemStack(Items.DIAMOND, 32));
+    chest.setItem(1, new ItemStack(Items.DIAMOND, 32));
+    chest.setItem(2, new ItemStack(Items.COAL, 48));
+    Item[] otherTypes = {Items.COBBLESTONE, Items.OAK_PLANKS, Items.IRON_INGOT, Items.GOLD_INGOT,
+      Items.REDSTONE, Items.LAPIS_LAZULI, Items.EMERALD};
+    for (int i = 0; i < otherTypes.length; i++) {
+      chest.setItem(i + 3, new ItemStack(otherTypes[i], 40));
+    }
+
+    // Do not read inventory slots or open a menu: those reads can mask missing mutation notifications.
+    helper.startSequence()
+      .thenExecuteAfter(2, () -> {
+        helper.assertValueEqual(display.getTopItems().size(), 8, "Display has eight positions");
+        helper.assertValueEqual(displayCount(display, Items.DIAMOND), 64, "Equal-count diamond stacks combine and rank among the top eight");
+        helper.assertValueEqual(displayCount(display, Items.COAL), 48, "Coal remains in the display alongside the combined diamonds");
+        helper.assertValueEqual(display.getTopItems().stream().filter(stack -> !stack.isEmpty()).count(), 8L, "The top eight positions are occupied");
+        helper.assertValueEqual(chest.removeItem(0, 32).getCount(), 32, "Remove the first diamond stack through the real container");
+        helper.assertValueEqual(chest.removeItem(1, 32).getCount(), 32, "Remove the second diamond stack through the real container");
+      })
+      .thenExecuteAfter(2, () -> {
+        helper.assertValueEqual(displayCount(display, Items.DIAMOND), 0, "Removal refreshes the display without inventory reads");
+        helper.assertValueEqual(displayCount(display, Items.COAL), 48, "Removal retains unrelated displayed cargo");
+        chest.clearContent();
+      })
+      .thenExecuteAfter(2, () -> {
+        helper.assertTrue(display.getTopItems().stream().allMatch(ItemStack::isEmpty), "Clearing all inventory slots clears every display position");
+        chest.setItem(0, new ItemStack(Items.DIAMOND, 5));
+        chest.setItem(chest.getContainerSize() - 1, new ItemStack(Items.EMERALD, 3));
+      })
+      .thenExecuteAfter(2, () -> {
+        helper.assertValueEqual(displayCount(display, Items.DIAMOND), 5, "Adding new cargo refreshes the display after clearing");
+        helper.assertValueEqual(displayCount(display, Items.EMERALD), 3, "Last-slot cargo participates in the refreshed display");
+        CompoundTag saved = chest.saveWithFullMetadata(helper.getLevel().registryAccess());
+        BlockEntity loaded = BlockEntity.loadStatic(helper.absolutePos(pos), helper.getBlockState(pos), saved, helper.getLevel().registryAccess());
+        helper.assertTrue(loaded instanceof AbstractIronChestBlockEntity && loaded instanceof ICrystalChest && loaded != chest, "Native save/load reconstructs a separate crystal chest");
+        // Register the reloaded entity in the world so its normal block-entity ticker rebuilds the cache.
+        helper.getLevel().setBlockEntity(loaded);
+      })
+      .thenExecuteAfter(2, () -> {
+        AbstractIronChestBlockEntity restored = helper.getBlockEntity(pos, AbstractIronChestBlockEntity.class);
+        helper.assertTrue(restored != chest, "World ticking uses the reloaded chest entity");
+        ICrystalChest restoredDisplay = (ICrystalChest) restored;
+        helper.assertValueEqual(displayCount(restoredDisplay, Items.DIAMOND), 5, "Reloaded inventory rebuilds the diamond display through world ticking");
+        helper.assertValueEqual(displayCount(restoredDisplay, Items.EMERALD), 3, "Reloaded inventory rebuilds the last-slot emerald display through world ticking");
+      })
+      .thenSucceed();
+  }
+
+  private static int displayCount(ICrystalChest chest, Item item) {
+    return chest.getTopItems().stream().filter(stack -> stack.is(item)).mapToInt(ItemStack::getCount).sum();
+  }
+}
