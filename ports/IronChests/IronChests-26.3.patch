+      new Upgrade(IronChestsItems.COPPER_TO_IRON_CHEST_UPGRADE.get(), IronChestsTypes.COPPER, IronChestsTypes.IRON, 45, 54),
+      new Upgrade(IronChestsItems.IRON_TO_GOLD_CHEST_UPGRADE.get(), IronChestsTypes.IRON, IronChestsTypes.GOLD, 54, 81),
+      new Upgrade(IronChestsItems.GOLD_TO_DIAMOND_CHEST_UPGRADE.get(), IronChestsTypes.GOLD, IronChestsTypes.DIAMOND, 81, 108),
+      new Upgrade(IronChestsItems.DIAMOND_TO_CRYSTAL_CHEST_UPGRADE.get(), IronChestsTypes.DIAMOND, IronChestsTypes.CRYSTAL, 108, 108),
