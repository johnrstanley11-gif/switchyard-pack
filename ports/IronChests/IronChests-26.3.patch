+  public static void capacitiesAndPersistence(GameTestHelper helper) {
+    IronChestsTypes[] tiers = {IronChestsTypes.COPPER, IronChestsTypes.IRON, IronChestsTypes.GOLD,
+      IronChestsTypes.DIAMOND, IronChestsTypes.CRYSTAL, IronChestsTypes.OBSIDIAN, IronChestsTypes.DIRT};
+    int[] capacities = {45, 54, 81, 108, 108, 108, 1};
+    for (int tierIndex = 0; tierIndex < tiers.length; tierIndex++) {
+      for (int trappedIndex = 0; trappedIndex < 2; trappedIndex++) {
+        Block block = IronChestsTypes.get(tiers[tierIndex]).get(trappedIndex);
+        BlockPos pos = new BlockPos(1 + tierIndex, 1, trappedIndex == 0 ? 2 : 5);
+        BlockState state = block.defaultBlockState().setValue(AbstractIronChestBlock.FACING, Direction.WEST);
+        helper.setBlock(pos, state);
+        AbstractIronChestBlockEntity original = helper.getBlockEntity(pos, AbstractIronChestBlockEntity.class);
+        helper.assertValueEqual(original.getContainerSize(), capacities[tierIndex], "Registered tier exposes its expected capacity");
+        Component name = Component.literal("Persisted " + tiers[tierIndex] + "/" + trappedIndex);
+        setName(original, block, name);
+        original.setItem(0, named(new ItemStack(tiers[tierIndex] == IronChestsTypes.DIRT ? Items.DIRT : Items.DIAMOND, 17), "Persisted stack"));
+        if (capacities[tierIndex] > 1) {
+          original.setItem(capacities[tierIndex] - 1, damagedTool("Persisted final slot"));
+        }
+        ItemStack[] expected = snapshot(original);
+        CompoundTag tag = original.saveWithFullMetadata(helper.getLevel().registryAccess());
+        BlockEntity loaded = BlockEntity.loadStatic(helper.absolutePos(pos), state, tag, helper.getLevel().registryAccess());
+        helper.assertTrue(loaded instanceof AbstractIronChestBlockEntity && loaded != original, "Native metadata reconstructs a separate chest entity");
+        loaded.setLevel(helper.getLevel());
+        AbstractIronChestBlockEntity restored = (AbstractIronChestBlockEntity) loaded;
+        helper.assertValueEqual(restored.getType(), original.getType(), "Block entity registry type survives save/load");
+        helper.assertValueEqual(restored.getContainerSize(), capacities[tierIndex], "Save/load keeps the entire tier capacity");
+        helper.assertValueEqual(restored.getCustomName(), name, "Save/load retains the custom name");
+        helper.assertValueEqual(restored.getBlockState(), state, "Save/load retains the supplied placed block state");
+        assertPrefix(helper, restored, expected, "Native save/load retains every slot and stack component");
+      }
+    }
+    helper.succeed();
+  }
+
+  public static void dirtGuidebook(GameTestHelper helper) {
+    Player player = player(helper, GameType.SURVIVAL);
+    for (int trappedIndex = 0; trappedIndex < 2; trappedIndex++) {
+      Block block = IronChestsTypes.get(IronChestsTypes.DIRT).get(trappedIndex);
+      BlockPos firstPos = new BlockPos(2, 1, trappedIndex == 0 ? 2 : 5);
+      BlockPos replacementPos = firstPos.east(2);
+      helper.setBlock(firstPos.below(), Blocks.STONE);
+      helper.setBlock(replacementPos.below(), Blocks.STONE);
+      ItemStack fresh = new ItemStack(block.asItem());
+      helper.assertTrue(placeChestItem(helper, player, firstPos, fresh).consumesAction(), "Fresh dirt chest is placed through its real block item");
+      AbstractIronChestBlockEntity first = helper.getBlockEntity(firstPos, AbstractIronChestBlockEntity.class);
+      ItemStack book = first.getItem(0);
+      helper.assertTrue(book.is(Items.WRITTEN_BOOK), "First placement inserts the guide book");
+      helper.assertTrue(book.has(DataComponents.WRITTEN_BOOK_CONTENT), "Guide book carries readable written-book content");
+      helper.assertTrue(book.has(DataComponents.ITEM_NAME), "Guide book carries its translated display name");
+      helper.assertTrue(fresh.isEmpty(), "Survival placement consumes the chest item");
+      first.setItem(0, ItemStack.EMPTY);
+      ItemStack previouslyPlaced = new ItemStack(block.asItem());
+      previouslyPlaced.applyComponents(first.collectComponents());
+      helper.assertTrue(previouslyPlaced.getOrDefault(IronChestsDataComponents.CHEST_PLACED_ALREADY.get(), false), "Collected block components mark prior placement");
+      helper.assertTrue(placeChestItem(helper, player, replacementPos, previouslyPlaced).consumesAction(), "Previously placed chest item is placed normally");
+      helper.assertTrue(helper.getBlockEntity(replacementPos, AbstractIronChestBlockEntity.class).isEmpty(), "Prior-placement component prevents another guide book");
+    }
+    helper.succeed();
+  }
+
+  public static void transactionsAndHopper(GameTestHelper helper) {
+    BlockPos sourcePos = new BlockPos(2, 3, 2);
+    BlockPos hopperPos = sourcePos.below();
+    BlockPos targetPos = hopperPos.east();
+    helper.setBlock(sourcePos, IronChestsBlocks.IRON_CHEST.get());
+    helper.setBlock(targetPos, IronChestsBlocks.GOLD_CHEST.get());
+    AbstractIronChestBlockEntity source = helper.getBlockEntity(sourcePos, AbstractIronChestBlockEntity.class);
+    AbstractIronChestBlockEntity target = helper.getBlockEntity(targetPos, AbstractIronChestBlockEntity.class);
+    ResourceHandler<ItemResource> sourceHandler = capability(helper, sourcePos, Direction.DOWN);
+    ResourceHandler<ItemResource> targetHandler = capability(helper, targetPos, Direction.WEST);
+    helper.assertValueEqual(sourceHandler.size(), 54, "Source capability exposes all iron chest slots");
+    helper.assertValueEqual(targetHandler.size(), 81, "Target capability exposes all gold chest slots");
+    ItemStack tool = damagedTool("Transactional last-slot tool");
+    source.setItem(53, tool.copy());
+    ItemResource resource = ItemResource.of(tool);
+    try (Transaction transaction = Transaction.openRoot()) {
+      helper.assertValueEqual(sourceHandler.extract(53, resource, 1, transaction), 1, "Transaction extracts the source last slot");
+      helper.assertValueEqual(targetHandler.insert(80, resource, 1, transaction), 1, "Transaction inserts the target last slot");
+    }
+    helper.assertTrue(ItemStack.matches(source.getItem(53), tool), "Aborting restores source cargo and components");
+    helper.assertTrue(target.getItem(80).isEmpty(), "Aborting restores the empty destination");
+    try (Transaction transaction = Transaction.openRoot()) {
+      helper.assertValueEqual(sourceHandler.extract(53, resource, 1, transaction), 1, "Committed transaction extracts once");
+      helper.assertValueEqual(targetHandler.insert(80, resource, 1, transaction), 1, "Committed transaction inserts once");
+      transaction.commit();
+    }
+    helper.assertTrue(source.getItem(53).isEmpty(), "Committed transfer clears its source");
+    helper.assertTrue(ItemStack.matches(target.getItem(80), tool), "Committed transfer preserves damage and name at the destination");
+    ItemStack diamonds = named(new ItemStack(Items.DIAMOND, 7), "Hopper cargo");
+    source.setItem(0, diamonds.copy());
+    helper.setBlock(hopperPos, Blocks.HOPPER.defaultBlockState().setValue(HopperBlock.FACING, Direction.EAST));
+    HopperBlockEntity hopper = helper.getBlockEntity(hopperPos, HopperBlockEntity.class);
+    helper.startSequence()
+      .thenWaitUntil(() -> {
+        helper.assertTrue(source.isEmpty(), "Ticking hopper drains the real source chest");
+        helper.assertTrue(hopper.isEmpty(), "Ticking hopper delivers all cargo to its neighbor");
+        helper.assertValueEqual(count(target, Items.DIAMOND), 7, "Ticking hopper delivers exactly seven diamonds");
+      })
+      .thenExecute(() -> {
+        helper.assertTrue(ItemStack.matches(target.getItem(80), tool), "Hopper operation leaves existing final-slot cargo intact");
+        helper.assertTrue(ItemStack.matches(target.getItem(0), diamonds), "Hopper transfer preserves custom components");
+      })
+      .thenSucceed();
+  }
+
+  public static void creativeAndWrongSource(GameTestHelper helper) {
+    Player creative = player(helper, GameType.CREATIVE);
+    BlockPos pos = new BlockPos(2, 1, 2);
+    helper.setBlock(pos, Blocks.CHEST.defaultBlockState().setValue(ChestBlock.FACING, Direction.SOUTH));
+    ItemStack upgrade = new ItemStack(IronChestsItems.WOOD_TO_IRON_CHEST_UPGRADE.get());
+    creative.setItemInHand(InteractionHand.MAIN_HAND, upgrade);
+    helper.assertValueEqual(useUpgrade(creative, helper.absolutePos(pos)), InteractionResult.SUCCESS, "Creative upgrades a vanilla chest");
+    helper.assertBlockPresent(IronChestsBlocks.IRON_CHEST.get(), pos);
+    helper.assertValueEqual(upgrade.getCount(), 1, "Creative retains its upgrade item");
+    helper.assertValueEqual(useUpgrade(creative, helper.absolutePos(pos)), InteractionResult.PASS, "Wood upgrade refuses an already upgraded iron chest");
+    helper.assertBlockPresent(IronChestsBlocks.IRON_CHEST.get(), pos);
+    helper.assertValueEqual(upgrade.getCount(), 1, "Wrong-source refusal retains the item");
+    BlockPos copperPos = new BlockPos(5, 1, 2);
+    Block vanillaCopper = Blocks.COPPER_CHEST.weathering().unaffected();
+    helper.setBlock(copperPos, vanillaCopper);
+    helper.assertValueEqual(useUpgrade(creative, helper.absolutePos(copperPos)), InteractionResult.PASS, "Wood upgrade refuses vanilla's separate copper chest");
+    helper.assertBlockPresent(vanillaCopper, copperPos);
+    helper.assertValueEqual(upgrade.getCount(), 1, "Vanilla copper refusal retains the item");
+    helper.succeed();
+  }
+
+  private static Player player(GameTestHelper helper, GameType gameType) {
+    Player player = helper.makeMockPlayer(gameType);
+    gameType.updatePlayerAbilities(player.getAbilities());
+    Vec3 position = Vec3.atCenterOf(helper.absolutePos(new BlockPos(1, 1, 7)));
+    player.setPos(position.x, position.y, position.z);
+    return player;
+  }
+
+  private static InteractionResult useUpgrade(Player player, BlockPos pos) {
+    ItemStack stack = player.getMainHandItem();
+    UseOnContext context = new UseOnContext(player, InteractionHand.MAIN_HAND,
+      new BlockHitResult(Vec3.atCenterOf(pos), Direction.UP, pos, false));
+    return ((ChestUpgradeItem) stack.getItem()).onItemUseFirst(stack, context);
+  }
+
+  private static InteractionResult placeChestItem(GameTestHelper helper, Player player, BlockPos pos, ItemStack stack) {
+    player.setItemInHand(InteractionHand.MAIN_HAND, stack);
+    BlockPos support = helper.absolutePos(pos.below());
+    UseOnContext context = new UseOnContext(player, InteractionHand.MAIN_HAND,
+      new BlockHitResult(Vec3.atCenterOf(support).add(0, 0.5, 0), Direction.UP, support, false));
+    return stack.getItem().useOn(context);
+  }
+
+  private static void setName(BaseContainerBlockEntity chest, Block block, Component name) {
+    ItemStack namedBlock = new ItemStack(block.asItem());
+    namedBlock.set(DataComponents.CUSTOM_NAME, name);
+    chest.applyComponentsFromItemStack(namedBlock);
+  }
+
+  private static ItemStack named(ItemStack stack, String name) {
+    stack.set(DataComponents.CUSTOM_NAME, Component.literal(name));
+    return stack;
+  }
+
+  private static ItemStack damagedTool(String name) {
+    ItemStack stack = named(new ItemStack(Items.IRON_PICKAXE), name);
+    stack.setDamageValue(11);
+    return stack;
+  }
+
+  private static ItemStack[] snapshot(Container container) {
+    ItemStack[] items = new ItemStack[container.getContainerSize()];
+    for (int slot = 0; slot < items.length; slot++) {
+      items[slot] = container.getItem(slot).copy();
+    }
+    return items;
+  }
+
+  private static void assertPrefix(GameTestHelper helper, Container container, ItemStack[] expected, String message) {
+    for (int slot = 0; slot < container.getContainerSize(); slot++) {
+      ItemStack expectedItem = slot < expected.length ? expected[slot] : ItemStack.EMPTY;
+      helper.assertTrue(ItemStack.matches(container.getItem(slot), expectedItem), message + " at slot " + slot);
+    }
+  }
+
+  private static ResourceHandler<ItemResource> capability(GameTestHelper helper, BlockPos pos, Direction side) {
+    ResourceHandler<ItemResource> handler = helper.getLevel().getCapability(Capabilities.Item.BLOCK, helper.absolutePos(pos), side);
+    helper.assertTrue(handler != null, "Registered item capability is available from " + side);
+    return handler;
+  }
+
+  private static int count(Container container, Item item) {
+    int count = 0;
+    for (int slot = 0; slot < container.getContainerSize(); slot++) {
+      ItemStack stack = container.getItem(slot);
+      if (stack.is(item)) {
+        count += stack.getCount();
+      }
+    }
+    return count;
+  }
+
+  private record Upgrade(ChestUpgradeItem item, IronChestsTypes source, IronChestsTypes target, int sourceSize, int targetSize) {
+  }
+}
