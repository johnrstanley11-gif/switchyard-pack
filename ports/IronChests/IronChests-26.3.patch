+
+/** Checks menu-driven signals and the adjacent lamp's real neighbor-update lifecycle. */
+@EventBusSubscriber(modid = IronChests.MODID)
+public final class CrystalChestRedstoneGameTests {
+
+  private static final Map<String, Consumer<GameTestHelper>> TESTS = Map.of(
+    "port_crystal_menu_never_powers_redstone", CrystalChestRedstoneGameTests::normalMenu,
+    "port_trapped_crystal_menu_powers_and_releases_redstone", CrystalChestRedstoneGameTests::trappedMenu
+  );
+
+  private CrystalChestRedstoneGameTests() {
+  }
+
+  @SubscribeEvent
+  public static void registerFunctions(RegisterEvent event) {
+    event.register(Registries.TEST_FUNCTION, registry ->
+      TESTS.forEach((name, function) -> registry.register(id(name), function)));
+  }
+
+  @SubscribeEvent
+  public static void registerTests(RegisterGameTestsEvent event) {
+    Holder<TestEnvironmentDefinition<?>> environment = event.registerEnvironment(id("crystal_redstone_tests"));
+    TESTS.forEach((name, function) -> event.registerTest(id(name), new FunctionGameTestInstance(
+      ResourceKey.create(Registries.TEST_FUNCTION, id(name)),
+      new TestData<>(environment, id("port_test_empty_small"), 40, 0, true))));
+  }
+
+  private static Identifier id(String path) {
+    return IronChests.prefix(path);
+  }
+
+  public static void normalMenu(GameTestHelper helper) {
+    menuRedstoneLifecycle(helper, IronChestsBlocks.CRYSTAL_CHEST.get(), false);
+  }
+
+  public static void trappedMenu(GameTestHelper helper) {
+    menuRedstoneLifecycle(helper, IronChestsBlocks.TRAPPED_CRYSTAL_CHEST.get(), true);
+  }
+
+  private static void menuRedstoneLifecycle(GameTestHelper helper, Block block, boolean trapped) {
+    BlockPos chestPos = new BlockPos(2, 1, 2);
+    BlockPos lampPos = chestPos.south();
+    helper.setBlock(chestPos, block);
+    helper.setBlock(lampPos, Blocks.REDSTONE_LAMP);
+    AbstractIronChestBlockEntity chest = helper.getBlockEntity(chestPos, AbstractIronChestBlockEntity.class);
+    assertSignals(helper, chestPos, 0, 0);
+    helper.assertBlockProperty(lampPos, RedstoneLampBlock.LIT, false);
+    helper.assertTrue(!helper.getLevel().hasNeighborSignal(helper.absolutePos(lampPos)), "Closed chest leaves the lamp without neighbor power");
+
+    Player player = helper.makeMockPlayer(GameType.SURVIVAL);
+    GameType.SURVIVAL.updatePlayerAbilities(player.getAbilities());
+    Vec3 position = Vec3.atCenterOf(helper.absolutePos(chestPos)).add(1, 0, 0);
+    player.setPos(position.x, position.y, position.z);
+    // The actual menu opens the container; close before the mock player's five-tick opener recheck.
+    IronChestMenu menu = IronChestMenu.createCrystalContainer(1, player.getInventory(), chest);
+    player.containerMenu = menu;
+    assertSignals(helper, chestPos, 1, trapped ? 1 : 0);
+    helper.assertValueEqual(helper.getLevel().hasNeighborSignal(helper.absolutePos(lampPos)), trapped, "Open menu supplies neighbor power only for the trapped variant");
+    helper.assertBlockProperty(lampPos, RedstoneLampBlock.LIT, trapped);
+
+    menu.removed(player);
+    player.containerMenu = player.inventoryMenu;
+    assertSignals(helper, chestPos, 0, 0);
+    helper.assertTrue(!helper.getLevel().hasNeighborSignal(helper.absolutePos(lampPos)), "Closing the menu removes neighbor power immediately");
+    helper.startSequence()
+      .thenExecuteAfter(5, () -> {
+        assertSignals(helper, chestPos, 0, 0);
+        helper.assertBlockProperty(lampPos, RedstoneLampBlock.LIT, false);
+        helper.assertTrue(!helper.getLevel().hasNeighborSignal(helper.absolutePos(lampPos)), "Lamp remains unpowered after its scheduled shutdown");
+      })
+      .thenSucceed();
+  }
+
+  private static void assertSignals(GameTestHelper helper, BlockPos relativePos, int openers, int signal) {
+    BlockPos pos = helper.absolutePos(relativePos);
+    BlockState state = helper.getBlockState(relativePos);
+    helper.assertValueEqual(AbstractIronChestBlockEntity.getOpenCount(helper.getLevel(), pos), openers, "Real menu opener count");
+    helper.assertValueEqual(state.getOwnSignal(helper.getLevel(), pos), signal, "Chest own signal");
+    for (Direction direction : Direction.values()) {
+      helper.assertValueEqual(state.getSignal(helper.getLevel(), pos, direction), signal, "Chest weak signal toward " + direction);
+      helper.assertValueEqual(helper.getLevel().getSignal(pos, direction), signal, "World weak signal toward " + direction);
+      helper.assertValueEqual(state.getDirectSignal(helper.getLevel(), pos, direction), direction == Direction.UP ? signal : 0, "Chest direct signal toward " + direction);
+    }
+  }
+}
