+package com.progwml6.ironchest.common.network;
+
+import com.progwml6.ironchest.IronChests;
+import com.progwml6.ironchest.common.block.entity.ICrystalChest;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.event.level.ChunkWatchEvent;
+import net.neoforged.neoforge.network.PacketDistributor;
+
+/** Send the public eight-stack crystal display after the client receives its chunk. */
+@EventBusSubscriber(modid = IronChests.MODID)
+public final class CrystalChestInitialSync {
+
+  private CrystalChestInitialSync() {
+  }
+
+  @SubscribeEvent
+  public static void onChunkSent(ChunkWatchEvent.Sent event) {
+    for (var blockEntity : event.getChunk().getBlockEntities().values()) {
+      if (blockEntity instanceof ICrystalChest crystal) {
+        // A newly loaded chunk can be sent before its first block-entity tick.
+        crystal.sortTopStacks(false);
+        PacketDistributor.sendToPlayer(event.getPlayer(),
+          new TopStacksSyncPacket(crystal.getChestWorldPosition(), crystal.buildItemStackDataList()));
+      }
+    }
+  }
+}
