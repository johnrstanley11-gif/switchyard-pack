+    helper.assertValueEqual(AbstractIronChestBlockEntity.getOpenCount(helper.getLevel(), helper.absolutePos(pos)), 1, "Real menu increments openers");
+    helper.assertValueEqual(useUpgrade(player, helper.absolutePos(pos)), InteractionResult.PASS, "Open chest refuses the upgrade");
