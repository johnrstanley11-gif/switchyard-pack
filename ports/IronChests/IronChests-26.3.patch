diff --git a/build.gradle b/build.gradle
index 003a3df..d04660b 100755
--- a/build.gradle
+++ b/build.gradle
@@ -1,7 +1,7 @@
 plugins {
     id 'java-library'
     id 'maven-publish'
-    id 'net.neoforged.moddev' version '2.0.141'
+    id 'net.neoforged.moddev' version '2.0.148'
     id 'idea'
 }
 
@@ -48,7 +48,7 @@ task buildInfo {
     }
 }
 
-version = "${minecraft_version}-neoforge-${mod_version}.${project.buildInfo.buildNum}"
+version = "${minecraft_version}-neoforge-${mod_version}-port263.1"
 group = mod_group_id
 
 repositories {
@@ -91,6 +91,9 @@ neoForge {
     runs {
         client {
             client()
+            if (System.getenv('PORT_QUICKPLAY_SERVER')) {
+                programArguments.addAll '--quickPlayMultiplayer', System.getenv('PORT_QUICKPLAY_SERVER')
+            }
 
             // Comma-separated list of namespaces to load gametests from. Empty = all namespaces.
             systemProperty 'neoforge.enabledGameTestNamespaces', project.mod_id
@@ -99,6 +102,7 @@ neoForge {
         server {
             server()
             programArgument '--nogui'
+            gameDirectory = layout.projectDirectory.dir('run-server')
             systemProperty 'neoforge.enabledGameTestNamespaces', project.mod_id
         }
 
@@ -107,11 +111,13 @@ neoForge {
         // The gametest system is also enabled by default for other run configs under the /test command.
         gameTestServer {
             type = "gameTestServer"
+            gameDirectory = layout.projectDirectory.dir('run-gametest')
             systemProperty 'neoforge.enabledGameTestNamespaces', project.mod_id
         }
 
         data {
             clientData()
+            gameDirectory = layout.projectDirectory.dir('run-data')
 
             // example of overriding the workingDirectory set in configureEach above, uncomment if you want to use it
             // gameDirectory = project.file('run-data')
@@ -200,6 +206,9 @@ sourceSets.main.resources.srcDir generateModMetadata
 neoForge.ideSyncTask generateModMetadata
 
 tasks.named('jar', Jar).configure {
+    // Generator cache files are bookkeeping, not pack resources.
+    exclude '.cache/**'
+    from('LICENSE') { into 'META-INF'; rename { 'LICENSE-IronChests' } }
     manifest {
         attributes([
             'Specification-Title'     : mod_id,
@@ -208,7 +217,7 @@ tasks.named('jar', Jar).configure {
             'Implementation-Title'    : project.name,
             'Implementation-Version'  : project.jar.archiveVersion,
             'Implementation-Vendor'   : mod_authors,
-            'Implementation-Timestamp': new Date().format("yyyy-MM-dd'T'HH:mm:ssZ")
+            'Implementation-Upstream-Commit': '9174022fb1cd7eb59aaf014f870badb3856d5029'
         ])
     }
 }
@@ -223,6 +232,7 @@ publishing {
         }
     }
     repositories {
+        maven { name = 'Port'; url = file('../../maven').toURI() }
         if (project.hasProperty('DEPLOY_DIR')) {
             maven {
                 url DEPLOY_DIR
@@ -233,6 +243,20 @@ publishing {
 
 tasks.withType(JavaCompile).configureEach {
     options.encoding = 'UTF-8' // Use the UTF-8 charset for Java compilation
+    options.compilerArgs += ['-Xmaxerrs', '2000']
+}
+
+// Export the real ModDev launch classpaths for private tests of the packaged jar.
+tasks.register('exportPortRunClasspaths') {
+    dependsOn 'prepareClientRun', 'prepareServerRun'
+    doLast {
+        ['client', 'server'].each { side ->
+            def runTask = tasks.named('run' + side.capitalize()).get()
+            def classpath = runTask.classpathProvider.files.collect { it.absolutePath }.join(File.pathSeparator)
+            def output = layout.buildDirectory.file('moddev/' + side + 'RunClasspath.txt').get().asFile
+            output.setText('-classpath\n"' + classpath.replace('\\', '\\\\') + '"\n', 'UTF-8')
+        }
+    }
 }
 
 // IDEA no longer automatically downloads sources/javadoc jars for dependencies, so we need to explicitly enable the behavior.
diff --git a/gradle.properties b/gradle.properties
index 025cf5e..985f4b6 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -1,22 +1,23 @@
 # Sets default memory used for gradle commands. Can be overridden by user or command line properties.
-org.gradle.jvmargs=-Xmx1G
-org.gradle.daemon=true
-org.gradle.parallel=true
+org.gradle.jvmargs=-Xmx2G
+org.gradle.daemon=false
+org.gradle.parallel=false
+org.gradle.workers.max=2
 org.gradle.caching=true
-org.gradle.configuration-cache=true
+org.gradle.configuration-cache=false
 
 # Environment Properties
 # You can find the latest versions here: https://projects.neoforged.net/neoforged/neoforge
 # The Minecraft version must agree with the Neo version to get a valid artifact
-minecraft_version=26.1.2
+minecraft_version=26.3
 # The Minecraft version range can use any release version of Minecraft as bounds.
 # Snapshots, pre-releases, and release candidates are not guaranteed to sort properly
 # as they do not follow standard versioning conventions.
-minecraft_version_range=[26.1.2]
+minecraft_version_range=[26.3,26.4)
 # The Neo version must agree with the Minecraft version to get a valid artifact
-neo_version=26.1.2.70-beta
+neo_version=26.3.0.65-beta
 # The Neo version range can use any version of Neo as bounds
-neo_version_range=[26.1.2.36-beta,)
+neo_version_range=[26.3.0.65-beta,26.4)
 # The loader version range can only use the major version of FML as bounds
 loader_version_range=[1,)
 
