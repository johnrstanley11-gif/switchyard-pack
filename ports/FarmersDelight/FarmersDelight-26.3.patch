+
+/**
+ * Port (26.x): NeoForge's RecipeWrapper is gone. A recipe input view of an item handler.
+ */
+public class RecipeWrapper implements RecipeInput
+{
+	private final ResourceHandler<ItemResource> handler;
+
+	public RecipeWrapper(ResourceHandler<ItemResource> handler) {
+		this.handler = handler;
+	}
+
+	@Override
+	public ItemStack getItem(int index) {
+		if (handler instanceof ItemStackHandler stacks) {
