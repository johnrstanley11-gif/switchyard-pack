@@ -0,0 +1,29 @@
+package vectorwing.farmersdelight.common.loot;
+
+import net.minecraft.core.Holder;
+import net.minecraft.core.HolderSet;
+import net.minecraft.world.level.storage.loot.predicates.AllOfCondition;
+import net.minecraft.world.level.storage.loot.predicates.LootItemCondition;
+
+import java.util.Arrays;
+import java.util.Optional;
+
+/**
+ * Port (26.x): loot modifiers and loot functions take a single optional condition holder instead of a condition array.
+ * This folds an array into that shape (all conditions must pass, as before).
+ */
+public final class LootConditions
+{
+	private LootConditions() {
+	}
+
+	public static Optional<Holder<LootItemCondition>> allOf(LootItemCondition... conditions) {
+		if (conditions == null || conditions.length == 0) {
+			return Optional.empty();
+		}
+		if (conditions.length == 1) {
+			return Optional.of(Holder.direct(conditions[0]));
+		}
+		return Optional.of(Holder.direct(AllOfCondition.allOf(HolderSet.direct(Arrays.stream(conditions).map(Holder::direct).toList()))));
+	}
+}
