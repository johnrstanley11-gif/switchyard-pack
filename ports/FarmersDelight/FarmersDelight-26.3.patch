+	private static <T extends Block> DeferredHolder<Block, T> register(String name, Supplier<? extends T> block) {
+		ResourceKey<Block> key = ResourceKey.create(Registries.BLOCK, Identifier.fromNamespaceAndPath(FarmersDelight.MODID, name));
