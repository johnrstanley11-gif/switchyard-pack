diff --git a/src/main/java/vectorwing/farmersdelight/client/renderer/SkilletSpecialRenderer.java b/src/main/java/vectorwing/farmersdelight/client/renderer/SkilletSpecialRenderer.java
new file mode 100644
index 00000000..ee227748
--- /dev/null
+++ b/src/main/java/vectorwing/farmersdelight/client/renderer/SkilletSpecialRenderer.java
@@ -0,0 +1,185 @@
+package vectorwing.farmersdelight.client.renderer;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import com.mojang.math.Axis;
+import com.mojang.serialization.Codec;
+import com.mojang.serialization.MapCodec;
+import com.mojang.serialization.codecs.RecordCodecBuilder;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.model.HumanoidModel;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.client.renderer.SubmitNodeCollector;
+import net.minecraft.client.renderer.entity.state.HumanoidRenderState;
+import net.minecraft.client.renderer.item.ItemModelResolver;
+import net.minecraft.client.renderer.item.ItemStackRenderState;
+import net.minecraft.client.renderer.item.properties.conditional.ConditionalItemModelProperty;
+import net.minecraft.client.renderer.special.SpecialModelRenderer;
+import net.minecraft.util.Mth;
+import net.minecraft.world.entity.HumanoidArm;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.item.ItemDisplayContext;
+import net.minecraft.world.item.ItemStack;
+import net.neoforged.neoforge.client.IArmPoseTransformer;
+import org.joml.Vector3f;
+import org.joml.Vector3fc;
+import org.jspecify.annotations.Nullable;
+import vectorwing.farmersdelight.common.item.SkilletItem;
+import vectorwing.farmersdelight.common.item.component.ItemStackWrapper;
+import vectorwing.farmersdelight.common.registry.ModDataComponents;
+
+import java.util.function.Consumer;
+
+/**
+ * The skillet item while it is cooking something: the pan with the ingredient in it, flipping with the player's arm.
+ * <p>
+ * Port (26.x): BlockEntityWithoutLevelRenderer and item property overrides are gone. The item definition
+ * (assets/farmersdelight/items/skillet.json) now switches on the {@link CookingProperty} and uses this special model
+ * renderer for the cooking pan; a separate "first_person" flag replaces the display-context check the old renderer did,
+ * because special renderers are not told the display context any more.
+ */
+public class SkilletSpecialRenderer implements SpecialModelRenderer<SkilletSpecialRenderer.Argument>
+{
+	private static final Vector3fc[] EXTENTS = new Vector3fc[]{
+			new Vector3f(0, 0, 0), new Vector3f(1, 0, 0), new Vector3f(0, 1, 0), new Vector3f(1, 1, 0),
+			new Vector3f(0, 0, 1), new Vector3f(1, 0, 1), new Vector3f(0, 1, 1), new Vector3f(1, 1, 1)};
+
+	private final boolean firstPerson;
+
+	public SkilletSpecialRenderer(boolean firstPerson) {
+		this.firstPerson = firstPerson;
+	}
+
+	/** Everything the renderer needs, resolved while the item is being extracted. */
+	public record Argument(ItemStackRenderState skillet, ItemStackRenderState ingredient, @Nullable Long flipTimestamp, boolean flipped)
+	{
+	}
+
+	@Override
+	public @Nullable Argument extractArgument(ItemStack stack) {
+		Minecraft mc = Minecraft.getInstance();
+		ClientLevel level = mc.level;
+		if (level == null) {
+			return null;
+		}
+		ItemModelResolver resolver = mc.getItemModelResolver();
+
+		// The pan itself: the plain skillet item (without the ingredient) renders as the skillet block model.
+		ItemStack plainSkillet = stack.copy();
+		plainSkillet.remove(ModDataComponents.SKILLET_INGREDIENT.get());
+		ItemStackRenderState skillet = new ItemStackRenderState();
+		resolver.updateForTopItem(skillet, plainSkillet, ItemDisplayContext.NONE, level, null, 0);
+
+		ItemStack ingredientStack = stack.getOrDefault(ModDataComponents.SKILLET_INGREDIENT.get(), ItemStackWrapper.EMPTY).getStack();
+		ItemStackRenderState ingredient = new ItemStackRenderState();
+		if (!ingredientStack.isEmpty()) {
+			resolver.updateForTopItem(ingredient, ingredientStack, ItemDisplayContext.FIXED, level, null, 0);
+		}
+
+		return new Argument(skillet, ingredient, stack.get(ModDataComponents.SKILLET_FLIP_TIMESTAMP.get()), stack.getOrDefault(ModDataComponents.SKILLET_FLIPPED.get(), false));
+	}
+
+	@Override
+	public void submit(@Nullable Argument argument, PoseStack poseStack, SubmitNodeCollector submitNodeCollector, int lightCoords, int overlayCoords, boolean hasFoil, int outlineColor) {
+		if (argument == null) {
+			return;
+		}
+		Minecraft mc = Minecraft.getInstance();
+		float animation = 0;
+
+		if (!argument.ingredient().isEmpty()) {
+			poseStack.pushPose();
+			poseStack.translate(0.5F, 1 / 16F, 0.5F);
+			if (argument.flipTimestamp() != null && mc.level != null) {
+				long gameTime = mc.level.getGameTime();
+				float partialTicks = mc.getDeltaTracker().getGameTimeDeltaPartialTick(false);
+				animation = ((gameTime - argument.flipTimestamp()) + partialTicks) / SkilletItem.FLIP_TIME;
+				animation = Mth.clamp(animation, 0, 1);
+				float maxH = 0.4F;
+				poseStack.translate(0, maxH * Mth.sin(animation * Mth.PI), 0);
+				float rotationAnimation = argument.flipped() ? animation + 1.0F : animation;
+				poseStack.rotateDegrees(Axis.XP, 180 * rotationAnimation);
+			} else {
+				poseStack.rotateDegrees(Axis.XP, argument.flipped() ? 180 : 0);
+			}
+			poseStack.rotateDegrees(Axis.XP, 90);
+			poseStack.scale(0.5F, 0.5F, 0.5F);
+			argument.ingredient().submit(poseStack, submitNodeCollector, lightCoords, overlayCoords, outlineColor);
+			poseStack.popPose();
+		}
+
+		poseStack.pushPose();
+		if (animation != 0 && this.firstPerson) {
+			poseStack.translate(0, 0, 1);
+			poseStack.rotateDegrees(Axis.XN, Mth.sin(animation * Mth.TWO_PI) * 15);
+			poseStack.translate(0F, 0, -1);
+			poseStack.translate(0, 0, -Mth.sin(animation * Mth.PI) * 0.2F);
+		}
+		argument.skillet().submit(poseStack, submitNodeCollector, lightCoords, overlayCoords, outlineColor);
+		poseStack.popPose();
+	}
+
+	@Override
+	public void getExtents(Consumer<Vector3fc> output) {
+		for (Vector3fc corner : EXTENTS) {
+			output.accept(corner);
+		}
+	}
+
+	public record Unbaked(boolean firstPerson) implements SpecialModelRenderer.Unbaked<Argument>
+	{
+		public static final MapCodec<Unbaked> MAP_CODEC = RecordCodecBuilder.mapCodec(
+				i -> i.group(Codec.BOOL.optionalFieldOf("first_person", false).forGetter(Unbaked::firstPerson)).apply(i, Unbaked::new));
+
+		@Override
+		public SpecialModelRenderer<Argument> bake(SpecialModelRenderer.BakingContext context) {
+			return new SkilletSpecialRenderer(this.firstPerson);
+		}
+
+		@Override
+		public MapCodec<Unbaked> type() {
+			return MAP_CODEC;
+		}
+	}
+
+	/**
+	 * The old "cooking" item property: true while the skillet holds an ingredient. In the GUI the plain pan is shown,
+	 * as before (the old renderer skipped the ingredient there).
+	 */
+	public record CookingProperty() implements ConditionalItemModelProperty
+	{
+		public static final MapCodec<CookingProperty> MAP_CODEC = MapCodec.unit(new CookingProperty());
+
+		@Override
+		public boolean get(ItemStack itemStack, @Nullable ClientLevel level, @Nullable LivingEntity owner, int seed, ItemDisplayContext displayContext) {
+			return displayContext != ItemDisplayContext.GUI
+					&& !itemStack.getOrDefault(ModDataComponents.SKILLET_INGREDIENT.get(), ItemStackWrapper.EMPTY).getStack().isEmpty();
+		}
+
+		@Override
+		public MapCodec<CookingProperty> type() {
+			return MAP_CODEC;
+		}
+	}
+
+	public static class ArmPoseTransformer implements IArmPoseTransformer
+	{
+		@Override
+		public void applyTransform(HumanoidModel<?> model, HumanoidRenderState state, HumanoidArm arm) {
+			// Port (26.x): the transformer gets the render state; the used stack is read from it instead of the entity.
+			ItemStack stack = state.getUseItemStackForArm(arm);
+			Minecraft mc = Minecraft.getInstance();
+			if (stack.has(ModDataComponents.SKILLET_FLIP_TIMESTAMP.get()) && mc.level != null) {
+				long time = stack.get(ModDataComponents.SKILLET_FLIP_TIMESTAMP.get());
+				float partialTicks = mc.getDeltaTracker().getGameTimeDeltaPartialTick(false);
+				float animation = ((mc.level.getGameTime() - time) + partialTicks) / SkilletItem.FLIP_TIME;
+				animation = Mth.clamp(animation, 0, 1);
+
+				if (arm == HumanoidArm.LEFT) {
+					model.leftArm.xRot = (-Mth.sin(animation * Mth.TWO_PI) * 15 - 20) * (float) (Math.PI / 180.0);
+				} else {
+					model.rightArm.xRot = (-Mth.sin(animation * Mth.TWO_PI) * 15 - 20) * (float) (Math.PI / 180.0);
+				}
+			}
+		}
+	}
+}
