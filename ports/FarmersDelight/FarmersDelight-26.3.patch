+package vectorwing.farmersdelight.client.renderer;
+
+import net.minecraft.client.model.geom.ModelLayerLocation;
+import net.minecraft.client.model.geom.PartPose;
+import net.minecraft.client.model.geom.builders.CubeListBuilder;
+import net.minecraft.client.model.geom.builders.LayerDefinition;
+import net.minecraft.client.model.geom.builders.MeshDefinition;
+import net.minecraft.client.model.geom.builders.PartDefinition;
+import net.minecraft.resources.Identifier;
+import net.neoforged.neoforge.client.event.EntityRenderersEvent;
+import vectorwing.farmersdelight.FarmersDelight;
+
+/**
+ * Port (26.x): vanilla signs are block models now and the SignModel / HangingSignModel layers (and
+ * ModelLayers.createSignModelName) are gone. Canvas signs keep drawing their board from the mod's 64x32 sign sheets,
+ * so the two old vanilla sign layers are declared here, exactly as they were.
+ */
+public class ModModelLayers
+{
+	public static final ModelLayerLocation CANVAS_SIGN = new ModelLayerLocation(Identifier.fromNamespaceAndPath(FarmersDelight.MODID, "canvas_sign"), "main");
+	public static final ModelLayerLocation HANGING_CANVAS_SIGN = new ModelLayerLocation(Identifier.fromNamespaceAndPath(FarmersDelight.MODID, "hanging_canvas_sign"), "main");
+
+	public static void register(EntityRenderersEvent.RegisterLayerDefinitions event) {
+		event.registerLayerDefinition(CANVAS_SIGN, ModModelLayers::createSignLayer);
+		event.registerLayerDefinition(HANGING_CANVAS_SIGN, ModModelLayers::createHangingSignLayer);
+	}
+
+	/** The 1.21 vanilla sign model: a 24x12x2 board and a 2x14x2 stick on a 64x32 sheet. */
+	public static LayerDefinition createSignLayer() {
+		MeshDefinition mesh = new MeshDefinition();
+		PartDefinition root = mesh.getRoot();
+		root.addOrReplaceChild("sign", CubeListBuilder.create().texOffs(0, 0).addBox(-12.0F, -14.0F, -1.0F, 24.0F, 12.0F, 2.0F), PartPose.ZERO);
+		root.addOrReplaceChild("stick", CubeListBuilder.create().texOffs(0, 14).addBox(-1.0F, -2.0F, -1.0F, 2.0F, 14.0F, 2.0F), PartPose.ZERO);
+		return LayerDefinition.create(mesh, 64, 32);
+	}
+
+	/** The 1.21 vanilla hanging sign model: board, plank (wall mount), two pairs of angled chains and the straight chains. */
+	public static LayerDefinition createHangingSignLayer() {
+		MeshDefinition mesh = new MeshDefinition();
+		PartDefinition root = mesh.getRoot();
+		root.addOrReplaceChild("board", CubeListBuilder.create().texOffs(0, 12).addBox(-7.0F, -7.0F, -1.0F, 14.0F, 10.0F, 2.0F), PartPose.ZERO);
+		root.addOrReplaceChild("plank", CubeListBuilder.create().texOffs(0, 0).addBox(-8.0F, -10.0F, -2.0F, 16.0F, 2.0F, 4.0F), PartPose.ZERO);
+		PartDefinition normalChains = root.addOrReplaceChild("normalChains", CubeListBuilder.create(), PartPose.ZERO);
+		normalChains.addOrReplaceChild("chainL1", CubeListBuilder.create().texOffs(0, 6).addBox(-1.5F, 0.0F, 0.0F, 3.0F, 6.0F, 0.0F), PartPose.offsetAndRotation(-5.0F, -6.0F, 0.0F, 0.0F, -0.7853982F, 0.0F));
+		normalChains.addOrReplaceChild("chainL2", CubeListBuilder.create().texOffs(6, 6).addBox(-1.5F, 0.0F, 0.0F, 3.0F, 6.0F, 0.0F), PartPose.offsetAndRotation(-5.0F, -6.0F, 0.0F, 0.0F, 0.7853982F, 0.0F));
+		normalChains.addOrReplaceChild("chainR1", CubeListBuilder.create().texOffs(0, 6).addBox(-1.5F, 0.0F, 0.0F, 3.0F, 6.0F, 0.0F), PartPose.offsetAndRotation(5.0F, -6.0F, 0.0F, 0.0F, -0.7853982F, 0.0F));
+		normalChains.addOrReplaceChild("chainR2", CubeListBuilder.create().texOffs(6, 6).addBox(-1.5F, 0.0F, 0.0F, 3.0F, 6.0F, 0.0F), PartPose.offsetAndRotation(5.0F, -6.0F, 0.0F, 0.0F, 0.7853982F, 0.0F));
+		root.addOrReplaceChild("vChains", CubeListBuilder.create().texOffs(14, 6).addBox(-6.0F, -6.0F, 0.0F, 12.0F, 6.0F, 0.0F), PartPose.ZERO);
+		return LayerDefinition.create(mesh, 64, 32);
+	}
+}
