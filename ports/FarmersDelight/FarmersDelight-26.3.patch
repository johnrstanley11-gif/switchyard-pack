diff --git a/src/main/java/vectorwing/farmersdelight/data/ValueTagAppender.java b/src/main/java/vectorwing/farmersdelight/data/ValueTagAppender.java
new file mode 100644
index 00000000..3c90fd69
--- /dev/null
+++ b/src/main/java/vectorwing/farmersdelight/data/ValueTagAppender.java
@@ -0,0 +1,92 @@
+package vectorwing.farmersdelight.data;
+
+import net.minecraft.core.Registry;
+import net.minecraft.data.tags.TagAppender;
+import net.minecraft.resources.ResourceKey;
+import net.minecraft.tags.TagEntry;
+import net.minecraft.tags.TagKey;
+
+/**
+ * Port (26.x): tag appenders only accept registry keys now. This wraps one so the providers can keep adding the
+ * registered objects themselves (items, blocks, entity types), as they always did.
+ */
+public class ValueTagAppender<T> implements TagAppender<T>
+{
+	private final TagAppender<T> delegate;
+	private final Registry<T> registry;
+
+	public ValueTagAppender(TagAppender<T> delegate, Registry<T> registry) {
+		this.delegate = delegate;
+		this.registry = registry;
+	}
+
+	private ResourceKey<T> key(T value) {
+		return registry.getResourceKey(value).orElseThrow(() -> new IllegalStateException("Unregistered tag element: " + value));
+	}
+
+	public ValueTagAppender<T> add(T value) {
+		delegate.add(key(value));
+		return this;
+	}
+
+	@SafeVarargs
+	public final ValueTagAppender<T> add(T... values) {
+		for (T value : values) {
+			delegate.add(key(value));
+		}
+		return this;
+	}
+
+	public ValueTagAppender<T> remove(T value) {
+		delegate.remove(key(value));
+		return this;
+	}
+
+	@Override
+	public ValueTagAppender<T> add(ResourceKey<T> element) {
+		delegate.add(element);
+		return this;
+	}
+
+	@Override
+	public ValueTagAppender<T> addOptional(ResourceKey<T> element) {
+		delegate.addOptional(element);
+		return this;
+	}
+
+	@Override
+	public ValueTagAppender<T> addTag(TagKey<T> tag) {
+		delegate.addTag(tag);
+		return this;
+	}
+
+	@Override
+	public ValueTagAppender<T> addOptionalTag(TagKey<T> tag) {
+		delegate.addOptionalTag(tag);
+		return this;
+	}
+
+	@Override
+	public ValueTagAppender<T> add(TagEntry entry) {
+		delegate.add(entry);
+		return this;
+	}
+
+	@Override
+	public ValueTagAppender<T> replace(boolean value) {
+		delegate.replace(value);
+		return this;
+	}
+
+	@Override
+	public ValueTagAppender<T> remove(ResourceKey<T> element) {
+		delegate.remove(element);
+		return this;
+	}
+
+	@Override
+	public ValueTagAppender<T> remove(TagKey<T> tag) {
+		delegate.remove(tag);
+		return this;
+	}
+}
