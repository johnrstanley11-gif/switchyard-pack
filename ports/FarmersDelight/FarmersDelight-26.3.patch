+package vectorwing.farmersdelight.client;
+
+import net.minecraft.world.item.crafting.RecipeMap;
+
+/**
+ * Port (26.x): the client has no recipe manager any more. The server sends the mod's recipe types on datapack sync
+ * (CommonEvents#onDatapackSync, through NeoForge's recipe sync) and the client keeps the latest map here; the JEI
+ * plugin reads it.
+ */
+public final class ClientRecipes
+{
+	private static volatile RecipeMap recipeMap = RecipeMap.EMPTY;
+
+	private ClientRecipes() {
+	}
+
+	public static void update(RecipeMap map) {
+		recipeMap = map;
+	}
+
+	public static RecipeMap recipeMap() {
+		return recipeMap;
+	}
+}
