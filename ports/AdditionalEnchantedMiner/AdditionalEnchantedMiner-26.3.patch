@@ -0,0 +1,221 @@
+// Modified 2026-10-11: private Minecraft 26.3 port; genuine author Advanced Pump carry and API migration.
+package com.yogpc.qp.neoforge.gametest;
+
+import com.yogpc.qp.QuarryPlus;
+import com.yogpc.qp.machine.MachineStorage;
+import com.yogpc.qp.machine.MachineStorageHolder;
+import com.yogpc.qp.neoforge.integration.AdvPumpFluidHandler;
+import com.kotori316.testutil.common.TestFunction;
+import java.util.List;
+import net.neoforged.neoforge.transfer.ResourceHandler;
+import net.neoforged.neoforge.transfer.fluid.FluidResource;
+import net.neoforged.neoforge.transfer.transaction.Transaction;
+import net.minecraft.gametest.framework.GameTestHelper;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.level.material.Fluids;
+import net.neoforged.neoforge.fluids.FluidStack;
+import net.neoforged.neoforge.fluids.FluidType;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+public final class AdvPumpFluidHandlerTest {
+    static List<TestFunction> tests() {
+        var instance = new AdvPumpFluidHandlerTest();
+        return List.of(
+            TestFunction.create(QuarryPlus.modID, "AdvPumpFluidHandlerTestLoadHandler", instance::loadHandler),
+            TestFunction.create(QuarryPlus.modID, "AdvPumpFluidHandlerTestTankCountMatchesDistinctFluidsHeld", instance::tankCountMatchesDistinctFluidsHeld),
+            TestFunction.create(QuarryPlus.modID, "AdvPumpFluidHandlerTestIsFluidValidAlwaysFalse", instance::isFluidValidAlwaysFalse),
+            TestFunction.create(QuarryPlus.modID, "AdvPumpFluidHandlerTestInsertionIsRefused", instance::insertionIsRefused),
+            TestFunction.create(QuarryPlus.modID, "AdvPumpFluidHandlerTestExtractionIsAllowed", instance::extractionIsAllowed),
+            TestFunction.create(QuarryPlus.modID, "AdvPumpFluidHandlerTestExtractionByIndexIsAllowed", instance::extractionByIndexIsAllowed),
+            TestFunction.create(QuarryPlus.modID, "AdvPumpFluidHandlerTestAbortedAndPartialExtraction", instance::abortedAndPartialExtraction),
+            TestFunction.create(QuarryPlus.modID, "AdvPumpFluidHandlerTestComponentSensitiveExtraction", instance::componentSensitiveExtraction),
+            TestFunction.create(QuarryPlus.modID, "AdvPumpFluidHandlerTestItemRollbackAndPartialExtraction", instance::itemRollbackAndPartialExtraction),
+            TestFunction.create(QuarryPlus.modID, "AdvPumpFluidHandlerTestMultipleWrappersShareRollback", instance::multipleWrappersShareRollback)
+        );
+    }
+
+    private static final MachineStorageHolder<MachineStorageHolder.Constant> ACCESSOR = new MachineStorageHolder.ForConstant();
+
+    public void loadHandler(GameTestHelper helper) {
+        var storage = MachineStorage.of();
+        var handler = assertDoesNotThrow(() -> new AdvPumpFluidHandler<>(ACCESSOR, new MachineStorageHolder.Constant(storage)));
+        assertInstanceOf(ResourceHandler.class, handler);
+        helper.succeed();
+    }
+
+    public void tankCountMatchesDistinctFluidsHeld(GameTestHelper helper) {
+        var storage = MachineStorage.of();
+        var handler = new AdvPumpFluidHandler<>(ACCESSOR, new MachineStorageHolder.Constant(storage));
+        assertEquals(0, handler.size(), "No fluid held yet -> no tanks, no reserved empty slot for insertion");
+
+        storage.addBucketFluid(new ItemStack(Items.WATER_BUCKET));
+        assertEquals(1, handler.size(), "Exactly one tank per distinct fluid held, no +1 for insertion since insertion is refused");
+
+        helper.succeed();
+    }
+
+    public void isFluidValidAlwaysFalse(GameTestHelper helper) {
+        var storage = MachineStorage.of();
+        var handler = new AdvPumpFluidHandler<>(ACCESSOR, new MachineStorageHolder.Constant(storage));
+        assertFalse(handler.isValid(0, FluidResource.of(Fluids.WATER)));
+        helper.succeed();
+    }
+
+    public void insertionIsRefused(GameTestHelper helper) {
+        var storage = MachineStorage.of();
+        var handler = new AdvPumpFluidHandler<>(ACCESSOR, new MachineStorageHolder.Constant(storage));
+
+        int filled;
+        try (var transaction = Transaction.openRoot()) {
+            filled = handler.insert(0, FluidResource.of(Fluids.WATER), FluidType.BUCKET_VOLUME, transaction);
+            transaction.commit();
+        }
+
+        assertEquals(0, filled, "fill() must always report that nothing was accepted");
+        assertEquals(0, storage.getFluidCount(Fluids.WATER), "Nothing should have actually been added to storage");
+        helper.succeed();
+    }
+
+    public void extractionIsAllowed(GameTestHelper helper) {
+        var storage = MachineStorage.of();
+        storage.addBucketFluid(new ItemStack(Items.WATER_BUCKET));
+        var handler = new AdvPumpFluidHandler<>(ACCESSOR, new MachineStorageHolder.Constant(storage));
+
+        var resource = FluidResource.of(Fluids.WATER);
+        int drained;
+        try (var transaction = Transaction.openRoot()) {
+            drained = handler.extract(resource, FluidType.BUCKET_VOLUME, transaction);
+            transaction.commit();
+        }
+
+        assertEquals(Fluids.WATER, resource.getFluid());
+        assertEquals(FluidType.BUCKET_VOLUME, drained);
+        assertEquals(0, storage.getFluidCount(Fluids.WATER), "The extracted fluid must actually leave storage");
+        helper.succeed();
+    }
+
+    public void extractionByIndexIsAllowed(GameTestHelper helper) {
+        var storage = MachineStorage.of();
+        storage.addBucketFluid(new ItemStack(Items.WATER_BUCKET));
+        var handler = new AdvPumpFluidHandler<>(ACCESSOR, new MachineStorageHolder.Constant(storage));
+
+        var resource = handler.getResource(0);
+        int drained;
+        try (var transaction = Transaction.openRoot()) {
+            drained = handler.extract(0, resource, FluidType.BUCKET_VOLUME, transaction);
+            transaction.commit();
+        }
+
+        assertEquals(Fluids.WATER, resource.getFluid());
+        assertEquals(FluidType.BUCKET_VOLUME, drained);
+        assertEquals(0, storage.getFluidCount(Fluids.WATER));
+        helper.succeed();
+    }
+    public void abortedAndPartialExtraction(GameTestHelper helper) {
+        var storage = MachineStorage.of();
+        storage.addBucketFluid(new ItemStack(Items.WATER_BUCKET));
+        var handler = new AdvPumpFluidHandler<>(ACCESSOR, new MachineStorageHolder.Constant(storage));
+        var resource = handler.getResource(0);
+        try (var transaction = Transaction.openRoot()) {
+            assertEquals(250, handler.extract(0, resource, 250, transaction));
+            try (var nested = Transaction.open(transaction)) {
+                assertEquals(250, handler.extract(0, resource, 250, nested));
+                nested.commit();
+            }
+        }
+        assertEquals(MachineStorage.ONE_BUCKET, storage.getFluidCount(Fluids.WATER), "Root abort restores the nested committed drain");
+        try (var transaction = Transaction.openRoot()) {
+            assertEquals(250, handler.extract(0, resource, 250, transaction));
+            transaction.commit();
+        }
+        assertEquals(MachineStorage.ONE_BUCKET * 3 / 4, storage.getFluidCount(Fluids.WATER));
+        assertEquals(750, handler.getAmountAsLong(0));
+        helper.succeed();
+    }
+
+    public void componentSensitiveExtraction(GameTestHelper helper) {
+        var storage = MachineStorage.of();
+        var constant = new MachineStorageHolder.Constant(storage);
+        var patch = net.minecraft.core.component.DataComponentPatch.builder()
+            .set(net.minecraft.core.component.DataComponents.CUSTOM_NAME, net.minecraft.network.chat.Component.literal("Pump fluid"))
+            .build();
+        var resource = FluidResource.of(Fluids.WATER, patch);
+        var writable = com.yogpc.qp.neoforge.machine.MachineStorageNeoForge.createFluidHandler(ACCESSOR, constant);
+        try (var transaction = Transaction.openRoot()) {
+            assertEquals(1000, writable.insert(0, resource, 1000, transaction));
+            transaction.commit();
+        }
+        var handler = new AdvPumpFluidHandler<>(ACCESSOR, constant);
+        assertEquals(resource, handler.getResource(0));
+        try (var transaction = Transaction.openRoot()) {
+            assertEquals(0, handler.extract(0, FluidResource.of(Fluids.WATER), 1000, transaction), "A different component patch must not match");
+            assertEquals(250, handler.extract(0, resource, 250, transaction));
+        }
+        assertEquals(resource, handler.getResource(0));
+        assertEquals(1000, handler.getAmountAsLong(0));
+        helper.succeed();
+    }
+
+    public void itemRollbackAndPartialExtraction(GameTestHelper helper) {
+        var storage = MachineStorage.of();
+        storage.addItem(new ItemStack(Items.DIAMOND, 64));
+        var handler = com.yogpc.qp.neoforge.machine.MachineStorageNeoForge.createItemHandler(ACCESSOR, new MachineStorageHolder.Constant(storage));
+        var resource = handler.getResource(0);
+        try (var transaction = Transaction.openRoot()) {
+            assertEquals(3, handler.extract(0, resource, 3, transaction));
+        }
+        assertEquals(64, storage.getItemByIndex(0).getCount());
+        try (var transaction = Transaction.openRoot()) {
+            assertEquals(3, handler.extract(0, resource, 3, transaction));
+            transaction.commit();
+        }
+        assertEquals(61, storage.getItemByIndex(0).getCount(), "Partial extraction retains the unrequested items");
+        assertEquals(2, storage.extractItemByIndex(0, 2, true).getCount());
+        assertEquals(59, storage.getItemByIndex(0).getCount());
+        helper.succeed();
+    }
+    public void multipleWrappersShareRollback(GameTestHelper helper) {
+        var storage = MachineStorage.of();
+        var constant = new MachineStorageHolder.Constant(storage);
+        storage.addItem(new ItemStack(Items.DIAMOND, 64));
+        var firstItem = com.yogpc.qp.neoforge.machine.MachineStorageNeoForge.createItemHandler(ACCESSOR, constant);
+        var secondItem = com.yogpc.qp.neoforge.machine.MachineStorageNeoForge.createItemHandler(ACCESSOR, constant);
+        var updates = new java.util.concurrent.atomic.AtomicInteger();
+        storage.onUpdate(updates::incrementAndGet);
+        var item = firstItem.getResource(0);
+        try (var transaction = Transaction.openRoot()) {
+            assertEquals(3, firstItem.extract(0, item, 3, transaction));
+            assertEquals(2, secondItem.extract(0, item, 2, transaction));
+        }
+        assertEquals(64, firstItem.getAmountAsLong(0), "All wrappers must roll back to the same original storage snapshot");
+        assertEquals(0, updates.get(), "Aborted transfers do not notify a committed inventory change");
+        try (var transaction = Transaction.openRoot()) {
+            assertEquals(3, firstItem.extract(0, item, 3, transaction));
+            assertEquals(2, secondItem.extract(0, item, 2, transaction));
+            transaction.commit();
+        }
+        assertEquals(59, firstItem.getAmountAsLong(0));
+        assertEquals(1, updates.get(), "One storage journal sends one root commit notification across wrappers");
+        storage.addBucketFluid(new ItemStack(Items.WATER_BUCKET));
+        updates.set(0);
+        var firstFluid = new AdvPumpFluidHandler<>(ACCESSOR, constant);
+        var secondFluid = new AdvPumpFluidHandler<>(ACCESSOR, constant);
+        var water = firstFluid.getResource(0);
+        try (var transaction = Transaction.openRoot()) {
+            assertEquals(200, firstFluid.extract(0, water, 200, transaction));
+            assertEquals(100, secondFluid.extract(0, water, 100, transaction));
+        }
+        assertEquals(1000, firstFluid.getAmountAsLong(0));
+        assertEquals(0, updates.get());
+        try (var transaction = Transaction.openRoot()) {
+            assertEquals(200, firstFluid.extract(0, water, 200, transaction));
+            assertEquals(100, secondFluid.extract(0, water, 100, transaction));
+            transaction.commit();
+        }
+        assertEquals(700, firstFluid.getAmountAsLong(0));
+        assertEquals(1, updates.get());
+        helper.succeed();
+    }
+}
