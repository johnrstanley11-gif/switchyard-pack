--- /dev/null
+++ b/src/main/java/net/nicguzzo/wands/client/render/PreviewRenderState.java
@@ -0,0 +1,187 @@
+// Modified 2026-10-11 for the selected private Minecraft 26.3 NeoForge target (Apache-2.0).
+// Changed for the private Minecraft 26.3 NeoForge port, 11 October 2026 (Apache-2.0).
+// New immutable preview vertex and baked-quad snapshots for the extraction/submission pipeline.
+package net.nicguzzo.wands.client.render;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import com.mojang.blaze3d.vertex.QuadInstance;
+import com.mojang.blaze3d.vertex.VertexConsumer;
+import net.minecraft.client.renderer.SubmitNodeCollector;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import net.minecraft.client.resources.model.geometry.BakedQuad;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.BiConsumer;
+
+/** A frame's preview geometry, with no references to the mutable wand or level. */
+final class PreviewRenderState {
+    private final List<Batch> batches;
+
+    private PreviewRenderState(List<Batch> batches) {
+        this.batches = List.copyOf(batches);
+    }
+
+    void submit(PoseStack pose, SubmitNodeCollector collector) {
+        for (Batch batch : batches) {
+            collector.submitCustomGeometry(pose, batch.type(), (submittedPose, consumer) -> {
+                for (Draw draw : batch.draws()) draw.emit(submittedPose, consumer);
+            });
+        }
+    }
+
+    static final class Builder {
+        private final List<Batch> batches = new ArrayList<>();
+
+        void capture(PoseStack pose, RenderType type, BiConsumer<PoseStack, VertexConsumer> drawer) {
+            Recorder recorder = new Recorder();
+            // All block, fluid, model and configuration queries run during extraction.
+            drawer.accept(pose, recorder);
+            List<Draw> draws = recorder.finish();
+            if (!draws.isEmpty()) batches.add(new Batch(type, draws));
+        }
+
+        PreviewRenderState build() {
+            return new PreviewRenderState(batches);
+        }
+    }
+
+    private record Batch(RenderType type, List<Draw> draws) { }
+
+    private interface Draw {
+        void emit(PoseStack.Pose submittedPose, VertexConsumer consumer);
+    }
+
+    private record Vertex(float x, float y, float z, int attributes, int color,
+                          float u, float v, int overlayU, int overlayV, int lightU, int lightV,
+                          float extraU, float extraV, float normalX, float normalY, float normalZ,
+                          float lineWidth) implements Draw {
+        @Override
+        public void emit(PoseStack.Pose pose, VertexConsumer consumer) {
+            consumer.addVertex(pose, x, y, z);
+            if ((attributes & Recorder.COLOR) != 0) consumer.setColor(color);
+            if ((attributes & Recorder.UV) != 0) consumer.setUv(u, v);
+            if ((attributes & Recorder.OVERLAY) != 0) consumer.setUv1(overlayU, overlayV);
+            if ((attributes & Recorder.LIGHT) != 0) consumer.setUv2(lightU, lightV);
+            if ((attributes & Recorder.EXTRA_UV) != 0) consumer.setUv3(extraU, extraV);
+            if ((attributes & Recorder.NORMAL) != 0) consumer.setNormal(pose, normalX, normalY, normalZ);
+            if ((attributes & Recorder.LINE_WIDTH) != 0) consumer.setLineWidth(lineWidth);
+        }
+    }
+
+    private record QuadValues(int color0, int color1, int color2, int color3,
+                              int light0, int light1, int light2, int light3, int overlay) {
+        QuadValues(QuadInstance instance) {
+            this(instance.getColor(0), instance.getColor(1), instance.getColor(2), instance.getColor(3),
+                    instance.getLightCoords(0), instance.getLightCoords(1), instance.getLightCoords(2),
+                    instance.getLightCoords(3), instance.overlayCoords());
+        }
+
+        QuadInstance instance() {
+            QuadInstance instance = new QuadInstance();
+            instance.setColor(0, color0); instance.setColor(1, color1);
+            instance.setColor(2, color2); instance.setColor(3, color3);
+            instance.setLightCoords(0, light0); instance.setLightCoords(1, light1);
+            instance.setLightCoords(2, light2); instance.setLightCoords(3, light3);
+            instance.setOverlayCoords(overlay);
+            return instance;
+        }
+    }
+
+    private static final class Quad implements Draw {
+        private final BakedQuad quad;
+        // Never expose or mutate this private copy after construction.
+        private final PoseStack.Pose pose;
+        private final QuadValues values;
+
+        private Quad(PoseStack.Pose pose, BakedQuad quad, QuadInstance values) {
+            this.pose = pose.copy();
+            this.quad = quad;
+            this.values = new QuadValues(values);
+        }
+
+        @Override
+        public void emit(PoseStack.Pose submittedPose, VertexConsumer consumer) {
+            PoseStack.Pose transformed = submittedPose.copy();
+            transformed.mulPose(pose.pose());
+            consumer.putBakedQuad(transformed, quad, values.instance());
+        }
+    }
+
+    /** Records ordinary geometry and retains baked quads without expanding four vertices each. */
+    private static final class Recorder implements VertexConsumer {
+        private static final int COLOR = 1, UV = 2, OVERLAY = 4, LIGHT = 8,
+                EXTRA_UV = 16, NORMAL = 32, LINE_WIDTH = 64;
+        private final List<Draw> draws = new ArrayList<>();
+        private boolean pending;
+        private int attributes, color, overlayU, overlayV, lightU, lightV;
+        private float x, y, z, u, v, extraU, extraV, normalX, normalY, normalZ, lineWidth;
+
+        private void flush() {
+            if (!pending) return;
+            draws.add(new Vertex(x, y, z, attributes, color, u, v, overlayU, overlayV, lightU, lightV,
+                    extraU, extraV, normalX, normalY, normalZ, lineWidth));
+            pending = false;
+        }
+
+        List<Draw> finish() {
+            flush();
+            return List.copyOf(draws);
+        }
+
+        @Override
+        public VertexConsumer addVertex(float x, float y, float z) {
+            flush();
+            this.x = x; this.y = y; this.z = z;
+            attributes = 0;
+            pending = true;
+            return this;
+        }
+
+        @Override
+        public VertexConsumer setColor(int r, int g, int b, int a) {
+            return setColor((a & 255) << 24 | (r & 255) << 16 | (g & 255) << 8 | b & 255);
+        }
+
+        @Override
+        public VertexConsumer setColor(int color) {
+            this.color = color; attributes |= COLOR; return this;
+        }
+
+        @Override
+        public VertexConsumer setUv(float u, float v) {
+            this.u = u; this.v = v; attributes |= UV; return this;
+        }
+
+        @Override
+        public VertexConsumer setUv1(int u, int v) {
+            overlayU = u; overlayV = v; attributes |= OVERLAY; return this;
+        }
+
+        @Override
+        public VertexConsumer setUv2(int u, int v) {
+            lightU = u; lightV = v; attributes |= LIGHT; return this;
+        }
+
+        @Override
+        public VertexConsumer setUv3(float u, float v) {
+            extraU = u; extraV = v; attributes |= EXTRA_UV; return this;
+        }
+
+        @Override
+        public VertexConsumer setNormal(float x, float y, float z) {
+            normalX = x; normalY = y; normalZ = z; attributes |= NORMAL; return this;
+        }
+
+        @Override
+        public VertexConsumer setLineWidth(float width) {
+            lineWidth = width; attributes |= LINE_WIDTH; return this;
+        }
+
+        @Override
+        public void putBakedQuad(PoseStack.Pose pose, BakedQuad quad, QuadInstance instance) {
+            flush();
+            draws.add(new Quad(pose, quad, instance));
+        }
+    }
+}
