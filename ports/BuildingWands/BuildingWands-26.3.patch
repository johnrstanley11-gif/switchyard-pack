+    private static boolean latchNativePress(InputConstants.Key input, int modifiers) {
+        Minecraft client = Minecraft.getInstance();
+        if (client.player == null || !client.getWindow().isFocused()) return false;
+        var screen = client.gui.screen();
+        if (screen != null && !(screen instanceof ModeSelectorScreen)) return false;
+        ItemStack held = client.player.getMainHandItem();
+        boolean wand = !held.isEmpty() && held.getItem() instanceof WandItem;
+        if (!wand && !(held.getItem() instanceof PaletteItem)) return false;
+        boolean claimed = false;
+        for (var entry : keys.entrySet()) {
+            if (!bindingMatches(entry.getKey(), input, modifiers)) continue;
+            WandsMod.WandKeys action = entry.getValue();
+            if (screen instanceof ModeSelectorScreen && !ModeSelectorScreen.consumesKey(action)) continue;
+            if (action == WandsMod.WandKeys.MODE) {
+                if (wand && screen == null) ModeSelectorScreen.onNativeModePress(input);
+            } else {
+                pendingPresses.computeIfAbsent(entry.getKey(), ignored -> new ArrayDeque<>())
+                        .addLast(new BindingPress(input, modifiers));
+            }
+            claimed = true;
+        }
+        return claimed;
+    }
+
+    static BindingPress consumeBindingPress(KeyMapping mapping) {
+        ArrayDeque<BindingPress> presses = pendingPresses.get(mapping);
+        if (presses == null) return null;
+        BindingPress press = presses.pollFirst();
+        if (presses.isEmpty()) pendingPresses.remove(mapping);
+        // A queued press must still correspond to the binding that produced it.
+        return press != null && bindingMatches(mapping, press.input(), press.modifiers()) ? press : null;
+    }
