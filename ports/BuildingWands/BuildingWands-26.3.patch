+    @SubscribeEvent
+    public static void onNativeKey(InputEvent.Key event) {
+        InputConstants.Key input = InputConstants.getKey(event.getKeyEvent());
+        if (event.getAction() == InputConstants.RELEASE) {
+            releaseNativeInput(input);
+        } else if (event.getAction() == InputConstants.PRESS) {
+            // Screen handlers may consume RELEASE before the global event. PRESS is already
+            // distinct from REPEAT, so keyboard taps must not depend on a global release ledger.
+            latchNativePress(input, event.getModifiers());
+        }
+    }
