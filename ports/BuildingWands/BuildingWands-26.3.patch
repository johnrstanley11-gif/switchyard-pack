+            act(helper, player, CENTER, null, Direction.UP);
+            helper.assertValueEqual(count(helper, Blocks.STONE), 0, "vein removes all matching connected blocks");
+            assertState(helper, CENTER.north(), Blocks.DIRT.defaultBlockState(), "vein preserves other block types");
+            clear(helper);
+            BlockState log = Blocks.OAK_LOG.defaultBlockState().setValue(RotatedPillarBlock.AXIS, Direction.Axis.X);
+            helper.setBlock(CENTER, log);
+            helper.setBlock(CENTER.east(), Blocks.DIRT);
+            equip(player, item, WandProps.Mode.COPY, WandProps.Action.PLACE);
