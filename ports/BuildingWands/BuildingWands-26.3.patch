+import net.nicguzzo.wands.wand.WandProps;
+
+/** Server integration tests; no client classes, copied gameplay algorithms or reflective access. */
+public final class WandsPortGameTests {
+    private static final DeferredRegister<Consumer<GameTestHelper>> FUNCTIONS =
+            DeferredRegister.create(Registries.TEST_FUNCTION, WandsMod.MOD_ID);
+    private static final Map<String, Consumer<GameTestHelper>> TESTS = Map.of(
+            "port_all_tiers_survival_placement", WandsPortGameTests::tiers,
+            "port_survival_supply_limit_and_grouped_undo", WandsPortGameTests::supplyAndUndo,
+            "port_registered_tools_transform_blocks", WandsPortGameTests::toolTransforms,
+            "port_small_shape_modes", WandsPortGameTests::shapes,
+            "port_connected_modes_copy_paste_and_blast", WandsPortGameTests::connectedModes,
+            "port_all_bag_menus_and_components", WandsPortGameTests::bags,
+            "port_palette_ghost_menu_and_component_wire", WandsPortGameTests::palette,
+            "port_player_attachment_and_packet", WandsPortGameTests::attachment);
+    private static final BlockPos CENTER = new BlockPos(10, 6, 10);
+
+    private WandsPortGameTests() {}
+
+    /** Called from the NeoForge constructor before registries are populated. */
+    public static void init(IEventBus modBus) {
+        TESTS.forEach((name, test) -> FUNCTIONS.register(name, () -> test));
+        FUNCTIONS.register(modBus);
+        modBus.addListener(WandsPortGameTests::registerTests);
+    }
+
+    private static void registerTests(RegisterGameTestsEvent event) {
+        Holder<TestEnvironmentDefinition<?>> environment = event.registerEnvironment(id("port_tests"));
+        TESTS.forEach((name, test) -> event.registerTest(id(name), new FunctionGameTestInstance(
+                ResourceKey.create(Registries.TEST_FUNCTION, id(name)),
+                new TestData<>(environment, id("port_test_empty"), 160, 0, true))));
+    }
+
+    private static Identifier id(String name) {
+        return Identifier.fromNamespaceAndPath(WandsMod.MOD_ID, name);
+    }
+
+    private static void withPlayer(GameTestHelper helper, GameType type, Consumer<FakePlayer> test) {
+        // NeoForge's real fake player provides a functioning server connection for author packets.
+        FakePlayer player = new FakePlayer(helper.getLevel(), new GameProfile(UUID.randomUUID(), "wands-port-test"));
+        player.setGameMode(type);
+        Vec3 position = helper.absoluteVec(new Vec3(1.5, 1.0, 1.5));
+        player.setPos(position.x, position.y, position.z);
+        player.setYRot(0); // South, making grid/row orientation deterministic.
+        player.experienceLevel = 50;
+        PlayerWand.add_player(player);
+        try {
+            test.accept(player);
+        } finally {
+            PlayerWand.remove_player(player);
+        }
+        helper.succeed();
+    }
+
+    private static ItemStack equip(FakePlayer player, Item item, WandProps.Mode mode, WandProps.Action action) {
+        ItemStack stack = new ItemStack(item);
+        WandProps.setMode(stack, mode);
+        WandProps.forceAction(stack, action);
+        WandProps.setFlag(stack, WandProps.Flag.INCSELBLOCK, true);
+        player.setItemInHand(InteractionHand.MAIN_HAND, stack);
+        return stack;
+    }
+
+    private static ItemStack box(FakePlayer player, Item item, int width, int height, int depth) {
+        ItemStack stack = equip(player, item, WandProps.Mode.BOX, WandProps.Action.PLACE);
+        WandProps.setVal(stack, WandProps.Value.BOX_W, width);
+        WandProps.setVal(stack, WandProps.Value.BOX_H, height);
+        WandProps.setVal(stack, WandProps.Value.BOX_DEPTH, depth);
+        return stack;
+    }
+
+    private static void act(GameTestHelper helper, FakePlayer player, BlockPos start, BlockPos end, Direction side) {
+        BlockPos p1 = helper.absolutePos(start);
+        BlockPos p2 = end == null ? BlockPos.ZERO : helper.absolutePos(end);
+        // This is the same public server handler called by the registered C2S placement payload.
+        Networking.ReceivePosPacket(player, side, true, end != null, p1, p2,
+                new Vec3(p1.getX() + 0.9, p1.getY() + 1.0, p1.getZ() + 0.5), 12345L);
+    }
+
+    private static void clear(GameTestHelper helper) {
+        for (int x = 3; x <= 20; x++) for (int y = 2; y <= 12; y++) for (int z = 3; z <= 20; z++) {
+            BlockPos p = new BlockPos(x, y, z);
+            if (!helper.getBlockState(p).isAir()) helper.setBlock(p, Blocks.AIR);
+        }
+    }
+
+    private static int count(GameTestHelper helper, net.minecraft.world.level.block.Block block) {
+        int total = 0;
+        for (int x = 3; x <= 20; x++) for (int y = 2; y <= 12; y++) for (int z = 3; z <= 20; z++) {
+            if (helper.getBlockState(new BlockPos(x, y, z)).is(block)) total++;
+        }
+        return total;
+    }
+
+    private static void assertState(GameTestHelper helper, BlockPos pos, BlockState state, String detail) {
+        helper.assertValueEqual(helper.getBlockState(pos), state, detail);
+    }
+
+    private static void assertStack(GameTestHelper helper, ItemStack actual, ItemStack expected, String detail) {
+        helper.assertTrue(ItemStack.isSameItemSameComponents(actual, expected), detail + " item/components");
+        helper.assertValueEqual(actual.getCount(), expected.getCount(), detail + " count");
+    }
+
+    public static void tiers(GameTestHelper helper) {
+        List<Supplier<WandItem>> items = List.of(NeoforgeEntrypoint.WOODEN_WAND_ITEM,
+                NeoforgeEntrypoint.STONE_WAND_ITEM, NeoforgeEntrypoint.COPPER_WAND_ITEM,
+                NeoforgeEntrypoint.IRON_WAND_ITEM, NeoforgeEntrypoint.GOLD_WAND_ITEM,
+                NeoforgeEntrypoint.DIAMOND_WAND_ITEM, NeoforgeEntrypoint.NETHERITE_WAND_ITEM,
+                NeoforgeEntrypoint.CREATIVE_WAND_ITEM);
+        withPlayer(helper, GameType.SURVIVAL, player -> {
+            for (int i = 0; i < items.size(); i++) {
+                WandItem item = items.get(i).get();
+                ItemStack wand = box(player, item, 1, 1, 1);
+                player.setItemInHand(InteractionHand.OFF_HAND, new ItemStack(Items.OAK_PLANKS, 4));
+                BlockPos target = new BlockPos(4 + i * 2, 3, 5);
+                act(helper, player, target, null, Direction.UP);
+                assertState(helper, target, Blocks.OAK_PLANKS.defaultBlockState(), item.tier + " placement");
+                helper.assertValueEqual(player.getOffhandItem().getCount(), 3, item.tier + " survival debit");
+                helper.assertValueEqual(wand.getDamageValue(), item.unbreakable ? 0 : 1, item.tier + " durability");
+            }
+        });
+    }
+
+    public static void supplyAndUndo(GameTestHelper helper) {
+        withPlayer(helper, GameType.SURVIVAL, player -> {
+            box(player, NeoforgeEntrypoint.WOODEN_WAND_ITEM.get(), 3, 1, 1);
+            player.setItemInHand(InteractionHand.OFF_HAND, new ItemStack(Items.OAK_PLANKS, 2));
+            act(helper, player, CENTER, null, Direction.UP);
+            helper.assertValueEqual(count(helper, Blocks.OAK_PLANKS), 2, "two supplied blocks place exactly twice");
+            helper.assertTrue(player.getOffhandItem().isEmpty(), "supply consumed without negative count");
+            player.setGameMode(GameType.CREATIVE);
+            WandsMod.process_keys(player, WandsMod.WandKeys.UNDO.ordinal(), false, false);
+            helper.assertValueEqual(count(helper, Blocks.OAK_PLANKS), 2, "author survival placement has no undo history");
+            clear(helper);
+            box(player, NeoforgeEntrypoint.WOODEN_WAND_ITEM.get(), 2, 1, 1);
+            player.setItemInHand(InteractionHand.OFF_HAND, new ItemStack(Items.OAK_PLANKS));
+            act(helper, player, CENTER, null, Direction.UP);
+            helper.assertValueEqual(count(helper, Blocks.OAK_PLANKS), 2, "creative action places both blocks");
+            WandsMod.process_keys(player, WandsMod.WandKeys.UNDO.ordinal(), false, false);
+            helper.assertValueEqual(count(helper, Blocks.OAK_PLANKS), 0, "one undo clears the whole action");
+            WandsMod.process_keys(player, WandsMod.WandKeys.UNDO.ordinal(), true, false);
+            helper.assertValueEqual(count(helper, Blocks.OAK_PLANKS), 2, "redo restores both blocks");
+            helper.assertValueEqual(player.getOffhandItem().getCount(), 1, "creative place/undo/redo preserves supply");
+            clear(helper);
+            player.setGameMode(GameType.SURVIVAL);
+            box(player, NeoforgeEntrypoint.WOODEN_WAND_ITEM.get(), 6, 1, 6);
+            player.setItemInHand(InteractionHand.OFF_HAND, new ItemStack(Items.OAK_PLANKS, 64));
+            act(helper, player, new BlockPos(8, 4, 8), null, Direction.UP);
+            helper.assertValueEqual(count(helper, Blocks.OAK_PLANKS), WandsMod.config.wooden_wand_limit,
+                    "36-block request respects the configured wooden limit");
+            helper.assertValueEqual(player.getOffhandItem().getCount(), 64 - WandsMod.config.wooden_wand_limit,
+                    "only actually placed blocks are charged");
+        });
+    }
+
+    public static void toolTransforms(GameTestHelper helper) {
+        record Transform(Item tool, BlockState from, BlockState to) {}
+        List<Transform> cases = List.of(
+                new Transform(Items.NETHERITE_AXE, Blocks.OAK_LOG.defaultBlockState().setValue(RotatedPillarBlock.AXIS, Direction.Axis.X),
+                        Blocks.STRIPPED_OAK_LOG.defaultBlockState().setValue(RotatedPillarBlock.AXIS, Direction.Axis.X)),
+                new Transform(Items.NETHERITE_AXE, Blocks.COPPER_BLOCK.waxed().unaffected().defaultBlockState(),
+                        Blocks.COPPER_BLOCK.weathering().unaffected().defaultBlockState()),
+                new Transform(Items.NETHERITE_AXE, Blocks.COPPER_BLOCK.weathering().oxidized().defaultBlockState(),
+                        Blocks.COPPER_BLOCK.weathering().weathered().defaultBlockState()),
+                new Transform(Items.NETHERITE_HOE, Blocks.DIRT.defaultBlockState(), Blocks.FARMLAND.defaultBlockState()),
+                new Transform(Items.NETHERITE_SHOVEL, Blocks.GRASS_BLOCK.defaultBlockState(), Blocks.DIRT_PATH.defaultBlockState()));
+        withPlayer(helper, GameType.SURVIVAL, player -> {
+            for (int i = 0; i < cases.size(); i++) {
+                Transform c = cases.get(i);
+                player.getInventory().setItem(1, new ItemStack(c.tool));
+                ItemStack stack = box(player, NeoforgeEntrypoint.DIAMOND_WAND_ITEM.get(), 1, 1, 1);
+                WandProps.forceAction(stack, WandProps.Action.USE);
+                if (i == 0) {
+                    new WandToolsMenu(1, player.getInventory(), stack).clicked(1, 0, ContainerInput.PICKUP, player);
+                    int[] selected = NeoforgeEntrypoint.getPlayerData(player).getIntArray("Tools").orElseThrow();
+                    helper.assertValueEqual(selected.length, 1, "tools menu selects one inventory tool");
+                    helper.assertValueEqual(selected[0], 1, "tools menu persists author inventory slot1");
+                }
+                BlockPos target = new BlockPos(5 + i * 2, 3, 6);
+                helper.setBlock(target.below(), Blocks.STONE);
+                helper.setBlock(target, c.from);
+                act(helper, player, target, null, Direction.UP);
+                assertState(helper, target, c.to, "registered " + c.tool + " transformation");
+                helper.assertTrue(player.getInventory().getItem(1).getDamageValue() > 0, "real useOn damages tool");
+            }
+            // The same per-player Wand must choose a fresh synthesized tool as the target changes.
+            // No real tools remain, so a cached previous shovel/axe cannot accidentally make this pass.
+            player.getInventory().setItem(1, ItemStack.EMPTY);
+            player.setGameMode(GameType.CREATIVE);
+            for (int index : new int[]{0, 3, 4}) {
+                // Dirt supports both hoe and shovel, and the author prefers shovel in creative.
+                // An existing dirt path is an unambiguous hoe target; preserve that priority.
+                Transform c = index == 3
+                        ? new Transform(Items.NETHERITE_HOE, Blocks.DIRT_PATH.defaultBlockState(), Blocks.FARMLAND.defaultBlockState())
+                        : cases.get(index);
+                ItemStack stack = box(player, NeoforgeEntrypoint.CREATIVE_WAND_ITEM.get(), 1, 1, 1);
+                WandProps.forceAction(stack, WandProps.Action.USE);
+                BlockPos target = new BlockPos(5 + index * 2, 5, 8);
+                helper.setBlock(target.below(), Blocks.STONE);
+                helper.setBlock(target, c.from);
+                act(helper, player, target, null, Direction.UP);
+                assertState(helper, target, c.to, "creative mixed USE picks the current block's tool");
+                helper.assertTrue(player.getInventory().getItem(1).isEmpty(), "synthesized tool is not inserted into player inventory");
+            }
+        });
+    }
+
+    public static void shapes(GameTestHelper helper) {
+        withPlayer(helper, GameType.CREATIVE, player -> {
+            player.setItemInHand(InteractionHand.OFF_HAND, new ItemStack(Items.OAK_PLANKS));
+            Item item = NeoforgeEntrypoint.CREATIVE_WAND_ITEM.get();
+            equip(player, item, WandProps.Mode.FILL, WandProps.Action.PLACE);
+            act(helper, player, CENTER, CENTER.offset(2, 0, 1), Direction.UP);
