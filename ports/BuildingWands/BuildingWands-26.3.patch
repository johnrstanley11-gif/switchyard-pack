+// Modified 2026-10-11 for the selected private Minecraft 26.3 NeoForge target (Apache-2.0).
+// Changed for the private Minecraft 26.3 NeoForge port, 11 October 2026 (Apache-2.0).
+// New client-only NeoForge extraction and geometry-submission event handlers.
+package net.nicguzzo.wands.client.render;
+
+import net.minecraft.resources.Identifier;
+import net.minecraft.util.context.ContextKey;
+import net.neoforged.api.distmarker.Dist;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.client.event.ExtractLevelRenderStateEvent;
+import net.neoforged.neoforge.client.event.SubmitCustomGeometryEvent;
+import net.nicguzzo.wands.WandsMod;
+
+/** NeoForge's extraction and submission stages replace the old level-render TAIL injection. */
+@EventBusSubscriber(modid = WandsMod.MOD_ID, value = Dist.CLIENT)
+public final class PreviewRenderEvents {
+    private static final ContextKey<PreviewRenderState> PREVIEW = new ContextKey<>(
+            Identifier.fromNamespaceAndPath(WandsMod.MOD_ID, "wand_preview"));
+
+    private PreviewRenderEvents() { }
+
+    @SubscribeEvent
+    public static void extract(ExtractLevelRenderStateEvent event) {
+        PreviewRenderState.Builder builder = new PreviewRenderState.Builder();
+        ClientRender.extract(builder, event.getRenderState().cameraRenderState.pos,
+                event.getCamera().isInitialized(), event.getDeltaTracker().getGameTimeDeltaPartialTick(false));
+        // Store an empty snapshot as well, so unequipping the wand cannot leave an old preview.
+        event.getRenderState().setRenderData(PREVIEW, builder.build());
+    }
+
+    @SubscribeEvent
+    public static void submit(SubmitCustomGeometryEvent event) {
+        PreviewRenderState preview = event.getLevelRenderState().getRenderData(PREVIEW);
+        if (preview != null) preview.submit(event.getPoseStack(), event.getSubmitNodeCollector());
+    }
+}
diff --git a/src/main/java/net/nicguzzo/wands/client/render/PreviewRenderState.java b/src/main/java/net/nicguzzo/wands/client/render/PreviewRenderState.java
new file mode 100644
