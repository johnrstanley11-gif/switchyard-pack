+            act(helper, player, CENTER, null, Direction.UP);
+            assertState(helper, CENTER.east(), Blocks.OAK_PLANKS.defaultBlockState(), "direction follows selected face edge");
+            clear(helper);
+            for (int dx = -1; dx <= 1; dx++) helper.setBlock(CENTER.offset(dx, 0, 0), Blocks.STONE);
+            equip(player, item, WandProps.Mode.ROW_COL, WandProps.Action.PLACE);
+            act(helper, player, CENTER, null, Direction.UP);
+            helper.assertValueEqual(count(helper, Blocks.OAK_PLANKS), 3, "row follows three matching source blocks");
+            clear(helper);
+            for (int dx = -1; dx <= 1; dx++) helper.setBlock(CENTER.offset(dx, 0, 0), Blocks.STONE);
+            equip(player, item, WandProps.Mode.AREA, WandProps.Action.PLACE);
+            act(helper, player, CENTER, null, Direction.UP);
+            helper.assertValueEqual(count(helper, Blocks.OAK_PLANKS), 3, "area follows matching contiguous face");
+            clear(helper);
+            player.setItemInHand(InteractionHand.OFF_HAND, ItemStack.EMPTY);
+            for (int dx = -1; dx <= 1; dx++) helper.setBlock(CENTER.offset(dx, 0, 0), Blocks.STONE);
+            helper.setBlock(CENTER.north(), Blocks.DIRT);
