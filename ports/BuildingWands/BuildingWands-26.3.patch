+    public static void palette(GameTestHelper helper) {
+        withPlayer(helper, GameType.SURVIVAL, player -> {
+            ItemStack palette = new ItemStack(NeoforgeEntrypoint.PALETTE_ITEM.get());
+            player.setItemInHand(InteractionHand.MAIN_HAND, palette);
+            ItemStack cargo = new ItemStack(Items.OAK_PLANKS, 16);
+            cargo.set(DataComponents.CUSTOM_NAME, Component.literal("Named palette sample"));
+            player.getInventory().setItem(9, cargo.copy());
+            PaletteMenu menu = new PaletteMenu(1, player.getInventory(), palette);
+            int source = -1;
+            for (int i = 54; i < menu.slots.size(); i++) {
+                if (menu.slots.get(i).container == player.getInventory() && menu.slots.get(i).getContainerSlot() == 9) source = i;
+            }
+            helper.assertTrue(source >= 54, "actual menu includes player inventory slot9");
+            menu.clicked(source, 0, ContainerInput.QUICK_MOVE, player);
+            assertStack(helper, player.getInventory().getItem(9), cargo, "ghost sampling preserves original inventory");
+            ItemStack sample = cargo.copyWithCount(1);
+            assertStack(helper, PaletteItem.getInventory(palette, helper.getLevel()).getItem(0), sample, "sample preserves components/count1");
+            PaletteItem.setMode(palette, PaletteItem.PaletteMode.GRADIENT);
+            PaletteItem.setGradientHeight(palette, 7);
+            PaletteItem.toggleRotate(palette);
+            SimpleContainer stored = PaletteItem.getInventory(palette, helper.getLevel());
+            stored.setItem(53, sample.copy());
+            PaletteItem.setInventory(palette, stored, helper.getLevel());
+            ItemStack saved = Compat.ItemStack_read(Compat.ItemStack_save(palette, helper.getLevel()), helper.getLevel()).orElseThrow();
+            assertStack(helper, saved, palette, "palette whole-item NBT roundtrip");
+            assertStack(helper, PaletteItem.getInventory(saved, helper.getLevel()).getItem(53), sample, "last palette slot persists");
+            assertStack(helper, roundtrip(helper, Networking.WandPacket.STREAM_CODEC, new Networking.WandPacket(palette)).item_stack(), palette,
+                    "palette packet retains samples/mode/rotation/gradient");
+            RegistryFriendlyByteBuf buf = menuBuffer(helper, palette);
+            try {
+                assertStack(helper, new PaletteMenu(2, player.getInventory(), buf).palette, palette, "actual palette menu NBT wire");
+            } finally { buf.release(); }
+            ItemStack wand = new ItemStack(NeoforgeEntrypoint.DIAMOND_WAND_ITEM.get());
+            wand.enchant(helper.getLevel().registryAccess().lookupOrThrow(Registries.ENCHANTMENT).getOrThrow(Enchantments.UNBREAKING), 3);
+            WandProps.setMode(wand, WandProps.Mode.GRID);
+            WandProps.setVal(wand, WandProps.Value.GRIDM, 3);
+            buf = menuBuffer(helper, wand);
+            try {
+                assertStack(helper, new WandToolsMenu(3, player.getInventory(), buf).wand, wand,
+                        "enchanted wand actual menu NBT resolves registry holders");
+            } finally { buf.release(); }
+            assertStack(helper, roundtrip(helper, Networking.WandPacket.STREAM_CODEC, new Networking.WandPacket(wand)).item_stack(), wand,
+                    "enchanted wand packet");
+        });
+    }
+
+    public static void attachment(GameTestHelper helper) {
+        withPlayer(helper, GameType.SURVIVAL, player -> {
+            CompoundTag data = NeoforgeEntrypoint.getPlayerData(player);
+            data.putBoolean("drop_pos", false);
+            data.putInt("port_marker", 123456);
+            helper.assertTrue(PlayerWand.get(player).player_data == data, "player wand edits actual attachment tag");
+            TagValueOutput output = TagValueOutput.createWithContext(new ProblemReporter.Collector(), helper.getLevel().registryAccess());
+            player.serializeAttachments(output);
+            CompoundTag serialized = output.buildResult();
+            AttachmentHolder.AsField loaded = new AttachmentHolder.AsField(player);
+            loaded.deserializeInternal(helper.getLevel().registryAccess(),
+                    TagValueInput.create(new ProblemReporter.Collector(), helper.getLevel().registryAccess(), serialized));
+            helper.assertValueEqual(loaded.getData(NeoforgeEntrypoint.PLAYER_DATA), data, "real attachment serializer roundtrip");
+            helper.assertValueEqual(roundtrip(helper, Networking.PlayerDataPacket.STREAM_CODEC,
+                    new Networking.PlayerDataPacket(data)).tag(), data, "login player-data custom packet");
+            PlayerWand.remove_player(player);
+            PlayerWand.add_player(player);
+            helper.assertValueEqual(PlayerWand.get(player).player_data, data, "new wand session reads stored player attachment");
+        });
+    }
+
+    private static RegistryFriendlyByteBuf menuBuffer(GameTestHelper helper, ItemStack stack) {
+        RegistryFriendlyByteBuf buf = new RegistryFriendlyByteBuf(Unpooled.buffer(), helper.getLevel().registryAccess());
+        // Preserve author server-menu schema: ItemStack map embedded in a bare NBT compound.
+        buf.writeNbt(Compat.ItemStack_save(stack, helper.getLevel()));
+        return buf;
+    }
+
+    private static <T> T roundtrip(GameTestHelper helper, StreamCodec<RegistryFriendlyByteBuf, T> codec, T value) {
+        RegistryFriendlyByteBuf buf = new RegistryFriendlyByteBuf(Unpooled.buffer(), helper.getLevel().registryAccess());
+        try {
+            codec.encode(buf, value);
+            T decoded = codec.decode(buf);
+            helper.assertValueEqual(buf.readableBytes(), 0, "packet consumes exact encoded bytes");
+            return decoded;
+        } finally { buf.release(); }
+    }
+}
+//? }
