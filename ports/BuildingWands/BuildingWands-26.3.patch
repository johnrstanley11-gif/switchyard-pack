+    public static void bags(GameTestHelper helper) {
+        List<Supplier<MagicBagItem>> items = List.of(NeoforgeEntrypoint.MAGIC_BAG_TIER1_ITEM,
+                NeoforgeEntrypoint.MAGIC_BAG_TIER2_ITEM, NeoforgeEntrypoint.MAGIC_BAG_TIER3_ITEM);
+        withPlayer(helper, GameType.SURVIVAL, player -> {
+            for (Supplier<MagicBagItem> item : items) {
+                ItemStack bag = new ItemStack(item.get());
+                ItemStack cargo = new ItemStack(Items.OAK_PLANKS, 64);
+                cargo.set(DataComponents.CUSTOM_NAME, Component.literal("Component cargo"));
+                MagicBagMenu menu = new MagicBagMenu(1, player.getInventory(), bag);
+                menu.setCarried(cargo.copy());
+                menu.clicked(36, 0, ContainerInput.PICKUP, player);
+                menu.setCarried(cargo.copy());
+                menu.clicked(36, 0, ContainerInput.PICKUP, player);
+                helper.assertValueEqual(MagicBagItem.getTotal(bag), 128, "two stacks deposited into " + item.get().tier);
+                helper.assertTrue(menu.getCarried().isEmpty(), "bag accepts matching component-bearing cargo");
+                ItemStack stored = cargo.copyWithCount(1);
+                assertStack(helper, MagicBagItem.getItem(bag, helper.getLevel()), stored, "representative preserves components");
+                ItemStack saved = Compat.ItemStack_read(Compat.ItemStack_save(bag, helper.getLevel()), helper.getLevel()).orElseThrow();
+                assertStack(helper, saved, bag, "bag registry NBT save/load");
+                ItemStack packet = roundtrip(helper, Networking.WandPacket.STREAM_CODEC, new Networking.WandPacket(bag)).item_stack();
+                assertStack(helper, packet, bag, "bag item component wire with total128");
+                RegistryFriendlyByteBuf buf = menuBuffer(helper, bag);
+                try {
+                    assertStack(helper, new MagicBagMenu(2, player.getInventory(), buf).bag, bag, "actual bag menu NBT wire");
+                } finally { buf.release(); }
+                menu.clicked(36, 1, ContainerInput.PICKUP, player);
+                assertStack(helper, menu.getCarried(), cargo, "right-click withdraws one full component-bearing stack");
+                helper.assertValueEqual(MagicBagItem.getTotal(bag), 64, "withdraw charges64 from aggregate128");
+                menu.setCarried(new ItemStack(Items.OAK_PLANKS, 8));
+                menu.clicked(36, 0, ContainerInput.PICKUP, player);
+                helper.assertValueEqual(MagicBagItem.getTotal(bag), 64, "PICKUP rejects differing components");
+                helper.assertValueEqual(menu.getCarried().getCount(), 8, "rejected cargo remains carried");
+                clear(helper);
+                box(player, NeoforgeEntrypoint.DIAMOND_WAND_ITEM.get(), 3, 1, 1);
+                player.setItemInHand(InteractionHand.OFF_HAND, bag);
+                act(helper, player, CENTER, null, Direction.UP);
+                helper.assertValueEqual(count(helper, Blocks.OAK_PLANKS), 3, "wand consumes blocks from bag");
+                helper.assertValueEqual(MagicBagItem.getTotal(bag), 61, "only placed blocks debit the bag aggregate");
+            }
+        });
+    }
