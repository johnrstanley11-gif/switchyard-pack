+    static boolean bindingMatches(KeyMapping mapping, InputConstants.Key input, int modifiers) {
+        if (mapping == null || !mapping.matches(input)) return false;
+        return switch (mapping.getKeyModifier()) {
+            case NONE -> true; // Shift/Alt remain wand action modifiers for ordinary bindings.
+            case SHIFT -> (modifiers & InputConstants.MOD_SHIFT) != 0;
+            case ALT -> (modifiers & InputConstants.MOD_ALT) != 0;
+            case CONTROL -> (modifiers & InputConstants.MOD_CONTROL) != 0;
+            case CONTROL_OR_COMMAND -> (modifiers & InputQuirks.EDIT_SHORTCUT_KEY_MODIFIER) != 0;
+        };
+    }
