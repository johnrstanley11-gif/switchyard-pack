+
+@EventBusSubscriber(modid = WandsMod.MOD_ID, value = Dist.CLIENT)
+public final class NeoforgeClientRegistration {
+    private NeoforgeClientRegistration() {}
+
+    @SubscribeEvent
+    public static void registerScreens(RegisterMenuScreensEvent event) {
+        event.register(NeoforgeEntrypoint.WAND_TOOLS_MENU_TYPE.get(), WandToolScreen::new);
+        event.register(NeoforgeEntrypoint.MAGIC_BAG_MENU_TYPE.get(), MagicBagScreen::new);
+        event.register(NeoforgeEntrypoint.PALETTE_MENU_TYPE.get(), PaletteScreen::new);
+    }
+
+    @SubscribeEvent
+    public static void setup(FMLClientSetupEvent event) {
+        event.enqueueWork(WandsModClient::initialize);
+    }
+
+    @SubscribeEvent
+    public static void tick(ClientTickEvent.Post event) {
+        WandsModClient.client_tick(Minecraft.getInstance());
+    }
+
+    @SubscribeEvent
+    public static void hud(RenderGuiEvent.Post event) {
+        WandsModClient.render_hud(event.getGuiGraphics());
+    }
+}
