+    }
+
+    private static void registerTest(RegisterGameTestsEvent event, Holder<TestEnvironmentDefinition<?>> environment,
+            DeferredHolder<Consumer<GameTestHelper>, Consumer<GameTestHelper>> function, String structure, int ticks, boolean skyAccess) {
+        event.registerTest(function.getId(), new FunctionGameTestInstance(function.getKey(), new TestData<>(
+                environment, Level.OVERWORLD, id(structure), ticks, 0, true, Rotation.NONE,
+                false, 1, 1, skyAccess, 0)));
+    }
+
+    public static void movementAcrossChunk(GameTestHelper helper) {
+        // Compute the boundary from the real test origin; the runner can place the template anywhere.
+        int sourceX = 15 - Math.floorMod(helper.absolutePos(BlockPos.ZERO).getX(), 16);
+        BlockPos stone = new BlockPos(sourceX, 3, 2);
+        BlockPos chest = new BlockPos(sourceX, 4, 4);
+        BlockPos lamp = new BlockPos(sourceX, 7, 6);
+        BlockPos absoluteLamp = helper.absolutePos(lamp);
+        int oldSurface = helper.getLevel().getHeight(Heightmap.Types.WORLD_SURFACE, absoluteLamp.getX(), absoluteLamp.getZ());
+        int oldBlocking = helper.getLevel().getHeight(Heightmap.Types.MOTION_BLOCKING, absoluteLamp.getX(), absoluteLamp.getZ());
+
+        helper.setBlock(stone, Blocks.STONE);
+        helper.setBlock(chest, Blocks.CHEST);
+        helper.setBlock(lamp, Blocks.GLOWSTONE);
+        ChestBlockEntity originalChest = helper.getBlockEntity(chest, ChestBlockEntity.class);
+        ItemStack diamonds = named(new ItemStack(Items.DIAMOND, 7), "Frame cargo");
+        ItemStack pickaxe = named(new ItemStack(Items.IRON_PICKAXE), "Moved tool");
+        pickaxe.setDamageValue(9);
+        originalChest.setItem(0, diamonds.copy());
+        originalChest.setItem(26, pickaxe.copy());
+
+        // GameTestServer advances ticks without the normal 50 ms task wait. Initialize
+        // fixture lighting through vanilla's public APIs, then fence its worker tasks.
+        var chunkSource = helper.getLevel().getChunkSource();
+        var lightEngine = chunkSource.getLightEngine();
+        var sourceChunk = helper.getLevel().getChunkAt(absoluteLamp);
+        var targetChunk = helper.getLevel().getChunkAt(absoluteLamp.east());
+        CompletableFuture<Void> initialLighting = CompletableFuture.allOf(
+                lightEngine.initializeLight(sourceChunk, true), lightEngine.initializeLight(targetChunk, true))
+                .thenCompose(ignored -> CompletableFuture.allOf(
+                        lightEngine.lightChunk(sourceChunk, false), lightEngine.lightChunk(targetChunk, false)));
+
+        MovementDescriptor[] movement = new MovementDescriptor[1];
+        CompletableFuture<?>[] movementLighting = new CompletableFuture<?>[1];
+        helper.startSequence()
+                .thenWaitUntil(() -> {
+                    chunkSource.pollTask();
+                    helper.assertTrue(initialLighting.isDone(), "Fixture lighting initialization finishes");
+                    initialLighting.join();
+                    helper.assertValueEqual(helper.getLevel().getBrightness(LightLayer.BLOCK, absoluteLamp), 15, "Initial glowstone light");
+                })
+                .thenExecute(() -> {
+                    Set<BlockPos> positions = Set.of(helper.absolutePos(stone), helper.absolutePos(chest), absoluteLamp);
+                    helper.assertTrue((absoluteLamp.getX() >> 4) != (absoluteLamp.east().getX() >> 4), "Movement must cross a real chunk boundary");
+                    movement[0] = MovementManager.getInstance(helper.getLevel()).beginMove(helper.getLevel(), positions, Direction.EAST.ordinal(), 0.25);
+                    helper.assertValueEqual(movement[0].getStatus(), MovementDescriptor.MovementStatus.MOVING, "Movement starts");
+                    // The descriptor counts each row's occupied block plus its destination headspace.
+                    helper.assertValueEqual(movement[0].getSize(), 6, "Three moving rows including destination headspace");
+                })
+                .thenWaitUntil(() -> helper.assertTrue(movement[0].getProgress() > 0, "Movement reaches a translated shape"))
+                .thenExecute(() -> assertMovingCollisionAndRayTrace(helper, helper.absolutePos(stone), absoluteLamp, movement[0]))
+                .thenWaitUntil(() -> helper.assertValueEqual(movement[0].getStatus(), MovementDescriptor.MovementStatus.FINISHED, "Movement finishes through level ticks"))
+                .thenExecute(() -> {
+                    helper.assertBlockPresent(Blocks.AIR, stone);
+                    helper.assertBlockPresent(Blocks.AIR, chest);
+                    helper.assertBlockPresent(Blocks.AIR, lamp);
+                    helper.assertBlockPresent(Blocks.STONE, stone.east());
+                    helper.assertBlockPresent(Blocks.CHEST, chest.east());
+                    helper.assertBlockPresent(Blocks.GLOWSTONE, lamp.east());
+                    ChestBlockEntity movedChest = helper.getBlockEntity(chest.east(), ChestBlockEntity.class);
+                    helper.assertTrue(movedChest != originalChest, "Chest is reconstructed at its destination");
+                    helper.assertValueEqual(movedChest.getBlockPos(), helper.absolutePos(chest.east()), "Moved block entity position");
+                    helper.assertTrue(ItemStack.matches(movedChest.getItem(0), diamonds), "Chest retains named diamonds and count");
+                    helper.assertTrue(ItemStack.matches(movedChest.getItem(26), pickaxe), "Chest retains named tool and damage");
+                    helper.assertTrue(helper.getLevel().getBlockEntity(helper.absolutePos(chest)) == null, "Source chest block entity is removed");
+                    helper.assertValueEqual(helper.getLevel().getHeight(Heightmap.Types.WORLD_SURFACE, absoluteLamp.getX(), absoluteLamp.getZ()), oldSurface, "Source surface height is restored");
+                    helper.assertValueEqual(helper.getLevel().getHeight(Heightmap.Types.MOTION_BLOCKING, absoluteLamp.getX(), absoluteLamp.getZ()), oldBlocking, "Source blocking height is restored");
+                    helper.assertValueEqual(helper.getLevel().getHeight(Heightmap.Types.WORLD_SURFACE, absoluteLamp.getX() + 1, absoluteLamp.getZ()), absoluteLamp.getY() + 1, "Destination surface height follows moved block");
+                    helper.assertValueEqual(helper.getLevel().getHeight(Heightmap.Types.MOTION_BLOCKING, absoluteLamp.getX() + 1, absoluteLamp.getZ()), absoluteLamp.getY() + 1, "Destination blocking height follows moved block");
+                    movementLighting[0] = CompletableFuture.allOf(
+                            lightEngine.waitForPendingTasks(sourceChunk.getPos().x(), sourceChunk.getPos().z()),
+                            lightEngine.waitForPendingTasks(targetChunk.getPos().x(), targetChunk.getPos().z()));
+                })
+                .thenWaitUntil(() -> {
+                    // Only drain the production move's existing updates; never relight here.
+                    chunkSource.pollTask();
+                    helper.assertTrue(movementLighting[0].isDone(), "Movement lighting tasks finish");
+                    movementLighting[0].join();
+                    helper.assertValueEqual(helper.getLevel().getBrightness(LightLayer.BLOCK, absoluteLamp.east()), 15, "Moved glowstone lights its destination");
+                    helper.assertValueEqual(helper.getLevel().getBrightness(LightLayer.BLOCK, absoluteLamp), 14, "Source light is recalculated after movement");
+                })
+                .thenSucceed();
+    }
+
+    private static void assertMovingCollisionAndRayTrace(GameTestHelper helper, BlockPos stone, BlockPos lamp,
+            MovementDescriptor movement) {
+        double progress = movement.getProgress();
+        helper.assertValueEqual(movement.getStatus(), MovementDescriptor.MovementStatus.MOVING, "Collision is checked during movement");
+        helper.assertTrue(progress > 0 && progress < 1, "Collision uses an intermediate movement offset");
+        double x = stone.getX();
+        double y = stone.getY();
+        double z = stone.getZ();
+
+        // The destination is still air in storage, but the moving stone occupies its overhang.
+        helper.assertTrue(helper.getLevel().getBlockState(stone.east()).isAir(), "Moving geometry precedes destination placement");
+        AABB overhang = new AABB(x + 1 + progress * 0.25, y + 0.2, z + 0.2,
+                x + 1 + progress * 0.75, y + 0.8, z + 0.8);
+        boolean collided = false;
+        for (VoxelShape shape : helper.getLevel().getBlockCollisions(null, overhang)) {
+            collided = true;
+            AABB bounds = shape.bounds();
+            assertNear(helper, bounds.minX, x + progress, "Collision minimum follows movement");
+            assertNear(helper, bounds.maxX, x + 1 + progress, "Collision maximum follows movement");
+        }
+        helper.assertTrue(collided, "Real block collision query detects the translated overhang");
+        AABB vacated = new AABB(x + progress * 0.25, y + 0.2, z + 0.2,
+                x + progress * 0.75, y + 0.8, z + 0.8);
+        helper.assertTrue(!helper.getLevel().getBlockCollisions(null, vacated).iterator().hasNext(),
+                "Real block collision query clears the vacated source volume");
+
+        // Enter through the destination cell: hit coordinates move, the address stays the source.
+        BlockHitResult eastHit = clip(helper, new Vec3(x + 2, y + 0.5, z + 0.5), new Vec3(x - 0.5, y + 0.5, z + 0.5));
+        helper.assertValueEqual(eastHit.getType(), HitResult.Type.BLOCK, "Moving stone can be ray traced");
+        helper.assertValueEqual(eastHit.getBlockPos(), stone, "Ray hit returns the original moving block address");
+        helper.assertValueEqual(eastHit.getDirection(), Direction.EAST, "Moving ray hit retains its face");
+        assertNear(helper, eastHit.getLocation().x, x + 1 + progress, "Ray hit follows the translated east face");
+
+        // This line crosses both moving stone and glowstone. Reversing it must select the nearer one.
+        Vec3 nearStone = new Vec3(x + 0.5 + progress, y - 1.5, z - 1.5);
+        // Keep both endpoints inside the 18 x 10 x 8 fixture, away from its barrier casing.
+        Vec3 beyondLamp = new Vec3(x + 0.5 + progress, lamp.getY() + 1.5, lamp.getZ() + 1.5);
+        BlockHitResult forward = clip(helper, nearStone, beyondLamp);
+        BlockHitResult backward = clip(helper, beyondLamp, nearStone);
