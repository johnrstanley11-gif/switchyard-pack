+    public static void batteryBoxTransfer(GameTestHelper helper) {
+        BlockPos pos = new BlockPos(2, 1, 2);
+        helper.setBlock(pos, ExpansionBlocks.BATTERY_BOX_BLOCK.get());
+        BatteryBoxBlockEntity box = helper.getBlockEntity(pos, BatteryBoxBlockEntity.class);
+        ResourceHandler<ItemResource> top = capability(helper, pos, Direction.UP);
+        ResourceHandler<ItemResource> bottom = capability(helper, pos, Direction.DOWN);
+        helper.assertValueEqual(top.size(), 1, "Battery top exposes one slot");
+        helper.assertValueEqual(bottom.size(), 1, "Battery bottom exposes one slot");
+        ItemStack battery = named(new ItemStack(ExpansionItems.BATTERY_ITEM.get()), "Transactional battery");
+        battery.setDamageValue(100);
+        ItemResource resource = ItemResource.of(battery);
+        assertTransactionalTransfer(helper, top, bottom, box.getInventory(), 0, 0, 1, resource, battery);
+        try (Transaction transaction = Transaction.openRoot()) {
+            helper.assertValueEqual(top.insert(ItemResource.of(ExpansionItems.ELECTRIC_SCREWDRIVER_ITEM.get()), 1, transaction), 0, "Battery box rejects non-battery chargeable tools");
+            transaction.commit();
+        }
+        helper.succeed();
+    }
+
+    public static void chargingBenchTransfer(GameTestHelper helper) {
+        BlockPos pos = new BlockPos(2, 1, 2);
+        helper.setBlock(pos, ExpansionBlocks.CHARGING_BENCH_BLOCK.get());
+        ChargingBenchBlockEntity bench = helper.getBlockEntity(pos, ChargingBenchBlockEntity.class);
+        ResourceHandler<ItemResource> top = capability(helper, pos, Direction.UP);
+        ResourceHandler<ItemResource> bottom = capability(helper, pos, Direction.DOWN);
+        helper.assertValueEqual(top.size(), 8, "Charging top exposes eight slots");
+        helper.assertValueEqual(bottom.size(), 8, "Charging bottom exposes eight slots");
+        ItemStack tool = named(new ItemStack(ExpansionItems.ELECTRIC_SCREWDRIVER_ITEM.get()), "Transactional screwdriver");
+        tool.setDamageValue(50);
+        assertTransactionalTransfer(helper, top, bottom, bench.getInventory(), 7, 7, 15, ItemResource.of(tool), tool);
+        try (Transaction transaction = Transaction.openRoot()) {
+            helper.assertValueEqual(top.insert(ItemResource.of(Items.STONE), 1, transaction), 0, "Charging bench rejects non-chargeable items");
+            transaction.commit();
+        }
+        helper.succeed();
+    }
+
+    private static ResourceHandler<ItemResource> capability(GameTestHelper helper, BlockPos pos, Direction side) {
+        ResourceHandler<ItemResource> handler = helper.getLevel().getCapability(Capabilities.Item.BLOCK, helper.absolutePos(pos), side);
+        helper.assertTrue(handler != null, "Registered item capability is available from " + side);
+        return handler;
+    }
+
+    private static void assertTransactionalTransfer(GameTestHelper helper, ResourceHandler<ItemResource> top,
+            ResourceHandler<ItemResource> bottom, Container inventory, int exposedSlot, int topInventorySlot,
+            int bottomInventorySlot, ItemResource resource, ItemStack expected) {
+        try (Transaction transaction = Transaction.openRoot()) {
+            helper.assertValueEqual(top.insert(exposedSlot, resource, 2, transaction), 1, "Single-item capacity limits insertion");
+        }
+        helper.assertTrue(inventory.isEmpty(), "Uncommitted insertion rolls back");
+        try (Transaction transaction = Transaction.openRoot()) {
+            helper.assertValueEqual(top.insert(exposedSlot, resource, 1, transaction), 1, "Insertion accepts the chargeable item");
+            transaction.commit();
+        }
+        helper.assertTrue(ItemStack.matches(inventory.getItem(topInventorySlot), expected), "Top capability maps to the charging input slot");
+        helper.assertValueEqual(bottom.getAmountAsInt(exposedSlot), 0, "Bottom cannot see the top input slot");
+        try (Transaction transaction = Transaction.openRoot()) {
+            helper.assertValueEqual(bottom.extract(exposedSlot, resource, 1, transaction), 0, "Bottom cannot extract the top input slot");
+            transaction.commit();
+        }
+        try (Transaction transaction = Transaction.openRoot()) {
+            helper.assertValueEqual(top.extract(exposedSlot, resource, 1, transaction), 1, "Transfer extracts from the top input");
+            helper.assertValueEqual(bottom.insert(exposedSlot, resource, 1, transaction), 1, "Transfer inserts into the bottom output");
+        }
+        helper.assertTrue(ItemStack.matches(inventory.getItem(topInventorySlot), expected), "Aborted transfer restores its source");
+        helper.assertTrue(inventory.getItem(bottomInventorySlot).isEmpty(), "Aborted transfer restores its destination");
+        try (Transaction transaction = Transaction.openRoot()) {
+            helper.assertValueEqual(top.extract(exposedSlot, resource, 1, transaction), 1, "Committed transfer extracts from top");
+            helper.assertValueEqual(bottom.insert(exposedSlot, resource, 1, transaction), 1, "Committed transfer inserts into bottom");
+            transaction.commit();
+        }
+        helper.assertTrue(inventory.getItem(topInventorySlot).isEmpty(), "Committed transfer clears the source");
+        helper.assertTrue(ItemStack.matches(inventory.getItem(bottomInventorySlot), expected), "Committed transfer preserves item components at the mapped destination");
+    }
+
+    public static void tubePayloadPersistence(GameTestHelper helper) {
+        PneumaticTubePart tube = (PneumaticTubePart) TubeType.PNEUMATIC_TUBE.newPart();
+        tube.setConnMap(0x15);
+        ItemStack tool = named(new ItemStack(ExpansionItems.ELECTRIC_SCREWDRIVER_ITEM.get()), "Tube cargo");
+        tool.setDamageValue(137);
+        PneumaticTubePayload routed = new PneumaticTubePayload(tool);
+        routed.setProgress(200);
+        routed.setSpeed(7);
+        routed.setInputSide(Direction.WEST.ordinal());
+        routed.setOutputSide(Direction.EAST.ordinal());
+        int routedId = tube.getPneumaticTransport().addPayload(routed);
+        ItemStack diamonds = named(new ItemStack(Items.DIAMOND, 19), "Queued cargo");
+        PneumaticTubePayload unrouted = new PneumaticTubePayload(diamonds);
+        unrouted.setProgress(41);
+        unrouted.setSpeed(3);
+        int unroutedId = tube.getPneumaticTransport().addPayload(unrouted);
+
+        CompoundTag saved = new CompoundTag();
+        tube.save(saved, helper.getLevel().registryAccess());
+        helper.assertTrue(saved.contains("connMap") && saved.contains("payloads") && saved.contains("nextId"), "Tube keeps the existing flat persistence layout");
+        PneumaticTubePart restored = (PneumaticTubePart) TubeType.PNEUMATIC_TUBE.newPart();
+        restored.load(saved, helper.getLevel().registryAccess());
+        helper.assertValueEqual(restored.getConnMap(), 0x15, "Tube connections survive persistence");
+        helper.assertValueEqual(restored.getPneumaticTransport().getPayloads().size(), 2, "Both payloads survive persistence");
+        assertPayload(helper, restored.getPneumaticTransport().getPayload(routedId), tool, 200, 7, Direction.WEST.ordinal(), Direction.EAST.ordinal());
+        assertPayload(helper, restored.getPneumaticTransport().getPayload(unroutedId), diamonds, 41, 3, -1, -1);
+        int nextId = restored.getPneumaticTransport().addPayload(new PneumaticTubePayload(new ItemStack(Items.STICK)));
+        helper.assertValueEqual(nextId, unroutedId + 1, "Restored transport advances the persisted payload ID sequence");
+        helper.succeed();
+    }
+
+    public static void tubePayloadNetwork(GameTestHelper helper) {
+        PneumaticTubePart tube = (PneumaticTubePart) TubeType.PNEUMATIC_TUBE.newPart();
+        ItemStack tool = named(new ItemStack(ExpansionItems.ELECTRIC_SCREWDRIVER_ITEM.get()), "Network tube cargo");
+        tool.setDamageValue(137);
+        PneumaticTubePayload moving = new PneumaticTubePayload(tool);
+        moving.setProgress(200);
+        moving.setSpeed(16);
+        moving.setInputSide(Direction.WEST.ordinal());
+        moving.setOutputSide(Direction.EAST.ordinal());
+        int movingId = tube.getPneumaticTransport().addPayload(moving);
+        ItemStack diamonds = named(new ItemStack(Items.DIAMOND, 19), "Unrouted network cargo");
+        PneumaticTubePayload atEnd = new PneumaticTubePayload(diamonds);
+        atEnd.setProgress(PneumaticTubePayload.MAX_PROGRESS);
+        atEnd.setSpeed(16);
+        int atEndId = tube.getPneumaticTransport().addPayload(atEnd);
+
+        RegistryFriendlyByteBuf packet = new RegistryFriendlyByteBuf(Unpooled.buffer(), helper.getLevel().registryAccess(), ConnectionType.NEOFORGE);
+        try {
+            tube.getPneumaticTransport().writeDesc(packet);
+            PneumaticTubePart restored = (PneumaticTubePart) TubeType.PNEUMATIC_TUBE.newPart();
+            restored.getPneumaticTransport().readDesc(packet);
+            helper.assertValueEqual(restored.getPneumaticTransport().getPayloads().size(), 2, "Network description carries both payloads and IDs");
+            assertPayload(helper, restored.getPneumaticTransport().getPayload(movingId), tool, 200, 16, Direction.WEST.ordinal(), Direction.EAST.ordinal());
+            assertPayload(helper, restored.getPneumaticTransport().getPayload(atEndId), diamonds, PneumaticTubePayload.MAX_PROGRESS, 16, -1, -1);
+            helper.assertValueEqual(packet.readableBytes(), 0, "Network decoder consumes the complete payload description");
+        } finally {
+            packet.release();
+        }
+        helper.succeed();
+    }
+
+    private static void assertPayload(GameTestHelper helper, PneumaticTubePayload payload, ItemStack stack,
+            int progress, int speed, int input, int output) {
+        helper.assertTrue(payload != null, "Payload is restored under its original ID");
+        helper.assertTrue(ItemStack.matches(payload.getItemStack(), stack), "Payload preserves count, custom name and damage components");
+        helper.assertValueEqual(payload.getProgress(), progress, "Payload progress survives persistence");
+        helper.assertValueEqual(payload.getSpeed(), speed, "Payload speed survives persistence");
+        helper.assertValueEqual(payload.getInputSide(), input, "Payload input side survives persistence");
+        helper.assertValueEqual(payload.getOutputSide(), output, "Payload output side survives persistence");
+    }
+
+    private static ItemStack named(ItemStack stack, String name) {
+        stack.set(DataComponents.CUSTOM_NAME, Component.literal(name));
+        return stack;
+    }
+
+    private static int count(Container inventory, Item item) {
+        int count = 0;
+        for (int slot = 0; slot < inventory.getContainerSize(); slot++) {
+            ItemStack stack = inventory.getItem(slot);
+            if (stack.is(item)) count += stack.getCount();
+        }
+        return count;
+    }
+
+    private static ItemStack[] snapshot(Container inventory) {
+        ItemStack[] stacks = new ItemStack[inventory.getContainerSize()];
+        for (int slot = 0; slot < stacks.length; slot++) stacks[slot] = inventory.getItem(slot).copy();
+        return stacks;
+    }
+
+    private static void assertContents(GameTestHelper helper, Container inventory, ItemStack[] expected, String message) {
+        for (int slot = 0; slot < expected.length; slot++) {
+            helper.assertTrue(ItemStack.matches(inventory.getItem(slot), expected[slot]), message + " (slot " + slot + ")");
+        }
+    }
+}
