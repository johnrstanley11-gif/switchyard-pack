@@ -0,0 +1,29 @@
+package mrtjp.projectred.expansion.inventory;
+
+import mrtjp.projectred.core.inventory.BaseContainer;
+import net.minecraft.world.Container;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Consumer;
+
+/** Keeps machine recipe invalidation and dirty callbacks after SimpleContainer listeners were removed. */
+public class ListeningContainer extends BaseContainer {
+    private final List<Consumer<Container>> listeners = new ArrayList<>();
+
+    public ListeningContainer(int size) {
+        super(size);
+    }
+
+    public void addListener(Consumer<Container> listener) {
+        listeners.add(listener);
+    }
+
+    @Override
+    public void setChanged() {
+        super.setChanged();
+        for (var listener : List.copyOf(listeners)) {
+            listener.accept(this);
+        }
+    }
+}
