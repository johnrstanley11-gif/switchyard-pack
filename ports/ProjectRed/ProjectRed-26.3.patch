+/**
+ * Hit / break / landing / running particles of gates.
+ * <p>
+ * Port notes (26.x): replaces the IconHitEffectsPart interface the part itself implemented; particle handlers are
+ * registered per part type on the client (RegisterMultipartRenderersEvent).
+ */
+public class GatePartParticleHandler implements StandardPartParticleHandler<GatePart> {
+
+    @Override
+    public Cuboid6 getBounds(GatePart part) {
+        return part.getBounds();
+    }
+
+    @Override
+    public TextureAtlasSprite getParticleTexture(GatePart part, PartRayTraceResult hit) {
+        return part.getBreakingIcon(hit);
