+        helper.assertValueEqual(backward.getType(), HitResult.Type.BLOCK, "Reverse ray hits moving geometry");
+        helper.assertValueEqual(forward.getBlockPos(), stone, "Forward ray selects the closest moving block");
+        helper.assertValueEqual(backward.getBlockPos(), lamp, "Reverse ray selects the closest moving block");
+    }
