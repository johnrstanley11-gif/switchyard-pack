+    public static void projectBenchCrafting(GameTestHelper helper) {
+        BlockPos pos = new BlockPos(2, 1, 2);
+        helper.setBlock(pos, ExpansionBlocks.PROJECT_BENCH_BLOCK.get());
+        ProjectBenchBlockEntity bench = helper.getBlockEntity(pos, ProjectBenchBlockEntity.class);
+        ItemStack[] cakeInputs = {
+                new ItemStack(Items.MILK_BUCKET), new ItemStack(Items.MILK_BUCKET), new ItemStack(Items.MILK_BUCKET),
+                new ItemStack(Items.SUGAR), new ItemStack(Items.EGG), new ItemStack(Items.SUGAR),
+                new ItemStack(Items.WHEAT), new ItemStack(Items.WHEAT), new ItemStack(Items.WHEAT)
+        };
+        ItemStack plan = new ItemStack(ExpansionItems.RECIPE_PLAN_ITEM.get());
+        RecipePlanComponent.savePlan(plan, cakeInputs, new ItemStack(Items.CAKE));
+        bench.getPlanInventory().setItem(0, plan);
+        Container storage = bench.getStorageInventory();
+        storage.setItem(0, new ItemStack(Items.MILK_BUCKET));
+        storage.setItem(1, new ItemStack(Items.MILK_BUCKET));
+        storage.setItem(2, new ItemStack(Items.MILK_BUCKET));
+        storage.setItem(3, new ItemStack(Items.SUGAR, 2));
+        storage.setItem(4, new ItemStack(Items.EGG));
+        storage.setItem(5, new ItemStack(Items.WHEAT, 3));
+        bench.updateRecipeIfNeeded();
+
+        helper.assertTrue(bench.isPlanRecipe(), "Empty real grid uses the written plan");
+        helper.assertTrue(bench.getCraftingHelper().hasRecipe(), "Vanilla cake recipe resolves from the plan");
+        helper.assertTrue(bench.getCraftingHelper().canTakeIntoStorage(), "Stored ingredients and space allow crafting");
+        helper.assertTrue(bench.getCraftingHelper().onCraftedIntoStorage(), "CraftingHelper commits the storage craft");
+        helper.assertValueEqual(count(storage, Items.CAKE), 1, "Craft output reaches storage");
+        helper.assertValueEqual(count(storage, Items.BUCKET), 3, "Milk bucket remaining items reach storage");
+        helper.assertValueEqual(count(storage, Items.MILK_BUCKET) + count(storage, Items.SUGAR) + count(storage, Items.EGG) + count(storage, Items.WHEAT), 0, "Ingredients are consumed exactly once");
+        helper.assertTrue(bench.getCraftingGridInventory().isEmpty(), "Ghost plan inputs never become real grid items");
+        helper.assertTrue(RecipePlanComponent.getComponent(bench.getPlanInventory().getItem(0)).isRecipeValid(), "Written plan survives crafting");
+
+        ItemStack[] beforeFailure = snapshot(storage);
+        bench.updateRecipeIfNeeded();
+        helper.assertTrue(!bench.getCraftingHelper().canTake(), "Missing ingredients prevent another craft");
+        helper.assertTrue(!bench.getCraftingHelper().onCraftedIntoStorage(), "A second craft is rejected");
+        assertContents(helper, storage, beforeFailure, "Failed craft preserves every storage slot");
+        helper.succeed();
+    }
