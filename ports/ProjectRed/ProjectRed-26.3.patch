+    }
+
+    public static void onSubmitGeometry(SubmitCustomGeometryEvent event) {
+        var nodes = event.getLevelRenderState().getRenderData(DATA);
+        if (nodes == null || nodes.isEmpty()) return;
+        var camera = event.getLevelRenderState().cameraRenderState.pos;
+        PoseStack pose = event.getPoseStack();
+        pose.pushPose();
+        pose.translate(-camera.x, -camera.y, -camera.z);
+        var collector = event.getSubmitNodeCollector();
+        collector.submitCustomGeometry(pose, RenderTypes.linesDepthBias(), (mat, buffer) -> {
+            VertexConsumer transformed = new TransformingVertexConsumer(buffer, new Matrix4(mat.pose()));
+            VertexConsumer nodeLines = new DelegatingVertexConsumer(transformed) {
+                @Override public VertexConsumer setNormal(float x, float y, float z) { delegate.setNormal(x, y, z).setLineWidth(2.0F); return this; }
+            };
+            for (Node node : nodes) {
+                RenderUtils.bufferCuboidOutline(nodeLines, Cuboid6.full.copy().expand(-2 / 16D).add(node.position), EnumColour.ORANGE.rF(), EnumColour.ORANGE.gF(), EnumColour.ORANGE.bF(), 1);
+                for (var link : node.links) {
+                    if (link.isEmpty()) continue;
+                    for (int i = 1; i < link.size(); i++) bufferLinePair(transformed, link.get(i - 1), link.get(i));
+                    var first = link.getFirst(); var last = link.getLast();
+                    RenderUtils.bufferCuboidOutline(nodeLines, new Cuboid6(-4 / 16D, -4 / 16D, -4 / 16D, 4 / 16D, 4 / 16D, 4 / 16D).add(new Vector3(first.x, first.y, first.z)), 0, 0, 1, 1);
+                    RenderUtils.bufferCuboidOutline(nodeLines, new Cuboid6(-5 / 16D, -5 / 16D, -5 / 16D, 5 / 16D, 5 / 16D, 5 / 16D).add(new Vector3(last.x, last.y, last.z)), 1, 0, 0, 1);
+                }
+            }
+        });
+        collector.cc$submitCCRS(pose, RenderTypes.debugFilledBox(), (mat, ccrs) -> {
+            ccrs.baseColour = EnumColour.LIGHT_BLUE.rgba(128);
+            double b = 0.5 / 16D;
+            Cuboid6 cube = new Cuboid6(-b, -b, -b, b, b, b);
+            for (Node node : nodes) for (var link : node.links) for (var point : link) {
+                ccrs.setPipeline(new Translation(point.x, point.y, point.z).with(mat));
+                BlockRenderer.renderCuboid(ccrs, cube, 0);
+            }
+        });
+        pose.popPose();
+    }
+
+    private static void bufferLinePair(VertexConsumer buffer, Vec3 first, Vec3 second) {
+        var direction = second.subtract(first).normalize();
+        if (direction.lengthSqr() < 1.0E-12) return;
+        for (var point : List.of(first, second)) buffer.addVertex((float) point.x, (float) point.y, (float) point.z)
+                .setColor(EnumColour.LIGHT_BLUE.rF(), EnumColour.LIGHT_BLUE.gF(), EnumColour.LIGHT_BLUE.bF(), 1)
+                .setNormal((float) direction.x, (float) direction.y, (float) direction.z).setLineWidth(1.5F);
+    }
+}
