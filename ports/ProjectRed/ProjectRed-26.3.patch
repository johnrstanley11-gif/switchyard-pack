new file mode 100644
index 00000000..5935619d
--- /dev/null
+++ b/exploration/src/main/java/mrtjp/projectred/exploration/world/gen/MarbleCaveLiningFeature.java
@@ -0,0 +1,80 @@
+package mrtjp.projectred.exploration.world.gen;
+
+import com.mojang.serialization.MapCodec;
+import mrtjp.projectred.exploration.init.ExplorationTags;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.WorldGenLevel;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.chunk.ChunkGenerator;
+import net.minecraft.world.level.levelgen.feature.Feature;
+
+import static mrtjp.projectred.exploration.init.ExplorationBlocks.MARBLE_BLOCK;
+
+/**
+ * Lines the caves carved by {@link MarbleCaveWorldCarver} with marble: every block next to a carved block that ended up
+ * as air is turned into marble when it is a block a cave may carve through (the 1.21.1 overworld carver replaceables,
+ * see {@link ExplorationTags#MARBLE_CAVE_REPLACEABLE_BLOCK_TAG}) or marble already. This is what the 1.21.1 carver did
+ * in carveBlock; 26.x carvers cannot change blocks any more, so it moved into this feature which the biome modifier
+ * puts first in the feature pass (RAW_GENERATION) of every overworld biome.
+ * <p>
+ * Behaviour notes: carved blocks the aquifer filled with water or lava are not lined (the old code only lined around
+ * air as well); neighbours in the adjacent chunk are lined too (the old chunk-local block access wrapped them around
+ * into the same chunk).
+ */
+public record MarbleCaveLiningFeature() implements Feature {
+
+    public static final MapCodec<MarbleCaveLiningFeature> MAP_CODEC = MapCodec.unit(MarbleCaveLiningFeature::new);
+
+    @Override
+    public MapCodec<MarbleCaveLiningFeature> codec() {
+        return MAP_CODEC;
+    }
+
+    @Override
+    public boolean place(WorldGenLevel level, ChunkGenerator chunkGenerator, RandomSource random, BlockPos origin) {
+        ChunkPos chunkPos = ChunkPos.containing(origin);
+        MarbleCaveCarvedPositions.Entry carved = MarbleCaveCarvedPositions.take(chunkPos);
+        if (carved == null || carved.isEmpty()) {
+            return false;
+        }
+
+        BlockState marbleState = MARBLE_BLOCK.get().defaultBlockState();
+        BlockPos.MutableBlockPos pos = new BlockPos.MutableBlockPos();
+        BlockPos.MutableBlockPos adjacent = new BlockPos.MutableBlockPos();
+        boolean[] placed = { false };
+
+        carved.forEach((x, y, z) -> {
+            pos.set(chunkPos.getBlockX(x), y, chunkPos.getBlockZ(z));
+            BlockState carvedState = level.getBlockState(pos);
+            if (!carvedState.isAir()) {
+                return;
+            }
+
+            for (int s = 0; s < 6; s++) {
+                adjacent.setWithOffset(pos, Direction.values()[s]);
+                if (level.isOutsideBuildHeight(adjacent)) {
+                    continue;
+                }
+                BlockState adjacentState = level.getBlockState(adjacent);
+                if (canReplaceBlock(adjacentState) && level.ensureCanWrite(adjacent)) {
+                    level.setBlock(adjacent, marbleState, Block.UPDATE_CLIENTS);
+                    placed[0] = true;
+                }
+            }
+        });
+
+        return placed[0];
+    }
+
+    /**
+     * What may become a marble wall: the blocks the 1.21.1 cave carver could carve through, plus marble itself. Air
+     * check is a workaround for mods improperly adding air block tags to the replaceables tag (ProjectRed issue 1874).
+     */
+    public static boolean canReplaceBlock(BlockState state) {
+        return !state.isAir() && (state.is(ExplorationTags.MARBLE_CAVE_REPLACEABLE_BLOCK_TAG) || state.is(MARBLE_BLOCK.get()));
+    }
+}
