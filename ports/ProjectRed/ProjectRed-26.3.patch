@@ -0,0 +1,43 @@
+package mrtjp.projectred.core;
+
+import com.mojang.serialization.MapCodec;
+import net.minecraft.core.HolderLookup;
+import net.minecraft.core.RegistryAccess;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.storage.ValueInput;
+import net.minecraft.world.level.storage.ValueOutput;
+
+import javax.annotation.Nullable;
+
+/**
+ * Bridge between Minecraft 26.x {@link ValueOutput}/{@link ValueInput} persistence and the {@link CompoundTag}
+ * based save/load methods used throughout Project Red.
+ * <p>
+ * The tag is stored flat (as the fields of the output itself, not under a sub key), so the data on disk keeps the
+ * exact layout it had when block entities and parts were handed a CompoundTag directly.
+ */
+public final class TagIO {
+
+    private static final MapCodec<CompoundTag> FLAT = MapCodec.assumeMapUnsafe(CompoundTag.CODEC);
+
+    private TagIO() {
+    }
+
+    /** Writes all entries of the tag as fields of the output. */
+    public static void write(ValueOutput output, CompoundTag tag) {
+        if (!tag.isEmpty()) {
+            output.store(FLAT, tag);
+        }
+    }
+
+    /** Reads all fields of the input as one tag (empty when there is nothing). */
+    public static CompoundTag read(ValueInput input) {
+        return input.read(FLAT).orElseGet(CompoundTag::new);
+    }
+
+    /** The registries to (de)serialize registry-backed data such as item stacks with. */
+    public static HolderLookup.Provider registries(@Nullable Level level) {
+        return level != null ? level.registryAccess() : RegistryAccess.EMPTY;
+    }
+}
