+package mrtjp.projectred.expansion.client;
+
+import codechicken.lib.vec.Cuboid6;
+import codechicken.multipart.api.part.render.StaticPartRenderer;
+import codechicken.multipart.api.part.render.StandardPartParticleHandler;
+import codechicken.multipart.util.PartRayTraceResult;
+import mrtjp.projectred.expansion.part.FramePart;
+import net.minecraft.client.renderer.block.BlockAndTintGetter;
+import net.minecraft.client.renderer.block.dispatch.BlockStateModelPart;
+import net.minecraft.client.renderer.texture.TextureAtlasSprite;
+import net.minecraft.core.BlockPos;
+import net.minecraft.util.RandomSource;
+import net.neoforged.neoforge.model.data.ModelData;
+
+import java.util.List;
+
+public class FramePartRenderer implements StaticPartRenderer<FramePart>, StandardPartParticleHandler<FramePart> {
+    @Override
+    public void collectParts(ModelData modelData, BlockAndTintGetter level, BlockPos pos, RandomSource random, List<BlockStateModelPart> parts) {
+        var data = modelData.get(FrameModelData.DATA);
+        parts.add(FrameBlockModel.getOrBakePart(data == null ? 0 : data.mask()));
+    }
+    @Override public Cuboid6 getBounds(FramePart part) { return part.getBounds(); }
+    @Override public TextureAtlasSprite getParticleTexture(FramePart part, PartRayTraceResult hit) { return part.getBreakingIcon(hit); }
+    @Override public List<TextureAtlasSprite> getBrokenTextures(FramePart part) {
+        return List.of(part.getBrokenIcon(0), part.getBrokenIcon(1), part.getBrokenIcon(2), part.getBrokenIcon(3), part.getBrokenIcon(4), part.getBrokenIcon(5));
+    }
+}
