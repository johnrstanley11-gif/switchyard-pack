diff --git a/exploration/src/main/java/mrtjp/projectred/exploration/world/gen/MarbleCaveCarvedPositions.java b/exploration/src/main/java/mrtjp/projectred/exploration/world/gen/MarbleCaveCarvedPositions.java
new file mode 100644
index 00000000..6aa8d069
--- /dev/null
+++ b/exploration/src/main/java/mrtjp/projectred/exploration/world/gen/MarbleCaveCarvedPositions.java
@@ -0,0 +1,102 @@
+package mrtjp.projectred.exploration.world.gen;
+
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.chunk.CarverOutput;
+import org.jetbrains.annotations.Nullable;
+
+import java.util.BitSet;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Hands the positions carved by {@link MarbleCaveWorldCarver} in a chunk (carving pass) to the
+ * {@link MarbleCaveLiningFeature} of the same chunk (feature pass). Chunks are generated on worker threads: a chunk's
+ * carving pass runs on one thread and its feature pass may run on another, so the entries live in a concurrent map
+ * keyed by chunk position and are removed when the lining feature takes them.
+ * <p>
+ * Entries whose chunk never reaches the lining feature (world generation aborted, the feature removed by a data pack)
+ * would stay forever, so once the map grows past a threshold entries older than ten minutes are dropped.
+ */
+public final class MarbleCaveCarvedPositions {
+
+    private static final ConcurrentHashMap<Long, Entry> ENTRIES = new ConcurrentHashMap<>();
+    private static final int PURGE_THRESHOLD = 4096;
+    private static final long MAX_AGE_NANOS = TimeUnit.MINUTES.toNanos(10);
+
+    private MarbleCaveCarvedPositions() {
+    }
+
+    /**
+     * Wraps the chunk generator's carver output so that every carved position is also recorded for the chunk.
+     */
+    public static CarverOutput recorder(ChunkPos chunkPos, CarverOutput delegate) {
+        if (ENTRIES.size() > PURGE_THRESHOLD) {
+            long now = System.nanoTime();
+            ENTRIES.values().removeIf(e -> now - e.created > MAX_AGE_NANOS);
+        }
+        Entry entry = ENTRIES.computeIfAbsent(chunkPos.pack(), k -> new Entry(delegate.minY(), delegate.maxY()));
+        return new CarverOutput() {
+            @Override
+            public void carve(int x, int y, int z) {
+                delegate.carve(x, y, z);
+                entry.set(x, y, z);
+            }
+
+            @Override
+            public int minY() {
+                return delegate.minY();
+            }
+
+            @Override
+            public int maxY() {
+                return delegate.maxY();
+            }
+        };
+    }
+
+    /**
+     * Removes and returns the recorded positions of a chunk, or null when the marble cave carver carved nothing there.
+     */
+    public static @Nullable Entry take(ChunkPos chunkPos) {
+        return ENTRIES.remove(chunkPos.pack());
+    }
+
+    public static final class Entry {
+
+        private final int minY;
+        private final int height;
+        private final BitSet mask;
+        private final long created = System.nanoTime();
+
+        Entry(int minY, int maxY) {
+            this.minY = minY;
+            this.height = maxY - minY + 1;
+            this.mask = new BitSet(256 * height);
+        }
+
+        void set(int x, int y, int z) {
+            if (y < minY || y >= minY + height) return;
+            mask.set(index(x, y, z));
+        }
+
+        private int index(int x, int y, int z) {
+            return ((x & 15) << 4 | (z & 15)) * height + (y - minY);
+        }
+
+        public void forEach(Visitor visitor) {
+            for (int i = mask.nextSetBit(0); i >= 0; i = mask.nextSetBit(i + 1)) {
+                int column = i / height;
+                visitor.visit(column >> 4 & 15, i % height + minY, column & 15);
+            }
+        }
+
+        public boolean isEmpty() {
+            return mask.isEmpty();
+        }
+    }
+
+    @FunctionalInterface
+    public interface Visitor {
+        void visit(int x, int y, int z);
+    }
+}
