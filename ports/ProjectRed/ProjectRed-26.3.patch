@@ -0,0 +1,34 @@
+package mrtjp.projectred.transmission.client;
+
+import codechicken.lib.vec.Cuboid6;
+import codechicken.multipart.api.part.render.StandardPartParticleHandler;
+import codechicken.multipart.util.PartRayTraceResult;
+import mrtjp.projectred.transmission.part.BaseWirePart;
+import net.minecraft.client.renderer.texture.TextureAtlasSprite;
+
+import java.util.List;
+
+/**
+ * Hit / break / landing / running particles of wires.
+ * <p>
+ * Port notes (26.x): replaces the IconHitEffectsPart interface the part itself implemented; particle handlers are
+ * registered per part type on the client (RegisterMultipartRenderersEvent).
+ */
+public class WirePartParticleHandler implements StandardPartParticleHandler<BaseWirePart> {
+
+    @Override
+    public Cuboid6 getBounds(BaseWirePart part) {
+        return part.getBounds();
+    }
+
+    @Override
+    public TextureAtlasSprite getParticleTexture(BaseWirePart part, PartRayTraceResult hit) {
+        return part.getBreakingIcon(hit);
+    }
+
+    @Override
+    public List<TextureAtlasSprite> getBrokenTextures(BaseWirePart part) {
+        // One texture per side, as IconHitEffectsPart#getBrokenIcon(side) was asked
+        return List.of(part.getBrokenIcon(0), part.getBrokenIcon(1), part.getBrokenIcon(2), part.getBrokenIcon(3), part.getBrokenIcon(4), part.getBrokenIcon(5));
+    }
+}
