+package mrtjp.projectred.expansion.item;
+
+import net.minecraft.ChatFormatting;
+import net.minecraft.network.chat.Component;
+import net.minecraft.world.item.BlockItem;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.TooltipFlag;
+import net.minecraft.world.item.component.TooltipDisplay;
+import net.minecraft.world.level.block.Block;
+
+import java.util.function.Consumer;
+
+import static mrtjp.projectred.expansion.init.ExpansionUnlocal.UL_STORED_POWER_TOOLTIP;
+
+/** Block tooltips moved to their item in 26.x; retained battery power still appears here. */
+public class BatteryBoxBlockItem extends BlockItem {
+    public BatteryBoxBlockItem(Block block, Properties properties) {
+        super(block, properties);
+    }
+
+    @Override
+    public void appendHoverText(ItemStack stack, TooltipContext context, TooltipDisplay display, Consumer<Component> tooltip, TooltipFlag flag) {
+        super.appendHoverText(stack, context, display, tooltip, flag);
+        var component = BatteryBoxStorageComponent.getComponent(stack);
+        if (component != null) {
+            tooltip.accept(Component.translatable(UL_STORED_POWER_TOOLTIP)
+                    .append(": " + component.storedPower() + " / " + 8000)
+                    .withStyle(ChatFormatting.GRAY));
+        }
+    }
+}
