+            for (GraphContainer container : GraphDebugManager.getInstance(event.getLevel()).getContainers()) {
+                if (!(container instanceof PneumaticTubePart tube) || !tube.linkCache.isActive()) continue;
+                List<List<Vec3>> links = new ArrayList<>();
+                for (var link : tube.linkCache.links) {
+                    links.add(link.getPointListFor(tube.pos()).stream().map(p -> new Vec3(p.x, p.y, p.z)).toList());
+                }
+                nodes.add(new Node(tube.pos().immutable(), List.copyOf(links)));
+            }
