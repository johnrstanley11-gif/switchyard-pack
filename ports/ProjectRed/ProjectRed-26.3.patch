+package mrtjp.projectred.illumination.client;
+
+import codechicken.lib.vec.Cuboid6;
+import codechicken.microblock.part.MicroblockPart;
+import codechicken.multipart.api.part.render.DynamicPartRenderer;
+import com.mojang.blaze3d.vertex.PoseStack;
+import mrtjp.projectred.core.client.HaloRenderer;
+import mrtjp.projectred.illumination.part.IllumarLampMicroMaterial;
+import net.minecraft.client.renderer.SubmitNodeCollector;
+import net.minecraft.client.renderer.feature.ModelFeatureRenderer.CrumblingOverlay;
+import net.minecraft.client.renderer.state.level.CameraRenderState;
+import net.minecraft.world.phys.Vec3;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * The halo of microblocks cut from an inverted illumar lamp.
+ * <p>
+ * Port notes (26.x): the micro material's client object no longer has a dynamic render hook (it only supplies the
+ * baked parts and particles), so this dynamic renderer is registered for CBMultipart's microblock part types and
+ * does nothing for microblocks of other materials.
+ */
+public class IllumarLampMicroblockRenderer implements DynamicPartRenderer<MicroblockPart, IllumarLampMicroblockRenderer.State> {
+
+    public static class State {
+        boolean render;
+        int color;
+        @Nullable Cuboid6 bounds;
+    }
+
+    @Override
+    public State createDynamicState() {
+        return new State();
+    }
+
+    @Override
+    public void extractDynamicState(BEState beState, State state, MicroblockPart part, float partialTick, Vec3 camera, @Nullable CrumblingOverlay breakProgress) {
+        if (part.getMaterial() instanceof IllumarLampMicroMaterial material) {
+            state.render = true;
+            state.color = material.getLightColor();
+            state.bounds = part.getBounds().copy().expand(0.025D);
+        } else {
+            state.render = false;
+        }
+    }
+
+    @Override
+    public void submitDynamic(BEState beState, State state, PoseStack poseStack, SubmitNodeCollector collector, CameraRenderState cameraState) {
+        if (state.render && state.bounds != null) {
+            HaloRenderer.addLight(beState.pos(), state.bounds, state.color);
+        }
+    }
+}
