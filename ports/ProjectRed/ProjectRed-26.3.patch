diff --git a/core/src/main/java/mrtjp/projectred/core/client/BakedPartLib.java b/core/src/main/java/mrtjp/projectred/core/client/BakedPartLib.java
new file mode 100644
index 00000000..3cf6fd95
--- /dev/null
+++ b/core/src/main/java/mrtjp/projectred/core/client/BakedPartLib.java
@@ -0,0 +1,105 @@
+package mrtjp.projectred.core.client;
+
+import codechicken.lib.render.CCRenderState;
+import codechicken.lib.render.buffer.BakedQuadVertexBuilder;
+import codechicken.multipart.client.MultipartTintRegistry;
+import codechicken.multipart.util.Sides;
+import com.mojang.blaze3d.vertex.DefaultVertexFormat;
+import com.mojang.blaze3d.vertex.PoseStack;
+import com.mojang.blaze3d.vertex.QuadInstance;
+import net.minecraft.client.renderer.OrderedSubmitNodeCollector;
+import net.minecraft.client.renderer.Sheets;
+import net.minecraft.client.renderer.block.dispatch.BlockStateModelPart;
+import net.minecraft.client.renderer.rendertype.RenderType;
+import net.minecraft.client.renderer.texture.TextureAtlasSprite;
+import net.minecraft.client.resources.model.SimpleModelWrapper;
+import net.minecraft.client.resources.model.geometry.BakedQuad;
+import net.minecraft.client.resources.model.geometry.QuadCollection;
+import net.minecraft.client.resources.model.sprite.Material;
+import net.minecraft.util.ARGB;
+
+import java.util.List;
+import java.util.function.Consumer;
+
+/**
+ * Port helper (26.x). Multipart parts no longer draw themselves into the chunk buffer with a {@link CCRenderState}:
+ * the chunk mesher asks a part's static renderer for baked model parts. Project Red's models are still built and
+ * drawn with CCRenderState (CCModel + vertex operations), so these helpers run such a draw into baked quads, and
+ * draw baked parts where there is no chunk mesher (dynamic renders, previews).
+ */
+public final class BakedPartLib {
+
+    private BakedPartLib() {
+    }
+
+    /**
+     * Runs a CCRenderState draw and collects everything it draws as baked quads. Vertex colours and normals are kept
+     * (they hold the models' pre-computed shading), none of the quads is assigned to a cull face.
+     *
+     * @param renderer Draws with the given, already reset and bound, render state. Every draw must set a sprite
+     *                 (e.g. through an IconTransformation).
+     */
+    public static QuadCollection bakeQuads(Consumer<CCRenderState> renderer) {
+        CCRenderState ccrs = CCRenderState.instance();
+        ccrs.reset();
+        ccrs.brightness = 0;
+        BakedQuadVertexBuilder builder = new BakedQuadVertexBuilder();
+        ccrs.bind(builder, DefaultVertexFormat.BLOCK);
+
+        renderer.accept(ccrs);
+
+        QuadCollection.Builder quads = new QuadCollection.Builder();
+        builder.getAsUnculled(quads);
+        return quads.build();
+    }
+
+    /**
+     * {@link #bakeQuads} wrapped as a model part.
+     *
+     * @param particleIcon The sprite used for the part's particles
+     */
+    public static BlockStateModelPart bakePart(TextureAtlasSprite particleIcon, Consumer<CCRenderState> renderer) {
+        return new SimpleModelWrapper(bakeQuads(renderer), true, new Material.Baked(particleIcon, false));
+    }
+
+    /**
+     * The sheet to draw a model part with outside of chunk rendering.
+     */
+    public static RenderType entityRenderType(BlockStateModelPart part) {
+        return (part.materialFlags() & BakedQuad.FLAG_TRANSLUCENT) != 0 ? Sheets.translucentBlockItemSheet() : Sheets.cutoutBlockItemSheet();
+    }
+
+    /**
+     * Draws baked model parts (e.g. the parts of a microblock material) outside of chunk rendering.
+     *
+     * @param renderType Null to pick cutout / translucent per part
+     * @param alpha      Alpha of every quad, 255 for opaque
+     */
+    public static void submitParts(OrderedSubmitNodeCollector collector, PoseStack poseStack, List<BlockStateModelPart> parts, @org.jspecify.annotations.Nullable RenderType renderType, int packedLight, int packedOverlay, int alpha) {
+        for (BlockStateModelPart modelPart : parts) {
+            collector.submitCustomGeometry(poseStack, renderType != null ? renderType : entityRenderType(modelPart), (pose, consumer) -> {
+                QuadInstance instance = new QuadInstance();
+                instance.setLightCoords(packedLight);
+                instance.setOverlayCoords(packedOverlay);
+                int lastTint = -1;
+                int lastTintIndex = -1;
+                for (var side : Sides.SIDES_AND_NULL) {
+                    for (BakedQuad quad : modelPart.getQuads(side)) {
+                        int rgb = 0xFFFFFF;
+                        if (quad.materialInfo().isTinted()) {
+                            // Multipart tint indexes are proxies registered with CBMultipart's tint registry
+                            int tintIndex = quad.materialInfo().tintIndex();
+                            if (lastTintIndex != tintIndex) {
+                                lastTint = MultipartTintRegistry.getColor(tintIndex);
+                                lastTintIndex = tintIndex;
+                            }
+                            rgb = lastTint & 0xFFFFFF;
+                        }
+                        instance.setColor(ARGB.color(alpha, rgb));
+                        consumer.putBakedQuad(pose, quad, instance);
+                    }
+                }
+            });
+        }
+    }
+}
