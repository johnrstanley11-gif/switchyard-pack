+## Post effect definition format (Minecraft 26.x)
+
+Post effects are post-processing shader chains defined in JSON (`assets/<modid>/post_effect/<name>.json`).
+This replaces the 1.21.1 `shaders/post/*.json` + `shaders/program/*.json` pair: a pass now names its vertex and
+fragment shader directly and there are no per-program JSON files.
+
+```json
+{
+    // Internal targets, created for every frame the chain runs. A target without width/height is the size of
+    // the screen. Sizes in JSON are absolute: FixedScalePostChain replaces them with sizes relative to the
+    // screen (see HaloBloomPostChain), so the numbers below are only placeholders.
+    "targets": {
+        "modid:target1": {},
+        "modid:target2": { "width": 40, "height": 60 }
+    },
+
+    // Any target id used by a pass that is not listed above is an EXTERNAL target and has to be handed to the
+    // chain when it is added to a frame (here: 'minecraft:main' and 'projectred_core:bloom_in', the target the
+    // halos are drawn into before the chain runs).
+    "passes": [
+        {
+            "vertex_shader": "minecraft:core/screenquad",      // full-screen triangle, outputs texCoord
+            "fragment_shader": "modid:post/pass1shader",       // assets/<modid>/shaders/post/pass1shader.fsh
+            "inputs": [
+                // Bound in the shader as '<sampler_name>Sampler'. The SamplerInfo uniform block holds
+                // OutSize followed by one vec2 size per input, in this order.
+                { "sampler_name": "Diffuse", "target": "minecraft:main" },
+                { "sampler_name": "Depth", "target": "modid:target1", "use_depth_buffer": true },
+                { "sampler_name": "Texture", "location": "modid:example", "width": 16, "height": 16, "bilinear": false }
+            ],
+            "output": "modid:target1",
+            // Uniform blocks (std140) given to the fragment shader
+            "uniforms": {
+                "BlockName": [
+                    { "name": "Uniform1", "type": "float", "value": 0.1 }
+                ]
+            }
+        }
+    ]
+}
+```
