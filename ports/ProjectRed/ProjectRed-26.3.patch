+package mrtjp.projectred.expansion.client;
+
+import mrtjp.projectred.expansion.graphs.ClientSideLinkCache;
+import mrtjp.projectred.expansion.init.ExpansionSounds;
+import mrtjp.projectred.expansion.part.PneumaticTubePart;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.sounds.SoundSource;
+import net.minecraft.world.level.Level;
+
+import java.util.List;
+
+import static mrtjp.projectred.core.client.particle.ParticleAction.*;
+
+/** Client-only link effects, isolated from the common tube part's class loading. */
+public final class PneumaticTubeClientEffects {
+    private PneumaticTubeClientEffects() { }
+
+    public static void onLinksRemoved(Level level, PneumaticTubePart part, List<ClientSideLinkCache.ClientLink> links) {
+        for (var link : links) {
+            var points = link.getPointListFor(part.pos());
+            var particle = new PneumaticSmokeParticle((ClientLevel) level, points);
+            particle.setAlpha(0.0F);
+            particle.addAction(sequence(changeAlphaTo(0.7, 1), changeAlphaTo(0.0, 5), remove()));
+            Minecraft.getInstance().particleEngine.add(particle);
+            level.playLocalSound(part.pos(), ExpansionSounds.DEPRESSURIZE.get(), SoundSource.BLOCKS,
+                    0.7F + level.getRandom().nextFloat() * 0.3F, 1.0F, true);
+        }
+    }
+
+    public static void onLinksAdded(Level level, PneumaticTubePart part, List<ClientSideLinkCache.ClientLink> links) {
+        for (var link : links) {
+            var points = link.getPointListFor(part.pos());
+            var particle = new PneumaticSmokeParticle((ClientLevel) level, points);
+            particle.setAlpha(0.0F);
+            particle.addAction(sequence(changeAlphaTo(0.7, 1), changeAlphaTo(0.0, 10), remove()));
+            Minecraft.getInstance().particleEngine.add(particle);
+            level.playLocalSound(part.pos(), ExpansionSounds.PRESSURIZE.get(), SoundSource.BLOCKS,
+                    0.7F + level.getRandom().nextFloat() * 0.3F, 1.0F, true);
+        }
+    }
+}
