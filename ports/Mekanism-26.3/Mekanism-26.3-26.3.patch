+    /// Drops the transient client-side controllers when leaving a remote server. Does nothing while a server in this JVM owns them.
+    public static void resetClient() {
+        if (dataStorage == null) {
+            tickableLookups.clear();
+            controllers.clear();
+        }
+    }
+
     @SuppressWarnings("unchecked")
     public static <FREQ extends Frequency> FrequencyController<FREQ> getController(FrequencyType<FREQ> frequencyType) {
-        return (FrequencyController<FREQ>) controllers.get(frequencyType);
+        FrequencyController<?> controller = controllers.get(frequencyType);
+        if (controller == null && dataStorage == null) {
+            //Local 26.3 pack fix: serverLoad never runs on a client that is connected to a remote server, so there was no
+            // controller and placing any owned block crashed the client (NPE in FrequencyType#getLookup). Give the client a
+            // transient controller instead; its lookups are the unsaved "assume client" ones from createLookup, and the
+            // real frequency data still comes from the server.
+            controller = FrequencyController.create(frequencyType);
+            controllers.put(frequencyType, controller);
+        }
+        return (FrequencyController<FREQ>) controller;
     }
 
