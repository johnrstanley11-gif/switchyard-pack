+	private void registerPedestal(BlockModelGenerators blockModels) {
+		Consumer<ElementBuilder> base = element -> element.from(3, 0, 3).to(13, 2, 13)
+				.face(Direction.NORTH, pedestalFace(3, 0, 10, 2))
+				.face(Direction.EAST, pedestalFace(3, 0, 10, 2))
+				.face(Direction.SOUTH, pedestalFace(3, 0, 10, 2))
+				.face(Direction.WEST, pedestalFace(3, 0, 10, 2))
+				.face(Direction.UP, pedestalFace(3, 3, 10, 10))
+				.face(Direction.DOWN, pedestalFace(3, 3, 10, 10).andThen(face -> face.cullface(Direction.DOWN)));
+		Consumer<ElementBuilder> post = element -> element.from(6, 2, 6).to(10, 9, 10)
+				.face(Direction.NORTH, pedestalFace(6, 4, 4, 7))
+				.face(Direction.EAST, pedestalFace(6, 4, 4, 7))
+				.face(Direction.SOUTH, pedestalFace(6, 4, 4, 7))
+				.face(Direction.WEST, pedestalFace(6, 4, 4, 7));
