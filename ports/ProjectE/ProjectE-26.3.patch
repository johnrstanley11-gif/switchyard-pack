+package moze_intel.projecte.gameObjs.items.tools;
+
+import java.util.List;
+import moze_intel.projecte.gameObjs.IMatterType;
+import net.minecraft.core.HolderGetter;
+import net.minecraft.core.HolderSet;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.resources.ResourceKey;
+import net.minecraft.tags.BlockTags;
+import net.minecraft.tags.TagKey;
+import net.minecraft.world.entity.EquipmentSlotGroup;
+import net.minecraft.world.entity.ai.attributes.AttributeModifier;
+import net.minecraft.world.entity.ai.attributes.Attributes;
+import net.minecraft.core.component.BlockTransformer;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.component.ItemAttributeModifiers;
+import net.minecraft.world.item.component.Tool;
+import net.minecraft.world.item.component.Weapon;
+import net.minecraft.world.level.block.Block;
+
+/**
+ * Builds the tool components for matter tools. On 1.21.1 these came from DiggerItem/SwordItem/AxeItem with the matter
+ * type as a Tier; 26.3 removed those classes in favour of components on Item.Properties. This mirrors vanilla's
+ * ToolMaterial#applyToolProperties / #applySwordProperties, minus durability, repair material and enchantability, which
+ * matter tools never had (their 1.21.1 tier had 0 uses, no repair ingredient and an enchantment value of 0).
+ */
+public final class MatterTools {
+
+	private MatterTools() {
+	}
+
+	public static HolderSet<Block> blocks(TagKey<Block> tag) {
+		HolderGetter<Block> lookup = BuiltInRegistries.acquireBootstrapRegistrationLookup(BuiltInRegistries.BLOCK);
+		return lookup.getOrThrow(tag);
+	}
+
+	/**
+	 * Same attribute layout as vanilla tools: baseline + material bonus damage, and the attack speed baseline.
+	 */
+	public static ItemAttributeModifiers attributes(IMatterType matterType, float attackDamageBaseline, float attackSpeedBaseline) {
+		return ItemAttributeModifiers.builder()
+				.add(Attributes.ATTACK_DAMAGE, new AttributeModifier(Item.BASE_ATTACK_DAMAGE_ID, attackDamageBaseline + matterType.getAttackDamageBonus(),
+						AttributeModifier.Operation.ADD_VALUE), EquipmentSlotGroup.MAINHAND)
+				.add(Attributes.ATTACK_SPEED, new AttributeModifier(Item.BASE_ATTACK_SPEED_ID, attackSpeedBaseline, AttributeModifier.Operation.ADD_VALUE),
+						EquipmentSlotGroup.MAINHAND)
+				.build();
+	}
+
+	/**
+	 * Mining tool (old DiggerItem with the matter tier): cannot harvest the material's incorrect blocks, mines {@code minesEfficiently} at the material speed.
+	 */
+	public static Item.Properties tool(Item.Properties properties, IMatterType matterType, TagKey<Block> minesEfficiently, float attackDamageBaseline,
+			float attackSpeedBaseline, float disableBlockingSeconds) {
+		return properties.component(DataComponents.TOOL, new Tool(List.of(
+						Tool.Rule.deniesDrops(blocks(matterType.getIncorrectBlocksForDrops())),
+						Tool.Rule.minesAndDrops(blocks(minesEfficiently), matterType.getSpeed())
+				), 1.0F, 1, true))
+				.attributes(attributes(matterType, attackDamageBaseline, attackSpeedBaseline))
+				.component(DataComponents.WEAPON, new Weapon(2, disableBlockingSeconds));
+	}
+
+	/**
+	 * The 1.21.1 PESword tool rules (it already supplied its own Tool component), plus vanilla 26.3's sword-instant-mine rule.
+	 */
+	public static Item.Properties sword(Item.Properties properties, IMatterType matterType, TagKey<Block> minesEfficiently, float attackDamageBaseline,
+			float attackSpeedBaseline) {
+		return properties.component(DataComponents.TOOL, new Tool(List.of(
+						Tool.Rule.deniesDrops(blocks(matterType.getIncorrectBlocksForDrops())),
+						Tool.Rule.minesAndDrops(blocks(minesEfficiently), matterType.getSpeed()),
+						Tool.Rule.overrideSpeed(blocks(BlockTags.SWORD_INSTANTLY_MINES), Float.MAX_VALUE),
+						Tool.Rule.overrideSpeed(blocks(BlockTags.SWORD_EFFICIENT), 1.5F)
+				), 1.0F, 2, false))
+				.attributes(attributes(matterType, attackDamageBaseline, attackSpeedBaseline))
+				.component(DataComponents.WEAPON, new Weapon(1));
+	}
+
+	/**
+	 * Marks the item with a vanilla block transformer (what makes an item an "axe", "hoe" or "shovel" for block interactions on 26.3).
+	 */
+	public static Item.Properties transformer(Item.Properties properties, ResourceKey<BlockTransformer> transformer) {
+		return properties.delayedComponent(DataComponents.BLOCK_TRANSFORMER, context -> context.getOrThrow(transformer));
+	}
+
+	/** Vanilla axe: 5 seconds of shield disabling. */
+	public static final float AXE_DISABLE_BLOCKING_SECONDS = 5.0F;
+
+}
