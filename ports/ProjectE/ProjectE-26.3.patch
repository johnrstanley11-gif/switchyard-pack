+	private void particleOnly(BlockModelGenerators blockModels, BlockRegistryObject<?, ?> block) {
+		Block b = block.getBlock();
+		Identifier model = ModelTemplates.PARTICLE_ONLY.create(b, TextureMapping.particle(modTexture("block/" + block.getName())), blockModels.modelOutput);
+		blockModels.blockStateOutput.accept(BlockModelGenerators.createSimpleBlock(b, BlockModelGenerators.plainVariant(model)));
