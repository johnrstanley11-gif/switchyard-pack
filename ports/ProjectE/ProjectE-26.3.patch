+				.face(Direction.NORTH, pedestalFace(0, 0, 6, 1))
+				.face(Direction.EAST, pedestalFace(0, 0, 6, 1))
+				.face(Direction.SOUTH, pedestalFace(0, 0, 6, 1))
+				.face(Direction.WEST, pedestalFace(0, 0, 6, 1))
+				.face(Direction.UP, pedestalFace(6, 6, 6, 6))
+				.face(Direction.DOWN, pedestalFace(6, 6, 6, 6));
+		ModelTemplate template = ExtendedModelTemplateBuilder.builder()
+				.parent(BLOCK_PARENT)
+				.requiredTextureSlot(PEDESTAL)
+				.requiredTextureSlot(TextureSlot.PARTICLE)
+				.element(base)
+				.element(post)
+				.element(top)
+				.build();
+		Material dm = modTexture("block/dark_matter_block");
+		Block pedestal = PEBlocks.DARK_MATTER_PEDESTAL.getBlock();
+		Identifier model = template.create(pedestal, new TextureMapping().put(PEDESTAL, dm).put(TextureSlot.PARTICLE, dm), blockModels.modelOutput);
+		blockModels.blockStateOutput.accept(BlockModelGenerators.createSimpleBlock(pedestal, BlockModelGenerators.plainVariant(model)));
+	}
+
+	private static Consumer<FaceBuilder> pedestalFace(float u1, float v1, float u2, float v2) {
+		return face -> face.uvs(u1, v1, u2, v2).texture(PEDESTAL);
+	}
+
+	private void registerTransmutationTable(BlockModelGenerators blockModels) {
+		ModelTemplate template = ExtendedModelTemplateBuilder.builder()
+				.parent(BLOCK_PARENT)
+				.requiredTextureSlot(TextureSlot.BOTTOM)
+				.requiredTextureSlot(TextureSlot.TOP)
+				.requiredTextureSlot(TextureSlot.SIDE)
+				.requiredTextureSlot(TextureSlot.PARTICLE)
+				.element(element -> element.from(0, 0, 0).to(16, 4, 16)
+						.face(Direction.DOWN, face -> face.texture(TextureSlot.BOTTOM).cullface(Direction.DOWN))
+						.face(Direction.UP, face -> face.texture(TextureSlot.TOP))
+						.face(Direction.NORTH, face -> face.texture(TextureSlot.SIDE).cullface(Direction.NORTH))
+						.face(Direction.SOUTH, face -> face.texture(TextureSlot.SIDE).cullface(Direction.SOUTH))
+						.face(Direction.WEST, face -> face.texture(TextureSlot.SIDE).cullface(Direction.WEST))
+						.face(Direction.EAST, face -> face.texture(TextureSlot.SIDE).cullface(Direction.EAST)))
+				.build();
+		Material top = modTexture("block/transmutation_stone/top");
+		TextureMapping textures = new TextureMapping()
+				.put(TextureSlot.BOTTOM, modTexture("block/transmutation_stone/bottom"))
+				.put(TextureSlot.TOP, top)
+				.put(TextureSlot.SIDE, modTexture("block/transmutation_stone/side"))
+				.put(TextureSlot.PARTICLE, top);
+		Block table = PEBlocks.TRANSMUTATION_TABLE.getBlock();
+		Identifier model = template.create(table, textures, blockModels.modelOutput);
+		//Same rotations as 1.21.1's directional block with a 180 degree offset, the waterlogged property is ignored
+		blockModels.blockStateOutput.accept(MultiVariantGenerator.dispatch(table, BlockModelGenerators.plainVariant(model))
+				.with(BlockModelGenerators.ROTATIONS_COLUMN_WITH_FACING));
+	}
