+/**
+ * Block states, block models, item models and client item definitions.
+ * <p>
+ * 1.21.1 generated these with NeoForge's BlockStateProvider and ItemModelProvider, and the item models switched textures with item property
+ * overrides registered by {@link PEClient}. 26.3 removed both providers and property overrides: models are generated with the vanilla model
+ * generators, and each item gets a client item definition that selects its model from the same data components the 1.21.1 overrides read
+ * ({@code projecte:active}, {@code projecte:arcana_mode} and {@code projecte:swrg_mode}). The generated model names are the same as on 1.21.1.
+ * <p>
+ * Other 26.3 differences in the output: models that 1.21.1 declared as children of another PE model (the "on" furnaces, the higher tier collectors
+ * and relays and the nova cataclysm) now name all their textures on a vanilla parent; the interdiction torch no longer names a render type, as 26.3
+ * picks a block's render layer from its textures; and armor trims use NeoForge's dynamic trimmed armor model, which draws the same
+ * {@code trims/items/<slot>_trim_<material>} overlay for every trim material instead of one generated model per vanilla material.
+ */
+public class PEModelProvider extends ModelProvider {
+
+	private static final TextureSlot CHEST = TextureSlot.create("chest");
+	private static final TextureSlot PEDESTAL = TextureSlot.create("pedestal");
+	private static final Identifier BLOCK_PARENT = Identifier.withDefaultNamespace("block/block");
+
+	public PEModelProvider(PackOutput output) {
+		super(output, PECore.MODID);
+	}
+
+	@Override
+	protected void registerModels(BlockModelGenerators blockModels, ItemModelGenerators itemModels) {
+		registerBlocks(blockModels);
+		registerItems(itemModels);
+	}
+
+	private static Identifier modLoc(String path) {
+		return PECore.rl(path);
+	}
+
+	private static Material modTexture(String path) {
+		return new Material(modLoc(path));
+	}
+
+	// Blocks
+
+	private void registerBlocks(BlockModelGenerators blockModels) {
+		for (BlockRegistryObject<?, ?> block : java.util.List.of(PEBlocks.ALCHEMICAL_COAL, PEBlocks.MOBIUS_FUEL, PEBlocks.AETERNALIS_FUEL, PEBlocks.DARK_MATTER,
+				PEBlocks.RED_MATTER)) {
+			blockModels.createTrivialCube(block.getBlock());
+		}
+		registerTieredOrientable(blockModels, "collectors", PEBlocks.COLLECTOR, PEBlocks.COLLECTOR_MK2, PEBlocks.COLLECTOR_MK3);
+		registerTieredOrientable(blockModels, "relays", PEBlocks.RELAY, PEBlocks.RELAY_MK2, PEBlocks.RELAY_MK3);
+		registerFurnace(blockModels, PEBlocks.DARK_MATTER_FURNACE, "dm", "dark_matter_block");
+		registerFurnace(blockModels, PEBlocks.RED_MATTER_FURNACE, "rm", "red_matter_block");
+		registerChests(blockModels);
+		registerExplosives(blockModels);
+		//Same models and rotations as 1.21.1's torch and torchWall models with a 90 degree offset, and the same flat item model
+		blockModels.createNormalTorch(PEBlocks.INTERDICTION_TORCH.getBlock(), PEBlocks.INTERDICTION_TORCH.getWallBlock());
+		registerPedestal(blockModels);
+		registerTransmutationTable(blockModels);
+	}
+
+	private void registerChests(BlockModelGenerators blockModels) {
+		ExtendedModelTemplateBuilder baseChest = ExtendedModelTemplateBuilder.builder()
+				.parent(BLOCK_PARENT)
+				//Body
+				.element(element -> element.from(1, 0, 1).to(15, 10, 15)
+						.face(Direction.NORTH, chestFace(10.5F, 10.65F, 14, 8.25F))
+						.face(Direction.EAST, chestFace(7, 10.65F, 10.5F, 8.25F))
+						.face(Direction.SOUTH, chestFace(3.5F, 10.65F, 7, 8.25F))
+						.face(Direction.WEST, chestFace(0, 10.7F, 3.5F, 8.3F))
+						.face(Direction.UP, chestFace(7, 8.2F, 10.5F, 4.8F))
+						.face(Direction.DOWN, chestFace(3.5F, 8.3F, 7, 4.7F)))
+				//Lid
+				.element(element -> element.from(1, 10, 1).to(15, 15, 15)
+						.face(Direction.NORTH, chestFace(10.5F, 4.65F, 14, 3.5F))
+						.face(Direction.EAST, chestFace(7, 4.7F, 10.5F, 3.5F))
+						.face(Direction.SOUTH, chestFace(3.5F, 4.7F, 7, 3.5F))
+						.face(Direction.WEST, chestFace(0, 4.7F, 3.5F, 3.5F))
+						.face(Direction.UP, chestFace(7, 3.5F, 10.5F, 0))
+						.face(Direction.DOWN, chestFace(3.5F, 3.5F, 7, 0)))
+				//Top
+				.element(element -> element.from(7, 8, 0).to(9, 12, 1)
+						.face(Direction.NORTH, chestFace(0.75F, 1.25F, 0.25F, 0.25F))
+						.face(Direction.EAST, chestFace(1.25F, 1.25F, 1.5F, 0.25F))
+						.face(Direction.SOUTH, chestFace(0.75F, 1.25F, 1.25F, 0.25F))
+						.face(Direction.WEST, chestFace(0, 1.25F, 0.25F, 0.25F))
+						.face(Direction.UP, chestFace(0.25F, 0.25F, 0.75F, 0))
+						.face(Direction.DOWN, chestFace(0.75F, 0.25F, 1.25F, 0)));
+		//The base chest model leaves the chest texture for the item models to fill in
+		baseChest.build().create(modLoc("block/base_chest"), new TextureMapping(), blockModels.modelOutput);
+		particleOnly(blockModels, PEBlocks.ALCHEMICAL_CHEST);
+		particleOnly(blockModels, PEBlocks.CONDENSER);
+		particleOnly(blockModels, PEBlocks.CONDENSER_MK2);
+	}
+
+	private static Consumer<FaceBuilder> chestFace(float u1, float v1, float u2, float v2) {
