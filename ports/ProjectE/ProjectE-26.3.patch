@@ -0,0 +1,32 @@
+package moze_intel.projecte.gameObjs.registries;
+
+import moze_intel.projecte.PECore;
+import net.minecraft.core.registries.Registries;
+import net.minecraft.resources.ResourceKey;
+import net.minecraft.world.level.storage.loot.providers.number.ints.ContextIntProvider;
+
+/**
+ * Burn times of ProjectE's fuels. On 1.21.1 these were NeoForge furnace fuel data map entries; 26.3 gives fuel items a cooking fuel component whose
+ * burn time is a context int provider (a datapack registry entry, generated by the data generators like vanilla's).
+ */
+public final class PEContextIntProviders {
+
+	private PEContextIntProviders() {
+	}
+
+	//Four times the burn time of coal
+	public static final int ALCHEMICAL_COAL_BURN_TIME = 1_600 * 4;
+	public static final int MOBIUS_FUEL_BURN_TIME = ALCHEMICAL_COAL_BURN_TIME * 4;
+	public static final int AETERNALIS_FUEL_BURN_TIME = MOBIUS_FUEL_BURN_TIME * 4;
+
+	public static final ResourceKey<ContextIntProvider> COOKING_TIME_ALCHEMICAL_COAL = key("cooking/time_alchemical_coal");
+	public static final ResourceKey<ContextIntProvider> COOKING_TIME_ALCHEMICAL_COAL_BLOCK = key("cooking/time_alchemical_coal_block");
+	public static final ResourceKey<ContextIntProvider> COOKING_TIME_MOBIUS_FUEL = key("cooking/time_mobius_fuel");
+	public static final ResourceKey<ContextIntProvider> COOKING_TIME_MOBIUS_FUEL_BLOCK = key("cooking/time_mobius_fuel_block");
+	public static final ResourceKey<ContextIntProvider> COOKING_TIME_AETERNALIS_FUEL = key("cooking/time_aeternalis_fuel");
+	public static final ResourceKey<ContextIntProvider> COOKING_TIME_AETERNALIS_FUEL_BLOCK = key("cooking/time_aeternalis_fuel_block");
+
+	private static ResourceKey<ContextIntProvider> key(String path) {
+		return ResourceKey.create(Registries.CONTEXT_INT_PROVIDER, PECore.rl(path));
+	}
+}
