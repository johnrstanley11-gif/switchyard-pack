--- /dev/null
+++ b/src/main/java/moze_intel/projecte/utils/transfer/PECombinedItemHandler.java
@@ -0,0 +1,73 @@
+package moze_intel.projecte.utils.transfer;
+
+import net.minecraft.world.item.ItemStack;
+import net.neoforged.neoforge.transfer.CombinedResourceHandler;
+import net.neoforged.neoforge.transfer.item.ItemResource;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * Several ProjectE inventories viewed as one, on NeoForge's {@link CombinedResourceHandler} (the 26.3 replacement for
+ * CombinedInvWrapper), with the slot-level contract routed to the inventory owning each slot.
+ */
+public class PECombinedItemHandler extends CombinedResourceHandler<ItemResource> implements IPEItemHandler {
+
+	public PECombinedItemHandler(IPEItemHandler... handlers) {
+		super(handlers);
+	}
+
+	protected IPEItemHandler handlerFor(int slot) {
+		return (IPEItemHandler) getHandlerFromIndex(getHandlerIndex(slot));
+	}
+
+	protected int localSlot(int slot) {
+		return getSlotFromIndex(slot, getHandlerIndex(slot));
+	}
+
+	/** The inventory owning a combined slot (old CombinedInvWrapper#getHandlerFromIndex(getIndexForSlot(slot))). */
+	public IPEItemHandler getHandlerForSlot(int slot) {
+		return handlerFor(slot);
+	}
+
+	/** The slot index inside its own inventory (old CombinedInvWrapper#getSlotFromIndex). */
+	public int getLocalSlot(int slot) {
+		return localSlot(slot);
+	}
+
+	@Override
+	public int getSlots() {
+		return size();
+	}
+
+	@NotNull
+	@Override
+	public ItemStack getStackInSlot(int slot) {
+		return handlerFor(slot).getStackInSlot(localSlot(slot));
+	}
+
+	@Override
+	public void setStackInSlot(int slot, @NotNull ItemStack stack) {
+		handlerFor(slot).setStackInSlot(localSlot(slot), stack);
+	}
+
+	@NotNull
+	@Override
+	public ItemStack insertItem(int slot, @NotNull ItemStack stack, boolean simulate) {
+		return handlerFor(slot).insertItem(localSlot(slot), stack, simulate);
+	}
+
+	@NotNull
+	@Override
+	public ItemStack extractItem(int slot, int amount, boolean simulate) {
+		return handlerFor(slot).extractItem(localSlot(slot), amount, simulate);
+	}
+
+	@Override
+	public int getSlotLimit(int slot) {
+		return handlerFor(slot).getSlotLimit(localSlot(slot));
+	}
+
+	@Override
+	public boolean isItemValid(int slot, @NotNull ItemStack stack) {
+		return handlerFor(slot).isItemValid(localSlot(slot), stack);
+	}
+}
diff --git a/src/main/java/moze_intel/projecte/utils/transfer/PEItemHandlers.java b/src/main/java/moze_intel/projecte/utils/transfer/PEItemHandlers.java
new file mode 100644
index 00000000..f2e13ac0
--- /dev/null
+++ b/src/main/java/moze_intel/projecte/utils/transfer/PEItemHandlers.java
@@ -0,0 +1,163 @@
+package moze_intel.projecte.utils.transfer;
+
+import net.minecraft.world.item.ItemStack;
+import net.neoforged.neoforge.transfer.IndexModifier;
+import net.neoforged.neoforge.transfer.ResourceHandler;
+import net.neoforged.neoforge.transfer.ResourceHandlerUtil;
+import net.neoforged.neoforge.transfer.item.ItemResource;
+import net.neoforged.neoforge.transfer.item.ItemUtil;
+import net.neoforged.neoforge.transfer.transaction.Transaction;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * Stack-based operations on any {@link ResourceHandler ResourceHandler&lt;ItemResource&gt;} (ProjectE's own inventories,
+ * other mods' capabilities, the player inventory wrapper). Each call is one root transaction that is committed unless
+ * {@code simulate} is set, so these behave like the 1.21.1 IItemHandler / ItemHandlerHelper calls ProjectE used.
+ */
+public final class PEItemHandlers {
+
+	private PEItemHandlers() {
+	}
+
+	public static int slots(@NotNull ResourceHandler<ItemResource> handler) {
+		return handler.size();
+	}
+
+	/**
+	 * @return For ProjectE's own inventories the slot's live stack (the old getStackInSlot contract); for any other handler a
+	 * new stack representing the slot, which does not write back when mutated.
+	 */
+	@NotNull
+	public static ItemStack getStack(@NotNull ResourceHandler<ItemResource> handler, int slot) {
+		if (handler instanceof IPEItemHandler pe) {
+			return pe.getStackInSlot(slot);
+		}
+		return ItemUtil.getStack(handler, slot);
+	}
+
+	public static boolean isEmpty(@NotNull ResourceHandler<ItemResource> handler, int slot) {
+		return handler.getResource(slot).isEmpty() || handler.getAmountAsInt(slot) == 0;
+	}
+
+	/**
+	 * Inserts into one slot; returns the remainder.
+	 */
+	@NotNull
+	public static ItemStack insert(@NotNull ResourceHandler<ItemResource> handler, int slot, @NotNull ItemStack stack, boolean simulate) {
+		if (handler instanceof IPEItemHandler pe) {
+			return pe.insertItem(slot, stack, simulate);
+		}
+		return ItemUtil.insertItemReturnRemaining(handler, slot, stack, simulate, null);
+	}
+
+	/**
+	 * Inserts into the first slots that accept it, in order (old ItemHandlerHelper#insertItem); returns the remainder.
+	 */
+	@NotNull
+	public static ItemStack insert(@Nullable ResourceHandler<ItemResource> handler, @NotNull ItemStack stack, boolean simulate) {
+		if (handler == null || stack.isEmpty()) {
+			return stack;
+		}
+		return ItemUtil.insertItemReturnRemaining(handler, stack, simulate, null);
+	}
+
+	/**
+	 * Inserts into slots already holding the item first, then empty ones (old ItemHandlerHelper#insertItemStacked);
+	 * returns the remainder.
+	 */
+	@NotNull
+	public static ItemStack insertStacked(@Nullable ResourceHandler<ItemResource> handler, @NotNull ItemStack stack, boolean simulate) {
+		if (handler == null || stack.isEmpty()) {
+			return stack;
+		}
+		try (Transaction tx = Transaction.openRoot()) {
+			int inserted = ResourceHandlerUtil.insertStacking(handler, ItemResource.of(stack), stack.getCount(), tx);
+			if (!simulate) {
+				tx.commit();
+			}
+			return inserted >= stack.getCount() ? ItemStack.EMPTY : stack.copyWithCount(stack.getCount() - inserted);
+		}
+	}
+
+	/**
+	 * Extracts up to {@code amount} from one slot; returns what was (or would be) extracted.
+	 */
+	@NotNull
+	public static ItemStack extract(@NotNull ResourceHandler<ItemResource> handler, int slot, int amount, boolean simulate) {
+		if (handler instanceof IPEItemHandler pe) {
+			return pe.extractItem(slot, amount, simulate);
+		}
+		if (amount <= 0) {
+			return ItemStack.EMPTY;
+		}
+		ItemResource resource = handler.getResource(slot);
+		if (resource.isEmpty()) {
+			return ItemStack.EMPTY;
+		}
+		try (Transaction tx = Transaction.openRoot()) {
+			int extracted = handler.extract(slot, resource, amount, tx);
+			if (!simulate) {
+				tx.commit();
+			}
+			return extracted == 0 ? ItemStack.EMPTY : resource.toStack(extracted);
+		}
+	}
+
+	/**
+	 * Slot limit for a given stack (old getSlotLimit, bounded by the stack's own max size).
+	 */
+	public static int slotLimit(@NotNull ResourceHandler<ItemResource> handler, int slot, @NotNull ItemStack stack) {
+		if (handler instanceof IPEItemHandler pe) {
+			return Math.min(pe.getSlotLimit(slot), stack.getMaxStackSize());
+		}
+		return handler.getCapacityAsInt(slot, ItemResource.of(stack));
+	}
+
+	public static boolean isItemValid(@NotNull ResourceHandler<ItemResource> handler, int slot, @NotNull ItemStack stack) {
+		if (handler instanceof IPEItemHandler pe) {
+			return pe.isItemValid(slot, stack);
+		}
+		return handler.isValid(slot, ItemResource.of(stack));
+	}
+
+	/**
+	 * An {@link IndexModifier} for menu slots: ProjectE inventories set the slot directly, other handlers (such as item
+	 * component inventories) are changed through {@link #setStack}.
+	 */
+	@NotNull
+	public static IndexModifier<ItemResource> modifierFor(@NotNull ResourceHandler<ItemResource> handler) {
+		if (handler instanceof IPEItemHandler pe) {
+			return (index, resource, amount) -> pe.setStackInSlot(index, resource.toStack(amount));
+		}
+		if (handler instanceof IndexModifier<?> modifier) {
+			@SuppressWarnings("unchecked")
+			IndexModifier<ItemResource> itemModifier = (IndexModifier<ItemResource>) modifier;
+			return itemModifier;
+		}
+		return (index, resource, amount) -> setStack(handler, index, resource.toStack(amount));
+	}
+
+	/**
+	 * Directly replaces a slot, for handlers that support it (ProjectE's own inventories). Other handlers are changed
+	 * with an extract + insert transaction; returns false if the replacement could not be made exactly.
+	 */
+	public static boolean setStack(@NotNull ResourceHandler<ItemResource> handler, int slot, @NotNull ItemStack stack) {
+		if (handler instanceof IPEItemHandler pe) {
+			pe.setStackInSlot(slot, stack);
+			return true;
+		}
+		try (Transaction tx = Transaction.openRoot()) {
+			ItemResource current = handler.getResource(slot);
+			int currentAmount = handler.getAmountAsInt(slot);
+			if (!current.isEmpty() && currentAmount > 0 && handler.extract(slot, current, currentAmount, tx) != currentAmount) {
+				return false;
+			}
+			if (!stack.isEmpty() && handler.insert(slot, ItemResource.of(stack), stack.getCount(), tx) != stack.getCount()) {
+				return false;
+			}
+			tx.commit();
+			return true;
+		}
+	}
+}
diff --git a/src/main/java/moze_intel/projecte/utils/transfer/PEItemStackHandler.java b/src/main/java/moze_intel/projecte/utils/transfer/PEItemStackHandler.java
