+		simpleBlock(blockModels, PEBlocks.NOVA_CATALYST.getBlock(), ModelTemplates.CUBE_BOTTOM_TOP.create(PEBlocks.NOVA_CATALYST.getBlock(),
+				new TextureMapping().put(TextureSlot.SIDE, modTexture("block/explosives/nova_side")).put(TextureSlot.BOTTOM, bottom).put(TextureSlot.TOP, top),
+				blockModels.modelOutput));
+		simpleBlock(blockModels, PEBlocks.NOVA_CATACLYSM.getBlock(), ModelTemplates.CUBE_BOTTOM_TOP.create(PEBlocks.NOVA_CATACLYSM.getBlock(),
+				new TextureMapping().put(TextureSlot.SIDE, modTexture("block/explosives/nova1_side")).put(TextureSlot.BOTTOM, bottom).put(TextureSlot.TOP, top),
+				blockModels.modelOutput));
+	}
