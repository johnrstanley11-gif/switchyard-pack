+package moze_intel.projecte.utils.transfer;
+
+import net.minecraft.world.item.ItemStack;
+import net.neoforged.neoforge.transfer.item.ItemResource;
+import net.neoforged.neoforge.transfer.transaction.TransactionContext;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * A contiguous slot range of a ProjectE inventory (the 26.3 replacement for RangedWrapper over ItemStackHandler).
+ */
+public class PERangedItemHandler implements IPEItemHandler {
+
+	private final IPEItemHandler compose;
+	private final int minSlot;
+	private final int maxSlot;
+
+	/**
+	 * @param minSlot First slot (inclusive).
+	 * @param maxSlot Last slot (exclusive).
+	 */
+	public PERangedItemHandler(IPEItemHandler compose, int minSlot, int maxSlot) {
+		if (minSlot < 0 || maxSlot < minSlot || maxSlot > compose.size()) {
+			throw new IllegalArgumentException("Invalid range [" + minSlot + ", " + maxSlot + ") for " + compose.size() + " slots");
+		}
+		this.compose = compose;
+		this.minSlot = minSlot;
+		this.maxSlot = maxSlot;
+	}
+
+	private int slot(int index) {
+		if (index < 0 || index >= size()) {
+			throw new IndexOutOfBoundsException("Slot " + index + " not in valid range - [0," + size() + ")");
+		}
+		return index + minSlot;
+	}
+
+	@Override
+	public int size() {
+		return maxSlot - minSlot;
+	}
+
+	@NotNull
+	@Override
+	public ItemResource getResource(int index) {
+		return compose.getResource(slot(index));
+	}
+
+	@Override
+	public long getAmountAsLong(int index) {
+		return compose.getAmountAsLong(slot(index));
+	}
+
+	@Override
+	public long getCapacityAsLong(int index, @NotNull ItemResource resource) {
+		return compose.getCapacityAsLong(slot(index), resource);
+	}
+
+	@Override
+	public boolean isValid(int index, @NotNull ItemResource resource) {
+		return compose.isValid(slot(index), resource);
+	}
+
+	@Override
+	public int insert(int index, @NotNull ItemResource resource, int amount, @NotNull TransactionContext transaction) {
+		return compose.insert(slot(index), resource, amount, transaction);
+	}
+
+	@Override
+	public int extract(int index, @NotNull ItemResource resource, int amount, @NotNull TransactionContext transaction) {
+		return compose.extract(slot(index), resource, amount, transaction);
+	}
+
+	@Override
+	public int getSlots() {
+		return size();
+	}
+
+	@NotNull
+	@Override
+	public ItemStack getStackInSlot(int slot) {
+		return compose.getStackInSlot(slot(slot));
+	}
+
+	@Override
+	public void setStackInSlot(int slot, @NotNull ItemStack stack) {
+		compose.setStackInSlot(slot(slot), stack);
+	}
+
+	@NotNull
+	@Override
+	public ItemStack insertItem(int slot, @NotNull ItemStack stack, boolean simulate) {
+		return compose.insertItem(slot(slot), stack, simulate);
+	}
+
+	@NotNull
+	@Override
+	public ItemStack extractItem(int slot, int amount, boolean simulate) {
+		return compose.extractItem(slot(slot), amount, simulate);
+	}
+
+	@Override
+	public int getSlotLimit(int slot) {
+		return compose.getSlotLimit(slot(slot));
+	}
+
+	@Override
+	public boolean isItemValid(int slot, @NotNull ItemStack stack) {
+		return compose.isItemValid(slot(slot), stack);
+	}
+}
