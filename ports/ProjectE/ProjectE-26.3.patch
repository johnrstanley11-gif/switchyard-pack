+				.put(TextureSlot.BOTTOM, side)
+				.put(TextureSlot.TOP, modTexture("block/" + type + "/top_1"));
+		horizontalBlock(blockModels, base.getBlock(), ModelTemplates.CUBE_ORIENTABLE_TOP_BOTTOM.create(base.getBlock(), textures, blockModels.modelOutput));
+		horizontalBlock(blockModels, mk2.getBlock(), ModelTemplates.CUBE_ORIENTABLE_TOP_BOTTOM.create(mk2.getBlock(),
+				textures.copyAndUpdate(TextureSlot.TOP, modTexture("block/" + type + "/top_2")), blockModels.modelOutput));
+		horizontalBlock(blockModels, mk3.getBlock(), ModelTemplates.CUBE_ORIENTABLE_TOP_BOTTOM.create(mk3.getBlock(),
+				textures.copyAndUpdate(TextureSlot.TOP, modTexture("block/" + type + "/top_3")), blockModels.modelOutput));
+	}
+
+	/**
+	 * Same rotations as 1.21.1's horizontal block with its default 180 degree offset.
+	 */
+	private void horizontalBlock(BlockModelGenerators blockModels, Block block, Identifier model) {
+		blockModels.blockStateOutput.accept(MultiVariantGenerator.dispatch(block, BlockModelGenerators.plainVariant(model))
+				.with(BlockModelGenerators.ROTATION_HORIZONTAL_FACING));
+	}
+
+	// Items
+
+	private void registerItems(ItemModelGenerators itemModels) {
+		//Note: Block items without an explicit definition get one pointing at their block model, which is what 1.21.1's block parent item models did
+		for (ItemLike item : java.util.List.of(PEItems.CATALYTIC_LENS, PEItems.DESTRUCTION_CATALYST, PEItems.LOW_DIVINING_ROD, PEItems.MEDIUM_DIVINING_ROD,
+				PEItems.HIGH_DIVINING_ROD, PEItems.HYPERKINETIC_LENS, PEItems.MERCURIAL_EYE, PEItems.PHILOSOPHERS_STONE, PEItems.REPAIR_TALISMAN,
+				PEItems.TOME_OF_KNOWLEDGE, PEItems.TRANSMUTATION_TABLET)) {
+			itemModels.generateFlatItem(item.asItem(), ModelTemplates.FLAT_ITEM);
+		}
+		generated(itemModels, PEItems.ALCHEMICAL_COAL, "item/fuels/alchemical_coal");
+		generated(itemModels, PEItems.MOBIUS_FUEL, "item/fuels/mobius");
+		generated(itemModels, PEItems.AETERNALIS_FUEL, "item/fuels/aeternalis");
+		generated(itemModels, PEItems.DARK_MATTER, "item/matter/dark");
+		generated(itemModels, PEItems.RED_MATTER, "item/matter/red");
+		generated(itemModels, PEItems.LOW_COVALENCE_DUST, "item/covalence_dust/low");
+		generated(itemModels, PEItems.MEDIUM_COVALENCE_DUST, "item/covalence_dust/medium");
+		generated(itemModels, PEItems.HIGH_COVALENCE_DUST, "item/covalence_dust/high");
+		//Note: The interdiction torch's flat item model (texture block/interdiction_torch) is made by createNormalTorch
+		generateAlchemicalBags(itemModels);
+		generateChests(itemModels);
+		generateRings(itemModels);
+		generateKleinStars(itemModels);
+		generateGear(itemModels);
+		activeToggle(itemModels, PEItems.GEM_OF_ETERNAL_DENSITY, "item/dense_gem_off", "gem_of_eternal_density_on", "item/dense_gem_on");
+		//Note: We don't actually have a manual, but I moved this model over to data gen anyways
+		flatModel(itemModels, "manual", "item/book");
+	}
+
+	private void generateAlchemicalBags(ItemModelGenerators itemModels) {
+		for (DyeColor color : Constants.COLORS) {
+			generated(itemModels, PEItems.getBagReference(color), "item/alchemy_bags/" + color);
+		}
+	}
+
+	private void generateChests(ItemModelGenerators itemModels) {
+		generateChest(itemModels, PEBlocks.ALCHEMICAL_CHEST);
+		generateChest(itemModels, PEBlocks.CONDENSER);
+		generateChest(itemModels, PEBlocks.CONDENSER_MK2);
+	}
+
+	private void generateChest(ItemModelGenerators itemModels, BlockRegistryObject<?, ?> block) {
+		String name = block.getName();
+		Identifier model = ExtendedModelTemplateBuilder.builder()
+				.parent(modLoc("block/base_chest"))
+				.requiredTextureSlot(CHEST)
+				.build()
+				.create(block.asItem(), new TextureMapping().put(CHEST, modTexture("block/" + name)), itemModels.modelOutput);
+		itemModels.itemModelOutput.accept(block.asItem(), ItemModelUtils.plainModel(model));
+	}
+
+	private void generateRings(ItemModelGenerators itemModels) {
+		//Arcana: the 1.21.1 overrides picked a texture from the mode (defaulting to the ring's default mode) and whether the ring is active
+		ArcanaMode defaultArcanaMode = PEItems.ARCANA_RING.asItem().getDefaultMode();
+		ItemModel.Unbaked defaultArcana = null;
+		java.util.List<SelectItemModel.SwitchCase<ArcanaMode>> arcanaCases = new java.util.ArrayList<>();
+		for (ArcanaMode mode : ArcanaMode.values()) {
+			String modeName = switch (mode) {
+				case ZERO -> "zero";
+				case IGNITION -> "ignition";
+				case HARVEST -> "harv";
+				case SWRG -> "swrg";
+			};
+			int index = mode.ordinal();
+			ItemModel.Unbaked modeModel = activeSelect(
+					plain(flatModel(itemModels, "arcana_" + modeName + "_off", "item/rings/arcana_" + index)),
+					plain(flatModel(itemModels, "arcana_" + modeName + "_on", "item/rings/arcana_" + index + "_on"))
+			);
+			arcanaCases.add(ItemModelUtils.when(mode, modeModel));
+			if (mode == defaultArcanaMode) {
+				defaultArcana = modeModel;
+			}
+		}
+		itemModels.itemModelOutput.accept(PEItems.ARCANA_RING.asItem(), ItemModelUtils.select(
+				new ComponentContents<>(PEDataComponentTypes.ARCANA_MODE.get()), defaultArcana, arcanaCases));
+		generated(itemModels, PEItems.ARCHANGEL_SMITE, "item/rings/archangel_smite");
+		activeToggle(itemModels, PEItems.BLACK_HOLE_BAND, "item/rings/black_hole_off", "black_hole_band_on", "item/rings/black_hole_on");
+		activeToggle(itemModels, PEItems.BODY_STONE, "item/rings/body_stone_off", "body_stone_on", "item/rings/body_stone_on");
+		generated(itemModels, PEItems.EVERTIDE_AMULET, "item/rings/evertide_amulet");
+		activeToggle(itemModels, PEItems.HARVEST_GODDESS_BAND, "item/rings/harvest_god_off", "harvest_goddess_band_on", "item/rings/harvest_god_on");
+		activeToggle(itemModels, PEItems.IGNITION_RING, "item/rings/ignition_off", "ignition_on", "item/rings/ignition_on");
+		generated(itemModels, PEItems.IRON_BAND, "item/rings/iron_band");
+		activeToggle(itemModels, PEItems.LIFE_STONE, "item/rings/life_stone_off", "life_stone_on", "item/rings/life_stone_on");
+		activeToggle(itemModels, PEItems.MIND_STONE, "item/rings/mind_stone_off", "mind_stone_on", "item/rings/mind_stone_on");
+		activeToggle(itemModels, PEItems.SOUL_STONE, "item/rings/soul_stone_off", "soul_stone_on", "item/rings/soul_stone_on");
+		//Swiftwolf's Rending Gale: off unless it has a mode, as on 1.21.1
+		Item swrg = PEItems.SWIFTWOLF_RENDING_GALE.asItem();
+		itemModels.itemModelOutput.accept(swrg, ItemModelUtils.select(new ComponentContents<>(PEDataComponentTypes.SWRG_MODE.get()),
+				plain(flatModel(itemModels, swrg, "item/rings/swrg_off")),
+				ItemModelUtils.when(SWRGMode.FLIGHT, plain(flatModel(itemModels, "swiftwolf_rending_gale_fly", "item/rings/swrg_on1"))),
+				ItemModelUtils.when(SWRGMode.SHIELD, plain(flatModel(itemModels, "swiftwolf_rending_gale_repel", "item/rings/swrg_on3"))),
+				ItemModelUtils.when(SWRGMode.SHIELDED_FLIGHT, plain(flatModel(itemModels, "swiftwolf_rending_gale_fly_repel", "item/rings/swrg_on2")))
+		));
+		activeToggle(itemModels, PEItems.VOID_RING, "item/rings/void_off", "void_ring_on", "item/rings/void_on");
+		generated(itemModels, PEItems.VOLCANITE_AMULET, "item/rings/volcanite_amulet");
+		activeToggle(itemModels, PEItems.WATCH_OF_FLOWING_TIME, "item/rings/time_watch_off", "watch_of_flowing_time_on", "item/rings/time_watch_on");
+		activeToggle(itemModels, PEItems.ZERO_RING, "item/rings/zero_off", "zero_ring_on", "item/rings/zero_on");
+	}
+
+	private void generateKleinStars(ItemModelGenerators itemModels) {
+		KleinTier[] tiers = KleinTier.values();
+		for (int tier = 0; tier < tiers.length; tier++) {
+			generated(itemModels, PEItems.getStar(tiers[tier]), "item/stars/klein_star_" + (tier + 1));
+		}
+	}
+
+	private void generateGear(ItemModelGenerators itemModels) {
+		//Dark Matter
+		armorWithTrim(itemModels, PEItems.DARK_MATTER_HELMET, "item/dm_armor/head");
+		armorWithTrim(itemModels, PEItems.DARK_MATTER_CHESTPLATE, "item/dm_armor/chest");
+		armorWithTrim(itemModels, PEItems.DARK_MATTER_LEGGINGS, "item/dm_armor/legs");
+		armorWithTrim(itemModels, PEItems.DARK_MATTER_BOOTS, "item/dm_armor/feet");
+		handheld(itemModels, PEItems.DARK_MATTER_AXE, "item/dm_tools/axe");
+		handheld(itemModels, PEItems.DARK_MATTER_HAMMER, "item/dm_tools/hammer");
+		handheld(itemModels, PEItems.DARK_MATTER_HOE, "item/dm_tools/hoe");
+		handheld(itemModels, PEItems.DARK_MATTER_PICKAXE, "item/dm_tools/pickaxe");
+		handheld(itemModels, PEItems.DARK_MATTER_SHEARS, "item/dm_tools/shears");
+		handheld(itemModels, PEItems.DARK_MATTER_SHOVEL, "item/dm_tools/shovel");
+		handheld(itemModels, PEItems.DARK_MATTER_SWORD, "item/dm_tools/sword");
+		//Red Matter
+		armorWithTrim(itemModels, PEItems.RED_MATTER_HELMET, "item/rm_armor/head");
+		armorWithTrim(itemModels, PEItems.RED_MATTER_CHESTPLATE, "item/rm_armor/chest");
+		armorWithTrim(itemModels, PEItems.RED_MATTER_LEGGINGS, "item/rm_armor/legs");
+		armorWithTrim(itemModels, PEItems.RED_MATTER_BOOTS, "item/rm_armor/feet");
+		handheld(itemModels, PEItems.RED_MATTER_AXE, "item/rm_tools/axe");
+		handheld(itemModels, PEItems.RED_MATTER_HAMMER, "item/rm_tools/hammer");
+		handheld(itemModels, PEItems.RED_MATTER_HOE, "item/rm_tools/hoe");
+		handheld(itemModels, PEItems.RED_MATTER_PICKAXE, "item/rm_tools/pickaxe");
+		handheld(itemModels, PEItems.RED_MATTER_SHEARS, "item/rm_tools/shears");
+		handheld(itemModels, PEItems.RED_MATTER_SHOVEL, "item/rm_tools/shovel");
+		handheld(itemModels, PEItems.RED_MATTER_SWORD, "item/rm_tools/sword");
+		handheld(itemModels, PEItems.RED_MATTER_KATAR, "item/rm_tools/katar");
+		handheld(itemModels, PEItems.RED_MATTER_MORNING_STAR, "item/rm_tools/morning_star");
+		//Gem
+		armorWithTrim(itemModels, PEItems.GEM_HELMET, "item/gem_armor/head");
+		armorWithTrim(itemModels, PEItems.GEM_CHESTPLATE, "item/gem_armor/chest");
+		armorWithTrim(itemModels, PEItems.GEM_LEGGINGS, "item/gem_armor/legs");
+		armorWithTrim(itemModels, PEItems.GEM_BOOTS, "item/gem_armor/feet");
+	}
+
+	// Item helpers
+
+	private static ItemModel.Unbaked plain(Identifier model) {
+		return ItemModelUtils.plainModel(model);
+	}
+
+	/**
+	 * @return The given model when the item is not active, and the on model when it is (the 1.21.1 {@code projecte:active} override).
+	 */
+	private static ItemModel.Unbaked activeSelect(ItemModel.Unbaked off, ItemModel.Unbaked on) {
+		return ItemModelUtils.select(new ComponentContents<>(PEDataComponentTypes.ACTIVE.get()), off, ItemModelUtils.when(true, on));
+	}
+
+	/**
+	 * Creates a flat item model named {@code item/<name>}.
+	 */
+	private static Identifier flatModel(ItemModelGenerators itemModels, String name, String texture) {
+		return ModelTemplates.FLAT_ITEM.create(modLoc("item/" + name), TextureMapping.layer0(modTexture(texture)), itemModels.modelOutput);
+	}
+
+	/**
+	 * Creates the item's own flat item model.
+	 */
+	private static Identifier flatModel(ItemModelGenerators itemModels, Item item, String texture) {
+		return ModelTemplates.FLAT_ITEM.create(item, TextureMapping.layer0(modTexture(texture)), itemModels.modelOutput);
+	}
+
+	private static void generated(ItemModelGenerators itemModels, ItemLike item, String texture) {
+		itemModels.generateFlatItem(item.asItem(), modLoc(texture), ModelTemplates.FLAT_ITEM);
+	}
+
+	private static void handheld(ItemModelGenerators itemModels, ItemLike item, String texture) {
+		itemModels.generateFlatItem(item.asItem(), modLoc(texture), ModelTemplates.FLAT_HANDHELD_ITEM);
+	}
+
+	private static void activeToggle(ItemModelGenerators itemModels, ItemLike itemLike, String offTexture, String onName, String onTexture) {
+		Item item = itemLike.asItem();
+		itemModels.itemModelOutput.accept(item, activeSelect(plain(flatModel(itemModels, item, offTexture)), plain(flatModel(itemModels, onName, onTexture))));
+	}
+
+	private static void armorWithTrim(ItemModelGenerators itemModels, ItemLike itemLike, String texture) {
+		Item item = itemLike.asItem();
+		//Base model at the item's own model location, which the trimmed armor model draws the trim over
+		flatModel(itemModels, item, texture);
+		Identifier slotTrimPrefix = ItemModelGenerators.prefixForSlotTrim(((PEArmor) item).getType().getName());
+		itemModels.generateDynamicTrimmableItem(item, ModelLocationUtils.getModelLocation(item), slotTrimPrefix, null);
+	}
+}
