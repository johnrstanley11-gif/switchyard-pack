+++ b/src/main/java/moze_intel/projecte/utils/transfer/PEItemStackHandler.java
@@ -0,0 +1,264 @@
+package moze_intel.projecte.utils.transfer;
+
+import com.mojang.serialization.Codec;
+import com.mojang.serialization.DataResult;
+import java.util.List;
+import java.util.function.IntFunction;
+import moze_intel.projecte.impl.codec.PECodecHelper;
+import net.minecraft.core.NonNullList;
+import net.minecraft.network.RegistryFriendlyByteBuf;
+import net.minecraft.network.codec.StreamCodec;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.level.storage.ValueInput;
+import net.minecraft.world.level.storage.ValueOutput;
+import net.neoforged.neoforge.transfer.IndexModifier;
+import net.neoforged.neoforge.transfer.item.ItemResource;
+import net.neoforged.neoforge.transfer.item.ItemStacksResourceHandler;
+import net.neoforged.neoforge.transfer.transaction.Transaction;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * ProjectE's item inventory on NeoForge's transactional transfer API ({@link ItemStacksResourceHandler}).
+ * <p>
+ * It is a genuine {@link net.neoforged.neoforge.transfer.ResourceHandler ResourceHandler&lt;ItemResource&gt;}, so it can be
+ * exposed as a capability, used by menus through {@link net.neoforged.neoforge.transfer.item.ResourceHandlerSlot} and
+ * driven by transactions. On top of that it keeps the slot-level operations ProjectE's logic was written against (the old
+ * {@code ItemStackHandler} contract: direct stack access, simulate flags, per-slot limit and validity), implemented with
+ * transactions, and both of ProjectE's 1.21.1 save formats so existing worlds keep their contents.
+ */
+public class PEItemStackHandler extends ItemStacksResourceHandler implements IPEItemHandler, IndexModifier<ItemResource> {
+
+	/** Default slot limit of the old ItemStackHandler. */
+	public static final int DEFAULT_SLOT_LIMIT = 99;
+
+	public PEItemStackHandler(int size) {
+		super(size);
+	}
+
+	public PEItemStackHandler(NonNullList<ItemStack> stacks) {
+		super(stacks);
+	}
+
+	//Legacy slot-level contract -----------------------------------------------------------------------------------------
+
+	@Override
+	public int getSlots() {
+		return size();
+	}
+
+	/**
+	 * @return The stack in the slot itself (not a copy). As with the old ItemStackHandler, callers that mutate it are
+	 * responsible for calling {@link #onContentsChanged(int)}.
+	 */
+	@NotNull
+	@Override
+	public ItemStack getStackInSlot(int slot) {
+		validateSlotIndex(slot);
+		return stacks.get(slot);
+	}
+
+	@Override
+	public void setStackInSlot(int slot, @NotNull ItemStack stack) {
+		validateSlotIndex(slot);
+		ItemStack previous = stacks.set(slot, stack);
+		onContentsChanged(slot, previous);
+	}
+
+	@Override
+	public int getSlotLimit(int slot) {
+		return DEFAULT_SLOT_LIMIT;
+	}
+
+	@Override
+	public boolean isItemValid(int slot, @NotNull ItemStack stack) {
+		return true;
+	}
+
+	/**
+	 * Inserts into one slot. Returns the remainder that could not be inserted.
+	 */
+	@NotNull
+	@Override
+	public ItemStack insertItem(int slot, @NotNull ItemStack stack, boolean simulate) {
+		if (stack.isEmpty()) {
+			return ItemStack.EMPTY;
+		}
+		validateSlotIndex(slot);
+		try (Transaction tx = Transaction.openRoot()) {
+			int inserted = insert(slot, ItemResource.of(stack), stack.getCount(), tx);
+			if (!simulate) {
+				tx.commit();
+			}
+			return inserted >= stack.getCount() ? ItemStack.EMPTY : stack.copyWithCount(stack.getCount() - inserted);
+		}
+	}
+
+	/**
+	 * Extracts up to {@code amount} from one slot and returns what was (or would be) extracted.
+	 */
+	@NotNull
+	@Override
+	public ItemStack extractItem(int slot, int amount, boolean simulate) {
+		if (amount <= 0) {
+			return ItemStack.EMPTY;
+		}
+		validateSlotIndex(slot);
+		ItemResource resource = getResource(slot);
+		if (resource.isEmpty()) {
+			return ItemStack.EMPTY;
+		}
+		try (Transaction tx = Transaction.openRoot()) {
+			int extracted = extract(slot, resource, amount, tx);
+			if (!simulate) {
+				tx.commit();
+			}
+			return extracted == 0 ? ItemStack.EMPTY : resource.toStack(extracted);
+		}
+	}
+
+	/**
+	 * Called when a slot's contents change. Mirrors the old ItemStackHandler hook.
+	 */
+	protected void onContentsChanged(int slot) {
+	}
+
+	/**
+	 * Called after the contents were replaced by {@link #deserialize}, {@link #loadLegacy} or a codec.
+	 */
+	protected void onLoad() {
+	}
+
+	//Bridge from the transfer API's hooks to the legacy hooks ------------------------------------------------------------
+
+	@Override
+	protected final void onContentsChanged(int index, @NotNull ItemStack previousContents) {
+		onContentsChanged(index);
+	}
+
+	@Override
+	public boolean isValid(int index, @NotNull ItemResource resource) {
+		return resource.isEmpty() || isItemValid(index, resource.toStack());
+	}
+
+	@Override
+	protected int getCapacity(int index, @NotNull ItemResource resource) {
+		int slotLimit = getSlotLimit(index);
+		return resource.isEmpty() ? slotLimit : Math.min(slotLimit, resource.getMaxStackSize());
+	}
+
+	@Override
+	public void deserialize(@NotNull ValueInput input) {
+		super.deserialize(input);
+		onLoad();
+	}
+
+	protected void validateSlotIndex(int slot) {
+		if (slot < 0 || slot >= size()) {
+			throw new IndexOutOfBoundsException("Slot " + slot + " not in valid range - [0," + size() + ")");
+		}
+	}
+
+	/**
+	 * Replaces every stack (copying none) and keeps the size, as the old setSize + set loop did.
+	 */
+	public void replaceAll(List<ItemStack> contents) {
+		NonNullList<ItemStack> list = NonNullList.withSize(contents.size(), ItemStack.EMPTY);
+		for (int i = 0; i < contents.size(); i++) {
+			list.set(i, contents.get(i));
+		}
+		setStacks(list);
+		onLoad();
+	}
+
+	public NonNullList<ItemStack> stacksView() {
+		return stacks;
+	}
+
+	public <HANDLER extends PEItemStackHandler> HANDLER copyInto(IntFunction<HANDLER> creator) {
+		HANDLER copy = creator.apply(size());
+		for (int i = 0; i < size(); i++) {
+			ItemStack stack = stacks.get(i);
+			if (!stack.isEmpty()) {
+				copy.stacks.set(i, stack.copy());
+			}
+		}
+		return copy;
+	}
+
+	//ProjectE 1.21.1 block entity format: {Items:[{Slot:int, <stack>}...], Size:int} -------------------------------------
+
+	/**
+	 * Writes the same structure the 1.21.1 ItemStackHandler#serializeNBT produced, into {@code output}.
+	 */
+	public void saveLegacy(@NotNull ValueOutput output) {
+		ValueOutput.ValueOutputList items = output.childrenList("Items");
+		for (int slot = 0; slot < stacks.size(); slot++) {
+			ItemStack stack = stacks.get(slot);
+			if (!stack.isEmpty()) {
+				ValueOutput item = items.addChild();
+				item.putInt("Slot", slot);
+				item.store(ItemStack.MAP_CODEC, stack);
+			}
+		}
+		output.putInt("Size", stacks.size());
+	}
+
+	/**
+	 * Reads the 1.21.1 ItemStackHandler#serializeNBT structure. A missing Size keeps the current size; slots outside the
+	 * range are ignored, as the old handler did.
+	 */
+	public void loadLegacy(@NotNull ValueInput input) {
+		int size = input.getIntOr("Size", stacks.size());
+		NonNullList<ItemStack> loaded = NonNullList.withSize(size, ItemStack.EMPTY);
+		input.childrenListOrEmpty("Items").stream().forEach(item -> {
+			int slot = item.getIntOr("Slot", -1);
+			if (slot >= 0 && slot < size) {
+				item.read(ItemStack.MAP_CODEC).ifPresent(stack -> loaded.set(slot, stack));
+			}
+		});
+		setStacks(loaded);
+		onLoad();
+	}
+
+	//ProjectE 1.21.1 attachment format: a list of (lenient, optional) stacks --------------------------------------------
+
+	public static <HANDLER extends PEItemStackHandler> Codec<HANDLER> listCodec(IntFunction<HANDLER> creator) {
+		return PECodecHelper.LENIENT_OPTIONAL_STACK_CODEC.listOf().flatXmap(
+				list -> {
+					HANDLER handler = creator.apply(list.size());
+					for (int i = 0; i < list.size(); i++) {
+						handler.stacks.set(i, list.get(i));
+					}
+					handler.onLoad();
+					return DataResult.success(handler);
+				},
+				handler -> DataResult.success(handler.stacks)
+		);
+	}
+
+	public static final Codec<PEItemStackHandler> LIST_CODEC = listCodec(PEItemStackHandler::new);
+
+	/**
+	 * Fixed-size network codec, identical on the wire to the 1.21.1 PEStreamCodecs#handlerStreamCodec.
+	 */
+	public static <HANDLER extends PEItemStackHandler> StreamCodec<RegistryFriendlyByteBuf, HANDLER> streamCodec(int size, IntFunction<HANDLER> creator) {
+		return new StreamCodec<>() {
+			@Override
+			public void encode(@NotNull RegistryFriendlyByteBuf buffer, @NotNull HANDLER handler) {
+				for (int slot = 0; slot < size; slot++) {
+					ItemStack.OPTIONAL_STREAM_CODEC.encode(buffer, slot < handler.size() ? handler.stacks.get(slot) : ItemStack.EMPTY);
+				}
+			}
+
+			@NotNull
+			@Override
+			public HANDLER decode(@NotNull RegistryFriendlyByteBuf buffer) {
+				HANDLER handler = creator.apply(size);
+				for (int slot = 0; slot < size; slot++) {
+					handler.stacks.set(slot, ItemStack.OPTIONAL_STREAM_CODEC.decode(buffer));
+				}
+				return handler;
+			}
+		};
+	}
+}
