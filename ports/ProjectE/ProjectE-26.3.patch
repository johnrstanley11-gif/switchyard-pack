@@ -0,0 +1,45 @@
+package moze_intel.projecte.emc.components.processor;
+
+import java.util.EnumMap;
+import java.util.Map;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.tags.ItemTags;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.item.component.FireworkExplosion;
+import net.minecraft.world.item.crafting.Ingredient;
+
+/**
+ * The ingredients of vanilla's firework star and firework rocket recipes. On 1.21.1 vanilla exposed these as constants of FireworkStarRecipe and
+ * FireworkRocketRecipe (which the processors used); on 26.3 they moved into the recipes' data files ({@code firework_star.json},
+ * {@code firework_rocket.json}), so these mirror vanilla's values. They are kept as constants, as 1.21.1 did, so the server and the clients
+ * (which no longer receive recipes) calculate the same values.
+ */
+final class VanillaFireworkIngredients {
+
+	private VanillaFireworkIngredients() {
+	}
+
+	/**
+	 * @apiNote Created on use, as the skull tag only resolves once tags are loaded.
+	 */
+	static Map<FireworkExplosion.Shape, Ingredient> shapes() {
+		Map<FireworkExplosion.Shape, Ingredient> shapes = new EnumMap<>(FireworkExplosion.Shape.class);
+		shapes.put(FireworkExplosion.Shape.BURST, Ingredient.of(Items.FEATHER));
+		shapes.put(FireworkExplosion.Shape.CREEPER, Ingredient.of(BuiltInRegistries.ITEM.getOrThrow(ItemTags.SKULLS)));
+		shapes.put(FireworkExplosion.Shape.LARGE_BALL, Ingredient.of(Items.FIRE_CHARGE));
+		shapes.put(FireworkExplosion.Shape.STAR, Ingredient.of(Items.GOLD_NUGGET));
+		return shapes;
+	}
+
+	static Ingredient trail() {
+		return Ingredient.of(Items.DIAMOND);
+	}
+
+	static Ingredient twinkle() {
+		return Ingredient.of(Items.GLOWSTONE_DUST);
+	}
+
+	static Ingredient fuel() {
+		return Ingredient.of(Items.GUNPOWDER);
+	}
+}
