+package moze_intel.projecte.utils.transfer;
+
+import net.minecraft.world.item.ItemStack;
+import net.neoforged.neoforge.transfer.ResourceHandler;
+import net.neoforged.neoforge.transfer.item.ItemResource;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * A ProjectE inventory: a real {@link ResourceHandler ResourceHandler&lt;ItemResource&gt;} that also offers the slot-level
+ * contract ProjectE's machines, menus and transmutation logic were written against in 1.21.1 (live stacks, simulate flags,
+ * per-slot limits). Implemented by {@link PEItemStackHandler} and {@link PECombinedItemHandler}.
+ */
+public interface IPEItemHandler extends ResourceHandler<ItemResource> {
+
+	int getSlots();
+
+	@NotNull
+	ItemStack getStackInSlot(int slot);
+
+	void setStackInSlot(int slot, @NotNull ItemStack stack);
+
+	@NotNull
+	ItemStack insertItem(int slot, @NotNull ItemStack stack, boolean simulate);
+
+	@NotNull
+	ItemStack extractItem(int slot, int amount, boolean simulate);
+
+	int getSlotLimit(int slot);
+
+	boolean isItemValid(int slot, @NotNull ItemStack stack);
+}
