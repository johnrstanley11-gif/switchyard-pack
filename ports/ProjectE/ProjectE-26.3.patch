+	public static void addDamageTypes(GatherDataRegistryEntriesEvent event) {
+		event.add(Registries.DAMAGE_TYPE, context -> {
+			for (PEDamageType damageType : PEDamageTypes.DAMAGE_TYPES.values()) {
+				context.register(damageType.key(), new DamageType(damageType.msgId(), damageType.exhaustion()));
+			}
+		});
+	}
+
+	/**
+	 * Burn times of ProjectE's fuels (the 1.21.1 furnace fuel data map), made like vanilla's fuel burn times so that fast cooking blocks burn them
+	 * faster too.
+	 */
+	public static void addFuelBurnTimes(GatherDataRegistryEntriesEvent event) {
+		event.add(Registries.CONTEXT_INT_PROVIDER, context -> {
+			HolderGetter<LootItemCondition> predicates = context.lookup(Registries.PREDICATE);
+			HolderGetter<ContextIntProvider> providers = context.lookup(Registries.CONTEXT_INT_PROVIDER);
+			Holder<ContextIntProvider> normal = providers.getOrThrow(ContextIntProviders.COOKING_NORMAL_BURN_TIME_REDUCTION_FACTOR);
+			Holder<ContextIntProvider> fast = providers.getOrThrow(ContextIntProviders.COOKING_FAST_BURN_TIME_REDUCTION_FACTOR);
+			registerCooking(context, predicates, normal, fast, PEContextIntProviders.COOKING_TIME_ALCHEMICAL_COAL, PEContextIntProviders.ALCHEMICAL_COAL_BURN_TIME);
+			registerCooking(context, predicates, normal, fast, PEContextIntProviders.COOKING_TIME_ALCHEMICAL_COAL_BLOCK, PEContextIntProviders.ALCHEMICAL_COAL_BURN_TIME * 9);
+			registerCooking(context, predicates, normal, fast, PEContextIntProviders.COOKING_TIME_MOBIUS_FUEL, PEContextIntProviders.MOBIUS_FUEL_BURN_TIME);
+			registerCooking(context, predicates, normal, fast, PEContextIntProviders.COOKING_TIME_MOBIUS_FUEL_BLOCK, PEContextIntProviders.MOBIUS_FUEL_BURN_TIME * 9);
+			registerCooking(context, predicates, normal, fast, PEContextIntProviders.COOKING_TIME_AETERNALIS_FUEL, PEContextIntProviders.AETERNALIS_FUEL_BURN_TIME);
+			registerCooking(context, predicates, normal, fast, PEContextIntProviders.COOKING_TIME_AETERNALIS_FUEL_BLOCK, PEContextIntProviders.AETERNALIS_FUEL_BURN_TIME * 9);
+		});
+	}
+
+	//[VanillaCopy] ContextIntProviders#cooking
+	private static void registerCooking(BootstrapContext<ContextIntProvider> context, HolderGetter<LootItemCondition> predicates, Holder<ContextIntProvider> normal,
+			Holder<ContextIntProvider> fast, ResourceKey<ContextIntProvider> key, int burnTime) {
+		Holder<LootItemCondition> fasterCookingBlocks = predicates.getOrThrow(LootPredicates.FAST_FURNACE);
+		ContextIntProvider fastConditional = new ConditionalValue(fasterCookingBlocks, fast, normal);
+		context.register(key, ContextIntProviders.div(ContextIntProviders.exactly(burnTime), Holder.direct(fastConditional)).value());
+	}
+}
