diff --git a/neoforge/build.gradle b/neoforge/build.gradle
index 18700d8..8c51be5 100644
--- a/neoforge/build.gradle
+++ b/neoforge/build.gradle
@@ -28,6 +28,11 @@ neoForge {
         }
         server {
             server()
+            programArguments.add '--nogui'
+            if (project.hasProperty('portJarProbe')) {
+                // Load the built mod from runs/server/mods for the packaging probe.
+                loadedMods.set([])
+            }
             this.file('runs/server').createParentDirectories()
             gameDirectory = this.mkdir(this.file('runs/server'))
         }
@@ -49,6 +54,18 @@ dependencies {
 
 sourceSets.main.resources { srcDir 'src/generated/resources' }
 
+// The isolated console probe needs to submit commands and stop cleanly.
+tasks.named('runServer') {
+    standardInput = System.in
+}
+
+// NeoForm's tools support Java 25; use the same isolated toolchain for run setup.
+tasks.withType(net.neoforged.nfrtgradle.NeoFormRuntimeTask).configureEach {
+    javaExecutable = javaToolchains.launcherFor(java.toolchain).map {
+        it.executablePath.asFile.absolutePath
+    }
+}
+
 // Implement mcgradleconventions loader attribute
 def loaderAttribute = Attribute.of('io.github.mcgradleconventions.loader', String)
 ['apiElements', 'runtimeElements', 'sourcesElements', 'javadocElements'].each { variant ->
@@ -66,4 +83,4 @@ sourceSets.configureEach {
             }
         }
     }
-}
\ No newline at end of file
+}
